<!-- 首页展示 -->
<view class="show">
  <view class="runner-controls">
    <view class="runner-nav-shell" style="padding-top: {{statusBarHeight}}px;">
      <view class="runner-nav" style="height: {{navigationBarHeight}}px; padding-right: {{navigationRightPadding}}px;">
        <view class="runner-brand">帮帮</view>
        <view wx:if="{{schoolName}}" class="runner-school">
          <text class="runner-school-name">{{schoolName}}</text>
        </view>
      </view>
      <view class="runner-search">
        <t-search
          value="{{keyword}}"
          shape="round"
          placeholder="搜索跑腿需求"
          bind:change="onSearchChange"
          bind:submit="onSearch"
          bind:clear="clearSearch"
        />
      </view>
    </view>
    <view class="runner-toolbar">
      <scroll-view class="runner-category-scroll" scroll-x="{{true}}" enhanced="{{true}}" bounces="{{false}}" show-scrollbar="{{false}}">
        <view class="runner-category-row">
          <view class="runner-category-pill {{selectedCategoryId==null?'active':''}}" bindtap="selectCategory">全部</view>
          <view wx:for="{{category}}" wx:key="id" class="runner-category-pill {{selectedCategoryId==item.id?'active':''}}" data-id="{{item.id}}" bindtap="selectCategory">{{item.categoryName}}</view>
        </view>
      </scroll-view>
      <view class="runner-filter-entry {{filterCount>0?'runner-filter-entry--active':''}}" bindtap="openFilter">
        <t-icon name="filter" size="28rpx" color="{{filterCount>0?'#0052d9':'#52605a'}}" />
        <text>筛选</text>
        <view wx:if="{{filterCount>0}}" class="runner-filter-count">{{filterCount}}</view>
      </view>
    </view>
    <view class="runner-filter-summary" wx:if="{{filterCount>0}}">
      <t-icon name="filter" size="26rpx" color="#0052d9" />
      <text class="runner-filter-summary-text">{{filterSummary}}</text>
      <text class="runner-filter-summary-reset" bindtap="resetFilters">清除</text>
    </view>
  </view>
  <view class="runner-feed">
    <view wx:if="{{takes.length === 0 && (isLoginChecking || ordersLoading)}}" class="runner-list-loading">
      <t-loading theme="dots" size="36rpx" text="加载中" />
    </view>
    <!-- 订单展示 -->
    <view class="cart">
      <block wx:for="{{takes}}" wx:key="id">
        <view class="show-cart" bindtap="gotoTakesInfo" data-item="{{item}}">
          <!-- 分类 -->
          <view class="box1">
            <t-image wx:if="{{item.categoryImage}}" class="categoryImage" src="{{item.categoryImage}}" loading="slot" error="slot" mode="widthFix" />
            <view class="categoryName">{{item.categoryName}}</view>
            <!-- 时间tag -->
            <view>
              <!-- <t-tag class="margin-16" size="small " variant="light" theme="primary"> 任务时间：{{item.gap<60?item.gap+'分钟':item.gap/60+'小时'}} </t-tag> -->
              <t-tag class="margin-16" size="small " variant="light" theme="primary">预期{{item.expectTime}}</t-tag>
            </view>
            <!-- 门禁tag -->
            <view wx:if="{{item.businessType !== 'PURCHASE' && item.doorAccess!=0}}">
              <t-tag class="margin-16" size="small" variant="light" theme="primary">门禁</t-tag>
            </view>
            <!-- 金额tag -->
            <view wx:if="{{item.price!=null}}">
              <t-tag class="margin-16" size="small" variant="light" theme="warning">{{item.businessType === 'PURCHASE' ? '报酬 ' : ''}}￥{{item.price}}</t-tag>
              <t-tag wx:if="{{item.businessType === 'PURCHASE'}}" class="margin-16" size="small" variant="light" theme="primary">商品 ￥{{item.productAmount}}</t-tag>
            </view>
          </view>
          <!-- 分割线 -->
          <t-divider class="drvider" />
          <!-- 订单内容 -->
          <view class="box2" style="margin-bottom: 20rpx;">
            <!-- 订单说明图片 -->
            <view hidden="{{item.image==null}}">
              <t-image class="image" src="{{item.image}}" id="loading-img" mode="aspectFill" shape="round" style="filter:blur(4rpx)" />
            </view>
            <!-- 订单说明文字 -->
            <view class="box2-1">
              <view class="note">{{item.note||item.categoryName||'跑腿服务'}}</view>
              <view class="pick">{{item.displayPickUpLabel}}：{{item.pickUpAddress}}</view>
              <view class="recive">{{item.displayReciveLabel}}：{{item.reciveAddress}}</view>
            </view>

          </view>

        </view>
      </block>
    </view>
    <view wx:if="{{!isLoginChecking && !ordersLoading && takes.length === 0}}" style="margin: 50rpx;text-align: center;font-weight: bold;color: darkgray;">暂无可接订单</view>
    <view class="runner-feed-bottom-space" />
  </view>
  <view wx:if="{{!filterVisible}}" class="runner-publish-float">
    <t-button t-class="runner-publish-button" theme="primary" shape="round" icon="add" bind:tap="gotoPublishRunner">发布跑腿</t-button>
  </view>
</view>

<!-- 首次使用提示弹出层 -->
<t-popup visible="{{visible}}" bind:visible-change="onVisibleChange" placement='bottom'>
  <view>

    <view style="margin: 30rpx 50rpx;">
      <view class="p">
        <span class="text" style="margin-left: 50rpx;">我们将严格按照 </span>
        <text class='privacy' bind:tap="openPrivacyContract">《帮帮校园送用户协议》</text>
        <text class="text"> 向您提供服务。</text>
      </view>
      <view class="p">
        <span class="text" style="margin-left: 50rpx;">如果您对 </span>
        <text class='privacy' bind:tap="openPrivacyContract">《帮帮校园送用户协议》</text>
        <text class="text"> 有任何疑问或建议，可以通过声明内联系方式向我们反馈。</text>
      </view>
    </view>

    <view style="margin: 50rpx;">
      <t-button theme="primary" bind:tap="know" block>我已知晓</t-button>
    </view>
  </view>
</t-popup>

<!-- 统一筛选面板 -->
<t-popup visible="{{filterVisible}}" bind:visible-change="onFilterVisibleChange" placement="bottom">
  <view class="filter-sheet">
    <view class="filter-sheet-header">
      <text class="filter-sheet-title">筛选跑腿</text>
      <text class="filter-sheet-reset" bindtap="clearFilterSelection">重置</text>
    </view>

    <view class="filter-section">
      <view class="filter-section-title">跑腿类型</view>
      <view class="filter-options">
        <view class="filter-chip {{selectedCategoryId==null?'active':''}}" bindtap="selectFilterCategory">全部</view>
        <view
          wx:for="{{category}}"
          wx:key="id"
          class="filter-chip {{selectedCategoryId==item.id?'active':''}}"
          bindtap="selectFilterCategory"
          data-item="{{item}}"
        >
          {{item.categoryName}}
        </view>
      </view>
    </view>

    <view class="filter-section">
      <view class="filter-section-title">地址范围</view>
      <view class="filter-address-row">
        <view class="filter-address-main" bindtap="handleShowPicker" data-tag="pickup">
          <view class="filter-address-label">取件</view>
          <view class="filter-address-value">
            {{upPickUp?(upPickUp.label[0]+' '+upPickUp.label[1]+' '+upPickUp.label[2]):'不限取件地址'}}
          </view>
          <t-icon name="chevron-right" size="34rpx" color="#7a8491" />
        </view>
        <text class="filter-address-clear" wx:if="{{upPickUp}}" bindtap="clearUpPickUp">清除</text>
      </view>
      <view class="filter-address-row">
        <view class="filter-address-main" bindtap="handleShowPicker" data-tag="recive">
          <view class="filter-address-label">收件</view>
          <view class="filter-address-value">
            {{upRecive?(upRecive.label[0]+' '+upRecive.label[1]+' '+upRecive.label[2]):'不限收件地址'}}
          </view>
          <t-icon name="chevron-right" size="34rpx" color="#7a8491" />
        </view>
        <text class="filter-address-clear" wx:if="{{upRecive}}" bindtap="clearUpRecive">清除</text>
      </view>
    </view>

    <view class="filter-section">
      <view class="filter-section-title">排序</view>
      <view class="filter-options">
        <view class="filter-chip {{sortMode==='time'?'active':''}}" data-mode="time" bindtap="selectFilterSort">综合排序</view>
        <view class="filter-chip {{sortMode==='price' && priceSort===0?'active':''}}" data-mode="price-desc" bindtap="selectFilterSort">价格从高到低</view>
        <view class="filter-chip {{sortMode==='price' && priceSort===1?'active':''}}" data-mode="price-asc" bindtap="selectFilterSort">价格从低到高</view>
      </view>
    </view>

    <view class="filter-sheet-actions">
      <t-button block theme="primary" bind:tap="applyFilterSelection">查看结果</t-button>
    </view>
  </view>
</t-popup>

<!-- 地址筛选 -->
<t-picker visible="{{areaVisible}}" value="{{areaValue}}" title="请选择地址" cancelBtn="取消" confirmBtn="确认" bindchange="onPickerChange" bindpick="onColumnChange" bindcancel="onPickerCancel">
  <t-picker-item options="{{schools}}"></t-picker-item>
  <t-picker-item options="{{compuses}}"></t-picker-item>
  <t-picker-item options="{{buildings}}"></t-picker-item>
</t-picker>

<triple-address-pricker id="triplePicker" bind:confirmSelection="handleConfirmSelection" />
