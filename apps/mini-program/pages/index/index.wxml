<!-- 首页展示 -->
<view class="show">
  <!-- 轮播图区域 -->
  <view class="banner-wrap" wx:if="{{swiperList.length > 0}}">
    <t-swiper height="220rpx" current="{{current}}" autoplay="{{autoplay}}" duration="{{duration}}" interval="{{interval}}" list="{{swiperList}}" navigation="{{ { type: 'dots-bar' } }}" />
  </view>

  <view class="runner-panel">
    <view class="runner-copy">
      <view class="runner-eyebrow">跑腿大厅</view>
      <!-- <view class="runner-title">发布需求，等同校同学接单</view> -->
      <view class="runner-subtitle">取送、代买、临时帮忙从这里开始</view>
    </view>
    <view class="runner-cta" bindtap="gotoPublishRunner">
      <t-icon name="add-circle" size="38rpx" color="#ffffff" />
      <text>发布跑腿</text>
    </view>
  </view>

  <view>
    <view class="filter-bar">
      <view class="filter-bar-item {{sortMode==='time'?'active':''}}" bindtap="selectTimeSort">
        <t-icon name="filter-3" size="34rpx" />
        <text>综合排序</text>
      </view>
      <view class="filter-bar-item {{sortMode==='price'?'active':''}}" bindtap="togglePriceSort">
        <t-icon name="{{sortMode==='price'?(priceSort===0?'caret-up':'caret-down'):'currency-exchange'}}" size="34rpx" />
        <text>{{sortMode==='price'?(priceSort===0?'价格从高到低':'价格从低到高'):'价格排序'}}</text>
      </view>
      <view class="filter-bar-item {{filterCount>0?'active':''}}" bindtap="openFilter">
        <t-icon name="filter" size="34rpx" />
        <text>{{filterCount>0?'筛选 · '+filterCount:'筛选'}}</text>
      </view>
    </view>
    <view class="filter-summary" wx:if="{{filterCount>0}}">
      <text class="filter-summary-text">{{filterSummary}}</text>
      <text class="filter-summary-reset" bindtap="resetFilters">清除</text>
    </view>
    <!-- 订单展示 -->
    <view class="cart" croll-y>
      <block wx:for="{{takes}}" wx:key="id">
        <view class="show-cart" bindtap="gotoTakesInfo" data-item="{{item}}">
          <!-- 分类 -->
          <view class="box1">
            <t-image hidden="{{item.categoryImage!=null}}" class="categoryImage" src="{{item.categoryImage}}" loading="slot" error="slot" mode="widthFix" />
            <view class="categoryName">{{item.categoryName}}</view>
            <!-- 时间tag -->
            <view>
              <!-- <t-tag class="margin-16" size="small " variant="light" theme="primary"> 任务时间：{{item.gap<60?item.gap+'分钟':item.gap/60+'小时'}} </t-tag> -->
              <t-tag class="margin-16" size="small " variant="light" theme="primary">预期{{item.expectTime}}</t-tag>
            </view>
            <!-- 门禁tag -->
            <view hidden="{{item.doorAccess==0}}">
              <t-tag class="margin-16" size="small" variant="light" theme="primary">门禁</t-tag>
            </view>
            <!-- 金额tag -->
            <view hidden="{{item.price==null}}">
              <t-tag class="margin-16" size="small" variant="light" theme="warning">￥{{item.price }} </t-tag>
            </view>
          </view>
          <!-- 分割线 -->
          <t-divider class="drvider" />
          <!-- 订单内容 -->
          <view class="box2" style="margin-bottom: 20rpx;">
            <!-- 订单说明图片 -->
            <view hidden="{{item.image==null}}">
              <t-image class="image" src="{{item.image}}" id="loading-img" mode="aspectFill" shape="round" style="filter:blur(4rpx)" />
            </view>
            <!-- 订单说明文字 -->
            <view class="box2-1">
              <view class="note">{{item.displayTitle||item.note||'暂无说明'}}</view>
              <view class="pick">取：{{item.pickUpAddress}}</view>
              <view class="recive">收：{{item.reciveAddress}}</view>
            </view>

          </view>

        </view>
      </block>
    </view>
    <!-- 底部填充 -->
    <view wx:if="{{userInfo.token!=null && !isLoginChecking}}">
      <view wx:if="{{userInfo.authentication==1}}" style="margin: 50rpx;text-align: center;font-weight: bold;color: darkgray;">哇哦，已经到底了...QAQ</view>
      <view wx:else style="margin: 50rpx;text-align: center;font-weight: bold;color: darkgray;">在"我的"认证后查看订单</view>
    </view>
    <view wx:else style="position: relative;" hidden="{{isLoginChecking}}">
      <view style="position: absolute;  top: 50%;  left: 50%;  transform: translate(-50%, 150%);">
        <t-icon name="look-around" size="96rpx" color="darkgray;" />
        <view style="margin: 20rpx; width: 500rpx; text-align: center;font-weight: bold;color: darkgray;">未登录，我还不知道你是谁哦~</view>
      </view>
    </view>
  </view>
</view>

<!-- 首次使用提示弹出层 -->
<t-popup visible="{{visible}}" bind:visible-change="onVisibleChange" placement='bottom'>
  <view>

    <view style="margin: 30rpx 50rpx;">
      <view class="p">
        <span class="text" style="margin-left: 50rpx;">我们将严格按照 </span>
        <text class='privacy' bind:tap="openPrivacyContract">《帮帮校园送用户协议》</text>
        <text class="text"> 向您提供服务。</text>
      </view>
      <view class="p">
        <span class="text" style="margin-left: 50rpx;">如果您对 </span>
        <text class='privacy' bind:tap="openPrivacyContract">《帮帮校园送用户协议》</text>
        <text class="text"> 有任何疑问或建议，可以通过声明内联系方式向我们反馈。</text>
      </view>
    </view>

    <view style="margin: 50rpx;">
      <t-button theme="primary" bind:tap="know" block>我已知晓</t-button>
    </view>
  </view>
</t-popup>

<!-- 统一筛选面板 -->
<t-popup visible="{{filterVisible}}" bind:visible-change="onFilterVisibleChange" placement="bottom">
  <view class="filter-sheet">
    <view class="filter-sheet-header">
      <text class="filter-sheet-title">筛选跑腿</text>
      <text class="filter-sheet-reset" bindtap="clearFilterSelection">重置</text>
    </view>

    <view class="filter-section">
      <view class="filter-section-title">跑腿类型</view>
      <view class="filter-options">
        <view class="filter-chip {{selectedCategoryId==null?'active':''}}" bindtap="selectFilterCategory">全部</view>
        <view
          wx:for="{{category}}"
          wx:key="id"
          class="filter-chip {{selectedCategoryId==item.id?'active':''}}"
          bindtap="selectFilterCategory"
          data-item="{{item}}"
        >
          {{item.categoryName}}
        </view>
      </view>
    </view>

    <view class="filter-section">
      <view class="filter-section-title">地址范围</view>
      <view class="filter-address-row">
        <view class="filter-address-main" bindtap="handleShowPicker" data-tag="pickup">
          <view class="filter-address-label">取件</view>
          <view class="filter-address-value">
            {{upPickUp?(upPickUp.label[0]+' '+upPickUp.label[1]+' '+upPickUp.label[2]):'不限取件地址'}}
          </view>
          <t-icon name="chevron-right" size="34rpx" color="#7a8491" />
        </view>
        <text class="filter-address-clear" wx:if="{{upPickUp}}" bindtap="clearUpPickUp">清除</text>
      </view>
      <view class="filter-address-row">
        <view class="filter-address-main" bindtap="handleShowPicker" data-tag="recive">
          <view class="filter-address-label">收件</view>
          <view class="filter-address-value">
            {{upRecive?(upRecive.label[0]+' '+upRecive.label[1]+' '+upRecive.label[2]):'不限收件地址'}}
          </view>
          <t-icon name="chevron-right" size="34rpx" color="#7a8491" />
        </view>
        <text class="filter-address-clear" wx:if="{{upRecive}}" bindtap="clearUpRecive">清除</text>
      </view>
    </view>

    <view class="filter-sheet-actions">
      <t-button block theme="primary" bind:tap="applyFilterSelection">查看结果</t-button>
    </view>
  </view>
</t-popup>

<!-- 地址筛选 -->
<t-picker visible="{{areaVisible}}" value="{{areaValue}}" title="请选择地址" cancelBtn="取消" confirmBtn="确认" bindchange="onPickerChange" bindpick="onColumnChange" bindcancel="onPickerCancel">
  <t-picker-item options="{{schools}}"></t-picker-item>
  <t-picker-item options="{{compuses}}"></t-picker-item>
  <t-picker-item options="{{buildings}}"></t-picker-item>
</t-picker>

<!-- 刷新轻提示 -->
<t-toast id="t-toast" />

<triple-address-pricker id="triplePicker" bind:confirmSelection="handleConfirmSelection" />

<t-overlay visible="{{isLoginChecking}}" duration="{{200}}" backgroundColor="rgb(255,255,255,0.6)">
  <t-loading theme="dots" size="80rpx" class="page-loading" />
</t-overlay>
