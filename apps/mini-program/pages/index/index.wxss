/* 总体布局 */
.show {
  position: relative;
  /* 使得内部元素可以相对于此定位 */
  display: flex;
  flex-direction: column;
  height: 100vh;
  /* 填充整个视口高度 */
  /* justify-content: space-between; */
  box-sizing: border-box;
}


/* 展示卡片总体布局 */
.cart {
  flex: 1;
  display: flex;
  flex-direction: column;
  /* background: white; */
}

/* 详情卡片布局 */
.show-cart {
  position: relative;
  display: flex;
  flex-direction: column;
  /* height: 500rpx; */
  border-radius: 25rpx;
  margin: 20rpx 32rpx;
  background-color: white;
  padding: 10rpx 25rpx 0 25rpx;
  overflow: hidden;
  /* padding-bottom: 50rpx; */
  /* box-shadow: 4px 4px 3px rgba(0, 0, 0, 0.1); */
  /* 水平偏移，垂直偏移，模糊半径，颜色 */
}

.box1 {
  display: flex;
  flex: 0.8;
  align-items: center;
  /* background: powderblue; */
}

.categoryImage {
  width: 35rpx;
  height: 35rpx;
  /* border-radius: 25px; */
  /* padding: 5rpx; */
  /* background: brown; */
}

.categoryName {
  flex: 1;
  font-size: 0.9rem;
  font-weight: unset;
  padding-left: 10rpx;
  /* background:rebeccapurple; */
}

.box2 {
  position: relative;
  display: flex;
  flex: 3;
  align-items: center;
  /* background: palevioletred; */
}

.image {
  /* border-radius: 25rpx; */
  width: 125rpx;
  height: 125rpx;
  /* padding: 5rpx; */
  /* box-shadow: 1px 1px 3px rgba(0, 0, 0, 0.1); */
  /* background: red; */
}

.box2-1 {
  display: flex;
  flex: 4;
  width: 100rpx;
  padding-left: 20rpx;
  flex-direction: column;
  /* background: khaki; */
}

.note {
  display: inline-block;
  /* 将元素设置为内联块级元素 */
  width: 100%;
  /* 设置宽度为 100% */
  max-width: 100%;
  /* 设置最大宽度为 100% */
  white-space: nowrap;
  /* 不允许换行 */
  overflow: hidden;
  /* 隐藏溢出部分 */
  text-overflow: ellipsis;
  /* 显示省略号 */
  /* background: lawngreen; */
  font-size: large;
  font-weight: bold;
  padding: 10rpx 0;
}

.pick {
  flex: 1;
  /* width: 80rpx; */
  /* background: lightslategray; */
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: small;
  font-weight: 500;
  font-family: Verdana, Geneva, Tahoma, sans-serif;
  color: gray;
}

.recive {
  flex: 1;
  /* background: magenta; */
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: small;
  font-weight: 500;
  font-family: Verdana, Geneva, Tahoma, sans-serif;
  color: gray;
}

.box3 {
  display: flex;
  flex: 1.2;
  align-items: center;
  padding: 0 0 20rpx 0;
  /* background: blue; */
}

.date {
  flex: 6;
  font-size: x-small;
  font-weight: 500;
  font-family: Verdana, Geneva, Tahoma, sans-serif;
  color: gray;
  /* padding-bottom: 10rpx; */
  /* background: mediumaquamarine; */
}

.price {
  flex: 1;
  /* background: mediumslateblue; */
}

/* status */
.block {
  margin: 0 32rpx;
}

.block+.block {
  margin-top: 48rpx;
}

.block .status:not(:last-child) {
  margin-right: 32rpx;
}

/* 标签 */
.demo {
  padding: 0 32rpx 48rpx;
}

.demo:last-child {
  padding-bottom: 0;
}

.demo-desc {
  font-size: 14px;
  color: var(--td-text-color-secondary);
  margin-bottom: 32rpx;
}
.margin-16{
  margin: 0 5rpx;
}
.demo .margin-16:not(:last-child) {
  margin-right: 32rpx;
}

/* tab */
.tab {
  position: sticky;
  top: 0;
  z-index: 1;
}

.tabs {
  --tab-font-size: 20rpx;
}

/* 轮播图 */
.img {
  width: 100%;
  height: 100%;
}

/* 筛选 */
.block {
  display: block;
  margin: 0 32rpx;
}

.t-overlay {
  top: 0 !important;
}

.t-grid-item__content {
  padding: 0 !important;
}

.t-collapse-panel__content {
  padding: 10rpx 5rpx !important;
}

.t-popup--bottom {
  padding-bottom: 0 !important;
}

.box1-2 {
  display: flex;
  flex: 1.5;
  align-items: center;
  /* margin: 10rpx 0  0 20rpx; */
  /* background: red; */
}

.text-address {
  color: #0052d9;
  /* width: 20%; */
  background-color: #0052d920;
  padding: 10rpx 15rpx;
  margin: 10rpx 15rpx 10rpx 30rpx;
  border-radius: 15rpx;
  font-size: small;
  font-weight: bold;
  text-align: center;
  /* 将文本居中 */
}

.address {
  flex: 1;
  /* width: 85%; */
  /* padding: 10rpx 0; */
  margin: 0 10rpx;
  /* background: orchid; */
  /* overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis; */
  font-size: small;
  font-weight: 600;
  font-family: Verdana, Geneva, Tahoma, sans-serif;
  color: gray;
}

.drvider {
  --td-divider-content-line-height: 20rpx;
}
.t-divider--horizontal{
  margin: 10rpx !important;
}
/* 首次加载弹出 */
.text {
  color: gray;
  font-size: small;
}

.privacy {
  font-size: small;
  color: cornflowerblue;
  text-decoration: underline;
}

/* 缺省 */
.page-loading {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}
