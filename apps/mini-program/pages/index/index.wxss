/* 总体布局 */
.show {
  position: relative;
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  width: 100%;
  overflow-x: hidden;
  background: #f6f8f7;
  box-sizing: border-box;
}


/* 展示卡片总体布局 */
.cart {
  flex: 1;
  display: flex;
  flex-direction: column;
  /* background: white; */
}

/* 详情卡片布局 */
.show-cart {
  position: relative;
  display: flex;
  flex-direction: column;
  /* height: 500rpx; */
  border-radius: 25rpx;
  margin: 20rpx 32rpx;
  background-color: white;
  padding: 10rpx 25rpx 0 25rpx;
  overflow: hidden;
  /* padding-bottom: 50rpx; */
  /* box-shadow: 4px 4px 3px rgba(0, 0, 0, 0.1); */
  /* 水平偏移，垂直偏移，模糊半径，颜色 */
}

.box1 {
  display: flex;
  flex: 0.8;
  align-items: center;
  /* background: powderblue; */
}

.categoryImage {
  width: 35rpx;
  height: 35rpx;
  /* border-radius: 25px; */
  /* padding: 5rpx; */
  /* background: brown; */
}

.categoryName {
  flex: 1;
  font-size: 0.9rem;
  font-weight: unset;
  padding-left: 10rpx;
  /* background:rebeccapurple; */
}

.box2 {
  position: relative;
  display: flex;
  flex: 3;
  align-items: center;
  /* background: palevioletred; */
}

.image {
  /* border-radius: 25rpx; */
  width: 125rpx;
  height: 125rpx;
  /* padding: 5rpx; */
  /* box-shadow: 1px 1px 3px rgba(0, 0, 0, 0.1); */
  /* background: red; */
}

.box2-1 {
  display: flex;
  flex: 4;
  width: 100rpx;
  padding-left: 20rpx;
  flex-direction: column;
  /* background: khaki; */
}

.note {
  display: inline-block;
  /* 将元素设置为内联块级元素 */
  width: 100%;
  /* 设置宽度为 100% */
  max-width: 100%;
  /* 设置最大宽度为 100% */
  white-space: nowrap;
  /* 不允许换行 */
  overflow: hidden;
  /* 隐藏溢出部分 */
  text-overflow: ellipsis;
  /* 显示省略号 */
  /* background: lawngreen; */
  font-size: large;
  font-weight: bold;
  padding: 10rpx 0;
}

.pick {
  flex: 1;
  /* width: 80rpx; */
  /* background: lightslategray; */
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: small;
  font-weight: 500;
  font-family: Verdana, Geneva, Tahoma, sans-serif;
  color: #5f6772;
}

.recive {
  flex: 1;
  /* background: magenta; */
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: small;
  font-weight: 500;
  font-family: Verdana, Geneva, Tahoma, sans-serif;
  color: #5f6772;
}

.box3 {
  display: flex;
  flex: 1.2;
  align-items: center;
  padding: 0 0 20rpx 0;
  /* background: blue; */
}

.date {
  flex: 6;
  font-size: x-small;
  font-weight: 500;
  font-family: Verdana, Geneva, Tahoma, sans-serif;
  color: #5f6772;
  /* padding-bottom: 10rpx; */
  /* background: mediumaquamarine; */
}

.price {
  flex: 1;
  /* background: mediumslateblue; */
}

/* status */
.block {
  margin: 0 32rpx;
}

.block+.block {
  margin-top: 48rpx;
}

.block .status:not(:last-child) {
  margin-right: 32rpx;
}

/* 标签 */
.demo {
  padding: 0 32rpx 48rpx;
}

.demo:last-child {
  padding-bottom: 0;
}

.demo-desc {
  font-size: 14px;
  color: var(--td-text-color-secondary);
  margin-bottom: 32rpx;
}
.margin-16{
  margin: 0 5rpx;
}
.demo .margin-16:not(:last-child) {
  margin-right: 32rpx;
}

/* 与二手首页一致的品牌栏、搜索及固定分类 */
.runner-controls {
  position: sticky;
  top: 0;
  z-index: 10;
  background: #ffffff;
  border-bottom: 1rpx solid #edf0ee;
}

.runner-nav-shell {
  padding-right: 32rpx;
  padding-left: 32rpx;
  background: var(--cr-color-primary, #0052d9);
  box-sizing: border-box;
}

.runner-nav {
  display: flex;
  align-items: center;
  gap: 24rpx;
  min-height: 44px;
  box-sizing: content-box;
}

.runner-brand {
  flex: none;
  color: #ffffff;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1;
  letter-spacing: -2rpx;
}

.runner-school {
  display: flex;
  flex: 1;
  align-items: center;
  min-width: 0;
  height: 36rpx;
  padding-left: 24rpx;
  border-left: 2rpx solid rgba(255, 255, 255, 0.65);
  color: #ffffff;
}

.runner-school-name {
  display: block;
  min-width: 0;
  overflow: hidden;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.runner-search {
  min-width: 0;
  padding: 8rpx 0 24rpx;
  --td-search-height: 72rpx;
  --td-search-padding: 0 24rpx;
  --td-search-font-size: 26rpx;
  --td-search-bg-color: #ffffff;
}

.runner-toolbar {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 14rpx 24rpx 18rpx;
}

.runner-category-scroll {
  display: block;
  flex: 1;
  width: auto;
  min-width: 0;
  overflow: hidden;
}

.runner-category-row {
  display: inline-flex;
  min-width: 100%;
  gap: 14rpx;
  box-sizing: border-box;
  white-space: nowrap;
}

.runner-category-pill {
  display: inline-flex;
  flex: none;
  align-items: center;
  justify-content: center;
  height: 64rpx;
  padding: 0 26rpx;
  background: #ffffff;
  border: 1rpx solid #e0e8e3;
  border-radius: 999rpx;
  color: #536058;
  font-size: 25rpx;
}

.runner-category-pill.active {
  background: #17231d;
  border-color: #17231d;
  color: #ffffff;
  font-weight: 700;
}

.runner-filter-entry {
  position: relative;
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  height: 64rpx;
  padding: 0 18rpx;
  color: #52605a;
  background: #f5f7f6;
  border: 1rpx solid #e0e8e3;
  border-radius: 32rpx;
  font-size: 24rpx;
  font-weight: 700;
  box-sizing: border-box;
}

.runner-filter-entry--active {
  color: #0052d9;
  background: #edf4ff;
  border-color: #9bc0ff;
}

.runner-filter-count {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 28rpx;
  height: 28rpx;
  padding: 0 7rpx;
  color: #ffffff;
  background: #0052d9;
  border-radius: 999rpx;
  font-size: 19rpx;
  line-height: 1;
  box-sizing: border-box;
}

.runner-filter-summary {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-height: 58rpx;
  padding: 0 26rpx 12rpx;
  color: #334155;
  background: #ffffff;
  box-sizing: border-box;
}

.runner-filter-summary-text {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  font-size: 23rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.runner-filter-summary-reset {
  flex: none;
  color: #0052d9;
  font-size: 23rpx;
  font-weight: 700;
}

.runner-feed-bottom-space {
  height: 140rpx;
}

.show .runner-publish-float {
  position: fixed;
  right: 28rpx;
  bottom: 28rpx;
  z-index: 10;
}

.show .runner-publish-button {
  margin: 0;
  box-shadow: 0 8rpx 24rpx rgba(0, 82, 217, 0.24);
  --td-button-medium-height: 84rpx;
  --td-button-medium-font-size: 28rpx;
  --td-button-medium-padding-horizontal: 28rpx;
  --td-button-medium-icon-font-size: 34rpx;
  --td-button-font-weight: 600;
  --td-button-primary-bg-color: var(--cr-color-primary, #0052d9);
  --td-button-primary-border-color: var(--cr-color-primary, #0052d9);
}

/* 轮播图 */
.banner-wrap {
  margin: 20rpx 24rpx 0;
  height: 220rpx;
  overflow: hidden;
  border-radius: 18rpx;
  background: #ffffff;
}

.img {
  width: 100%;
  height: 100%;
}

/* 筛选 */
.block {
  display: block;
  margin: 0 32rpx;
}

.t-overlay {
  top: 0 !important;
}

.t-grid-item__content {
  padding: 0 !important;
}

.t-collapse-panel__content {
  padding: 10rpx 5rpx !important;
}

.t-popup--bottom {
  padding-bottom: 0 !important;
}

.box1-2 {
  display: flex;
  flex: 1.5;
  align-items: center;
  /* margin: 10rpx 0  0 20rpx; */
  /* background: red; */
}

.text-address {
  color: #0052d9;
  /* width: 20%; */
  background-color: #0052d920;
  padding: 10rpx 15rpx;
  margin: 10rpx 15rpx 10rpx 30rpx;
  border-radius: 15rpx;
  font-size: small;
  font-weight: bold;
  text-align: center;
  /* 将文本居中 */
}

.address {
  flex: 1;
  /* width: 85%; */
  /* padding: 10rpx 0; */
  margin: 0 10rpx;
  /* background: orchid; */
  /* overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis; */
  font-size: small;
  font-weight: 600;
  font-family: Verdana, Geneva, Tahoma, sans-serif;
  color: #5f6772;
}

.drvider {
  --td-divider-content-line-height: 20rpx;
}
.t-divider--horizontal{
  margin: 10rpx !important;
}
/* 首次加载弹出 */
.text {
  color: #5f6772;
  font-size: small;
}

.privacy {
  font-size: small;
  color: cornflowerblue;
  text-decoration: underline;
}

/* 首次加载仅占用列表区域，不遮挡导航和已有订单。 */
.show .runner-list-loading {
  display: flex;
  justify-content: center;
  padding: 48rpx 24rpx;
}
.filter-sheet {
  max-height: 80vh;
  padding: 0 28rpx calc(28rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  border-radius: 24rpx 24rpx 0 0;
  box-sizing: border-box;
  overflow-y: auto;
}

.filter-sheet-header {
  position: sticky;
  top: 0;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 104rpx;
  background: #ffffff;
  border-bottom: 1rpx solid #edf0f4;
}

.filter-sheet-title {
  color: #111827;
  font-size: 34rpx;
  font-weight: 700;
}

.filter-sheet-reset {
  color: #0052d9;
  font-size: 26rpx;
}

.filter-section {
  padding: 28rpx 0 6rpx;
}

.filter-section-title {
  margin-bottom: 20rpx;
  color: #1f2937;
  font-size: 28rpx;
  font-weight: 700;
}

.filter-options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.filter-chip {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 130rpx;
  height: 66rpx;
  padding: 0 22rpx;
  color: #4b5563;
  background: #f4f6f8;
  border: 2rpx solid transparent;
  border-radius: 12rpx;
  font-size: 25rpx;
  box-sizing: border-box;
}

.filter-chip.active {
  color: #0052d9;
  background: #edf4ff;
  border-color: #8db7ff;
  font-weight: 700;
}

.filter-address-row {
  display: flex;
  align-items: center;
  min-height: 86rpx;
  border-bottom: 1rpx solid #edf0f4;
}

.filter-address-main {
  display: flex;
  flex: 1;
  align-items: center;
  min-width: 0;
}

.filter-address-label {
  width: 88rpx;
  color: #0052d9;
  font-size: 25rpx;
  font-weight: 700;
}

.filter-address-value {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: #374151;
  font-size: 25rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.filter-address-clear {
  margin-left: 14rpx;
  color: #6b7280;
  font-size: 23rpx;
}

.filter-sheet-actions {
  position: sticky;
  bottom: 0;
  z-index: 1;
  margin-top: 30rpx;
  padding: 18rpx 0 0;
  background: #ffffff;
}
