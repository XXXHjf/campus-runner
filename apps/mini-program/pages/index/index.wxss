/* 总体布局 */
.show {
  position: relative;
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background: #f5f6f8;
  box-sizing: border-box;
}


/* 展示卡片总体布局 */
.cart {
  flex: 1;
  display: flex;
  flex-direction: column;
  /* background: white; */
}

/* 详情卡片布局 */
.show-cart {
  position: relative;
  display: flex;
  flex-direction: column;
  /* height: 500rpx; */
  border-radius: 25rpx;
  margin: 20rpx 32rpx;
  background-color: white;
  padding: 10rpx 25rpx 0 25rpx;
  overflow: hidden;
  /* padding-bottom: 50rpx; */
  /* box-shadow: 4px 4px 3px rgba(0, 0, 0, 0.1); */
  /* 水平偏移，垂直偏移，模糊半径，颜色 */
}

.box1 {
  display: flex;
  flex: 0.8;
  align-items: center;
  /* background: powderblue; */
}

.categoryImage {
  width: 35rpx;
  height: 35rpx;
  /* border-radius: 25px; */
  /* padding: 5rpx; */
  /* background: brown; */
}

.categoryName {
  flex: 1;
  font-size: 0.9rem;
  font-weight: unset;
  padding-left: 10rpx;
  /* background:rebeccapurple; */
}

.box2 {
  position: relative;
  display: flex;
  flex: 3;
  align-items: center;
  /* background: palevioletred; */
}

.image {
  /* border-radius: 25rpx; */
  width: 125rpx;
  height: 125rpx;
  /* padding: 5rpx; */
  /* box-shadow: 1px 1px 3px rgba(0, 0, 0, 0.1); */
  /* background: red; */
}

.box2-1 {
  display: flex;
  flex: 4;
  width: 100rpx;
  padding-left: 20rpx;
  flex-direction: column;
  /* background: khaki; */
}

.note {
  display: inline-block;
  /* 将元素设置为内联块级元素 */
  width: 100%;
  /* 设置宽度为 100% */
  max-width: 100%;
  /* 设置最大宽度为 100% */
  white-space: nowrap;
  /* 不允许换行 */
  overflow: hidden;
  /* 隐藏溢出部分 */
  text-overflow: ellipsis;
  /* 显示省略号 */
  /* background: lawngreen; */
  font-size: large;
  font-weight: bold;
  padding: 10rpx 0;
}

.pick {
  flex: 1;
  /* width: 80rpx; */
  /* background: lightslategray; */
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: small;
  font-weight: 500;
  font-family: Verdana, Geneva, Tahoma, sans-serif;
  color: #5f6772;
}

.recive {
  flex: 1;
  /* background: magenta; */
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: small;
  font-weight: 500;
  font-family: Verdana, Geneva, Tahoma, sans-serif;
  color: #5f6772;
}

.box3 {
  display: flex;
  flex: 1.2;
  align-items: center;
  padding: 0 0 20rpx 0;
  /* background: blue; */
}

.date {
  flex: 6;
  font-size: x-small;
  font-weight: 500;
  font-family: Verdana, Geneva, Tahoma, sans-serif;
  color: #5f6772;
  /* padding-bottom: 10rpx; */
  /* background: mediumaquamarine; */
}

.price {
  flex: 1;
  /* background: mediumslateblue; */
}

/* status */
.block {
  margin: 0 32rpx;
}

.block+.block {
  margin-top: 48rpx;
}

.block .status:not(:last-child) {
  margin-right: 32rpx;
}

/* 标签 */
.demo {
  padding: 0 32rpx 48rpx;
}

.demo:last-child {
  padding-bottom: 0;
}

.demo-desc {
  font-size: 14px;
  color: var(--td-text-color-secondary);
  margin-bottom: 32rpx;
}
.margin-16{
  margin: 0 5rpx;
}
.demo .margin-16:not(:last-child) {
  margin-right: 32rpx;
}

/* 排序与筛选 */
.filter-bar {
  position: sticky;
  top: 0;
  z-index: 2;
  display: grid;
  grid-template-columns: 1fr 1.35fr 0.8fr;
  min-height: 88rpx;
  padding: 0 18rpx;
  background: #ffffff;
  border-bottom: 1rpx solid #edf0f4;
  box-sizing: border-box;
}

.filter-bar-item {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  min-width: 0;
  color: #20252c;
  font-size: 26rpx;
  white-space: nowrap;
}

.filter-bar-item.active {
  color: #0052d9;
  font-weight: 700;
}

.filter-bar-item.active::after {
  content: '';
  position: absolute;
  right: 24rpx;
  bottom: 0;
  left: 24rpx;
  height: 6rpx;
  background: #0052d9;
  border-radius: 999rpx;
}

.filter-summary {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 18rpx 28rpx;
  background: #edf4ff;
  border-bottom: 1rpx solid #d8e7ff;
}

.filter-summary-text {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: #334155;
  font-size: 24rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.filter-summary-reset {
  color: #0052d9;
  font-size: 24rpx;
  font-weight: 700;
}

/* 轮播图 */
.banner-wrap {
  margin: 20rpx 24rpx 0;
  height: 220rpx;
  overflow: hidden;
  border-radius: 18rpx;
  background: #ffffff;
}

.img {
  width: 100%;
  height: 100%;
}

/* 筛选 */
.block {
  display: block;
  margin: 0 32rpx;
}

.t-overlay {
  top: 0 !important;
}

.t-grid-item__content {
  padding: 0 !important;
}

.t-collapse-panel__content {
  padding: 10rpx 5rpx !important;
}

.t-popup--bottom {
  padding-bottom: 0 !important;
}

.box1-2 {
  display: flex;
  flex: 1.5;
  align-items: center;
  /* margin: 10rpx 0  0 20rpx; */
  /* background: red; */
}

.text-address {
  color: #0052d9;
  /* width: 20%; */
  background-color: #0052d920;
  padding: 10rpx 15rpx;
  margin: 10rpx 15rpx 10rpx 30rpx;
  border-radius: 15rpx;
  font-size: small;
  font-weight: bold;
  text-align: center;
  /* 将文本居中 */
}

.address {
  flex: 1;
  /* width: 85%; */
  /* padding: 10rpx 0; */
  margin: 0 10rpx;
  /* background: orchid; */
  /* overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis; */
  font-size: small;
  font-weight: 600;
  font-family: Verdana, Geneva, Tahoma, sans-serif;
  color: #5f6772;
}

.drvider {
  --td-divider-content-line-height: 20rpx;
}
.t-divider--horizontal{
  margin: 10rpx !important;
}
/* 首次加载弹出 */
.text {
  color: #5f6772;
  font-size: small;
}

.privacy {
  font-size: small;
  color: cornflowerblue;
  text-decoration: underline;
}

/* 缺省 */
.page-loading {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}
/* 跑腿页主操作 */
.runner-panel {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 22rpx;
  margin: 18rpx 24rpx 16rpx;
  padding: 26rpx;
  background: #ffffff;
  border-radius: 18rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 35, 80, 0.06);
}

.runner-copy {
  flex: 1;
  min-width: 0;
}

.runner-eyebrow {
  color: #0052d9;
  font-size: 23rpx;
  font-weight: 700;
}

.runner-title {
  margin-top: 8rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #111827;
  line-height: 1.35;
}

.runner-subtitle {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #5f6772;
  line-height: 1.45;
}

.runner-cta {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  min-width: 178rpx;
  height: 76rpx;
  padding: 0 22rpx;
  color: #ffffff;
  background: #0052d9;
  border-radius: 38rpx;
  font-size: 27rpx;
  font-weight: 700;
  box-shadow: 0 10rpx 20rpx rgba(0, 82, 217, 0.22);
  box-sizing: border-box;
}

.filter-sheet {
  max-height: 80vh;
  padding: 0 28rpx calc(28rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  border-radius: 24rpx 24rpx 0 0;
  box-sizing: border-box;
  overflow-y: auto;
}

.filter-sheet-header {
  position: sticky;
  top: 0;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 104rpx;
  background: #ffffff;
  border-bottom: 1rpx solid #edf0f4;
}

.filter-sheet-title {
  color: #111827;
  font-size: 34rpx;
  font-weight: 700;
}

.filter-sheet-reset {
  color: #0052d9;
  font-size: 26rpx;
}

.filter-section {
  padding: 28rpx 0 6rpx;
}

.filter-section-title {
  margin-bottom: 20rpx;
  color: #1f2937;
  font-size: 28rpx;
  font-weight: 700;
}

.filter-options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.filter-chip {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 130rpx;
  height: 66rpx;
  padding: 0 22rpx;
  color: #4b5563;
  background: #f4f6f8;
  border: 2rpx solid transparent;
  border-radius: 12rpx;
  font-size: 25rpx;
  box-sizing: border-box;
}

.filter-chip.active {
  color: #0052d9;
  background: #edf4ff;
  border-color: #8db7ff;
  font-weight: 700;
}

.filter-address-row {
  display: flex;
  align-items: center;
  min-height: 86rpx;
  border-bottom: 1rpx solid #edf0f4;
}

.filter-address-main {
  display: flex;
  flex: 1;
  align-items: center;
  min-width: 0;
}

.filter-address-label {
  width: 88rpx;
  color: #0052d9;
  font-size: 25rpx;
  font-weight: 700;
}

.filter-address-value {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: #374151;
  font-size: 25rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.filter-address-clear {
  margin-left: 14rpx;
  color: #6b7280;
  font-size: 23rpx;
}

.filter-sheet-actions {
  position: sticky;
  bottom: 0;
  z-index: 1;
  margin-top: 30rpx;
  padding: 18rpx 0 0;
  background: #ffffff;
}
