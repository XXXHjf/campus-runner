/* 总体布局 */
.address {
  display: flex;
  flex-direction: column;
  height: 100vh;
  /* 填充整个视口高度 */
  /* justify-content: space-between; */
  box-sizing: border-box;
}

.box{
  margin: 20rpx 0;
}

.icon {
  padding: 5rpx 10rpx 5rpx 30rpx;
  color: #0052d9;
}

.title {
  padding: 5rpx 5rpx;
  font-size: 0.8rem;
  font-weight: bold;
  color: #0052d9;
}

.button {
  display: flex;
  margin: 40rpx 30rpx;  
}

/* 标签提示文字 */
.label-tip {
  position: absolute;
  right: 30rpx;
  bottom: 8rpx;
  font-size: 20rpx;
  color: #999;
  pointer-events: none;
  animation: fadeIn 0.3s ease-in;
}

/* 详细地址提示文字 */
.details-tip {
  position: absolute;
  right: 30rpx;
  bottom: 8rpx;
  font-size: 20rpx;
  color: #999;
  pointer-events: none;
  animation: fadeIn 0.3s ease-in;
}

/* 淡入动画 */
@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(5rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}