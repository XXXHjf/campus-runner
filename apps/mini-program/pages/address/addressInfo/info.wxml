<ui-page safe-bottom>
  <ui-section title="地址信息" icon="map-location">
    <view class="address-info__group">
      <view bind:tap="showAddressPicker">
        <t-cell title="校区楼栋" hover arrow note="{{upCompus || '请选择校区'}} {{upCategory || ''}} {{upBuilding || ''}}" />
      </view>
      <view class="address-info__input-wrap">
        <t-input label="详细地址" placeholder="如506室" value="{{upDetails}}" align="right" maxlength="30" bind:change="handleDetails" bind:blur="handleDetailsBlur" bind:clear="clearDetails" clearable borderless />
        <view class="address-info__counter" wx:if="{{showDetailsTip}}">{{upDetails.length}}/30</view>
      </view>
    </view>

    <view class="address-info__group address-info__group--divided">
      <view class="address-info__input-wrap">
        <t-input label="地址标签" placeholder="如宿舍、家" value="{{upLabel}}" align="right" maxlength="3" bind:change="handleLabel" bind:blur="handleLabelBlur" bind:clear="clearLabel" clearable borderless />
        <view class="address-info__counter" wx:if="{{showLabelTip}}">{{upLabel.length}}/3</view>
      </view>
    </view>

    <view class="address-info__group address-info__group--divided">
      <view class="address-info__default">
        <t-radio block="{{false}}" custom-style="width: 100%;" value="radio" label="设为默认地址" placement="right" bind:tap="changeDefault" checked="{{upDefault == 1}}" borderless />
      </view>
    </view>
  </ui-section>

  <ui-action-bar fixed>
    <view class="address-info__action">
      <t-button theme="danger" variant="outline" block bind:tap="b1">删除地址</t-button>
    </view>
    <view class="address-info__action">
      <t-button theme="primary" block bind:tap="b2">保存修改</t-button>
    </view>
  </ui-action-bar>
</ui-page>

<t-toast id="t-toast" />
<triple-address-pricker id="triplePicker" bind:confirmSelection="handleConfirmSelection" />
