<ui-page safe-bottom>
  <ui-section title="地址" icon="map-search" description="请选择校区和楼栋，再补充具体位置">
    <view bind:tap="handleShowPicker">
      <t-cell wx:if="{{selectedCompus}}" title="校区楼栋" hover arrow note="{{selectedCompus}} {{selectedCategory}} {{selectedBuilding}}" />
      <t-cell wx:else class="address-add__pending" title="校区楼栋" hover arrow note="请选择" />
    </view>
    <t-input label="详细地址" placeholder="如门牌号、宿舍号（选填）" align="right" bind:change="tiptChangeDetail" bind:blur="tiptChangeDetailBlur" clearable clear-trigger="focus" borderless />
  </ui-section>

  <ui-section title="地址标签" icon="map-marked" description="添加易于识别的简称">
    <t-input label="标签" placeholder="如宿舍、实验室（选填）" align="right" bind:change="tiptChangeLabel" bind:blur="tiptChangeLabelBlur" clearable clear-trigger="focus" borderless />
  </ui-section>

  <ui-action-bar fixed>
    <view class="address-add__action">
      <t-button wx:if="{{selectedCompus}}" theme="primary" bind:tap="save" block>保存地址</t-button>
      <t-button wx:else theme="primary" disabled block>请先选择地址</t-button>
    </view>
  </ui-action-bar>
</ui-page>

<t-toast id="t-toast" />
<triple-address-pricker id="triplePicker" bind:confirmSelection="handleConfirmSelection" />
