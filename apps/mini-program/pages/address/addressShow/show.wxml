<view class="address-page">
  <view class="address-hero">
    <view class="hero-icon">
      <t-icon name="location" size="42rpx" color="#0052d9" />
    </view>
    <view class="hero-copy">
      <view class="hero-title">我的常用地址</view>
      <view class="hero-subtitle">发布跑腿和二手配送时可直接选择</view>
    </view>
    <view class="address-count">{{addressBook.length}}个</view>
  </view>

  <view class="address-list" wx:if="{{addressBook.length > 0}}">
    <view
      wx:for="{{addressBook}}"
      wx:key="id"
      class="address-card"
      bindtap="gotoAI"
      data-item="{{item}}"
    >
      <view class="address-card-head">
        <view class="address-label">{{item.label || '常用地址'}}</view>
        <t-tag wx:if="{{item.isDefault==1}}" size="small" variant="light" theme="primary">默认</t-tag>
        <view class="address-edit">
          <text>编辑</text>
          <t-icon name="chevron-right" size="32rpx" color="#8a94a3" />
        </view>
      </view>
      <view class="address-main">
        {{item.compusName}} {{item.buildCategoryName}} {{item.buildingName}}
      </view>
      <view class="address-detail">
        <t-icon name="map-location" size="30rpx" color="#667085" />
        <text>{{item.details || '未填写门牌号等详细信息'}}</text>
      </view>
    </view>
  </view>

  <view class="address-empty" wx:else>
    <view class="empty-icon">
      <t-icon name="map-search" size="72rpx" color="#7ea8ef" />
    </view>
    <view class="empty-title">还没有常用地址</view>
    <view class="empty-desc">添加后，下单时就不用重复填写了</view>
  </view>

  <view class="bottom-placeholder"></view>
</view>

<view class="bottom-action">
  <view class="add-address-btn" bindtap="gotoAdd">
    <t-icon name="add" size="36rpx" color="#ffffff" />
    <text>新增地址</text>
  </view>
</view>
