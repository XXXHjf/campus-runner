page {
  background: #f5f6f8;
}

.address-page {
  min-height: 100vh;
  padding: 24rpx 28rpx 0;
  box-sizing: border-box;
}

.address-hero {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx;
  background: #ffffff;
  border: 1rpx solid #edf1f6;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 35, 80, 0.05);
}

.hero-icon {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  background: #eaf2ff;
  border-radius: 20rpx;
}

.hero-copy {
  flex: 1;
  min-width: 0;
}

.hero-title {
  color: #111827;
  font-size: 30rpx;
  font-weight: 700;
}

.hero-subtitle {
  margin-top: 8rpx;
  color: #5f6772;
  font-size: 23rpx;
}

.address-count {
  flex: 0 0 auto;
  color: #0052d9;
  font-size: 24rpx;
  font-weight: 700;
}

.address-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 22rpx;
}

.address-card {
  padding: 26rpx 24rpx;
  background: #ffffff;
  border: 1rpx solid #edf1f6;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 35, 80, 0.05);
}

.address-card:active {
  background: #f8faff;
}

.address-card-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.address-label {
  max-width: 220rpx;
  overflow: hidden;
  color: #0052d9;
  font-size: 24rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.address-edit {
  display: flex;
  align-items: center;
  gap: 2rpx;
  margin-left: auto;
  color: #667085;
  font-size: 23rpx;
}

.address-main {
  margin-top: 18rpx;
  color: #182230;
  font-size: 31rpx;
  font-weight: 700;
  line-height: 1.45;
}

.address-detail {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  margin-top: 14rpx;
  color: #5f6772;
  font-size: 25rpx;
  line-height: 1.5;
}

.address-detail text {
  flex: 1;
  min-width: 0;
}

.bottom-placeholder {
  height: calc(150rpx + env(safe-area-inset-bottom));
}

.bottom-action {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 10;
  padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  border-top: 1rpx solid #edf1f6;
  box-shadow: 0 -8rpx 24rpx rgba(15, 35, 80, 0.08);
  box-sizing: border-box;
}

.add-address-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  height: 88rpx;
  color: #ffffff;
  background: #0052d9;
  border-radius: 18rpx;
  font-size: 29rpx;
  font-weight: 700;
  box-shadow: 0 10rpx 22rpx rgba(0, 82, 217, 0.22);
}

.add-address-btn:active {
  opacity: 0.88;
}
