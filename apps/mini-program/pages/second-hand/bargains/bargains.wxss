@import "../../../styles/second-hand-card.wxss";

page {
  height: 100%;
  overflow: hidden;
  background: var(--cr-color-background, #f5f7fa);
}

.bargains-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
}

.bargains-page__tabs {
  flex: none;
  z-index: 10;
  background: var(--cr-color-surface, #fff);
  --td-tab-border-color: transparent;
  --td-tab-item-active-color: var(--cr-color-primary, #0052d9);
  --td-tab-item-color: var(--cr-color-text-secondary, #6b778c);
  --td-tab-item-height: 84rpx;
  --td-tab-nav-bg-color: var(--cr-color-surface, #fff);
  --td-tab-track-thickness: 4rpx;
  --td-tab-track-width: 52rpx;
}

.bargains-page__body {
  flex: 1;
  height: 0;
  min-height: 0;
  width: 100%;
  box-sizing: border-box;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.bargains-page__list {
  margin: var(--cr-personal-list-gap, 24rpx) var(--cr-page-padding, 30rpx) 0;
  overflow: hidden;
  border-radius: var(--cr-radius-large, 28rpx);
  background: var(--cr-color-surface, #fff);
  box-shadow: var(--cr-shadow-card);
}

.bargains-page__row {
  box-sizing: border-box;
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  padding: var(--cr-personal-item-padding, 28rpx 26rpx 30rpx);
}

.bargains-page__row--separated {
  border-top: 1rpx solid var(--cr-color-border, #e7eaf0);
}

.bargains-page__cover {
  flex: none;
  width: 124rpx;
  height: 124rpx;
  overflow: hidden;
  border-radius: var(--cr-radius-medium, 20rpx);
  --td-image-round-radius: var(--cr-radius-medium, 20rpx);
}

.bargains-page__content {
  flex: 1;
  min-width: 0;
}

.bargains-page__top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
}

.bargains-page__title {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: var(--cr-color-text, #1d2129);
  font-size: 29rpx;
  font-weight: 700;
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.bargains-page__meta,
.bargains-page__message,
.bargains-page__price-label {
  color: var(--cr-color-text-secondary, #6b778c);
  font-size: 23rpx;
  line-height: 1.4;
}

.bargains-page__meta {
  display: block;
  margin-top: 12rpx;
}

.bargains-page__message {
  margin-top: 12rpx;
  overflow-wrap: anywhere;
  white-space: pre-wrap;
}

.bargains-page__bottom {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 28rpx;
}

.bargains-page__price-line {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.bargains-page__price {
  color: var(--cr-color-price, #e7552d);
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.3;
}

.bargains-page__actions {
  display: flex;
  flex: none;
  justify-content: flex-end;
  gap: 10rpx;
  margin-left: auto;
}
