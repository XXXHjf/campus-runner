page {
  background: #f6f8f7;
}

.bargains-page {
  min-height: 100vh;
  padding: 28rpx 24rpx 48rpx;
  box-sizing: border-box;
}

.page-head {
  padding: 16rpx 4rpx 22rpx;
}

.page-title {
  color: #17231d;
  font-size: 44rpx;
  font-weight: 800;
}

.page-subtitle {
  margin-top: 10rpx;
  color: #7a867f;
  font-size: 24rpx;
}

.summary {
  display: flex;
  margin-bottom: 18rpx;
  padding: 22rpx 10rpx;
  background: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 10rpx 28rpx rgba(24, 57, 42, 0.06);
}

.summary-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.summary-value {
  color: #17231d;
  font-size: 34rpx;
  font-weight: 800;
}

.summary-label,
.meta,
.attempt {
  color: #7a867f;
  font-size: 24rpx;
}

.bargain-list {
  margin-top: 20rpx;
}

.bargain-card {
  margin-bottom: 18rpx;
  padding: 22rpx;
  background: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 10rpx 28rpx rgba(24, 57, 42, 0.06);
}

.row-top,
.price-line,
.actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
}

.title {
  flex: 1;
  min-width: 0;
  color: #17231d;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.35;
}

.price-line {
  margin-top: 18rpx;
}

.price {
  color: #ff6a3d;
  font-size: 32rpx;
  font-weight: 800;
}

.meta {
  margin-top: 14rpx;
}

.message {
  margin-top: 14rpx;
  padding: 18rpx;
  color: #344139;
  background: #f6f8f7;
  border-radius: 12rpx;
  font-size: 25rpx;
  line-height: 1.5;
}

.actions {
  justify-content: flex-end;
  margin-top: 18rpx;
}

.empty {
  margin-top: 28rpx;
  padding: 54rpx 0;
  color: #8a958f;
  text-align: center;
  font-size: 26rpx;
}
