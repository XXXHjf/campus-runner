@import "../../../styles/second-hand-card.wxss";

page {
  background: #f3f4f5;
}

.bargains-page {
  min-height: 100vh;
  --cr-radius-medium: 32rpx;
}

.bargains-page__body {
  padding: 0 0 48rpx;
}

.bargains-page__summary {
  display: flex;
  padding: 28rpx 12rpx 36rpx;
}

.bargains-page__summary-item {
  position: relative;
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.bargains-page__summary-item::after {
  position: absolute;
  top: 12rpx;
  right: 0;
  width: 1rpx;
  height: 48rpx;
  background: var(--cr-color-border, #e7eaf0);
  content: '';
}

.bargains-page__summary-item:last-child::after {
  display: none;
}

.bargains-page__summary-value {
  color: var(--cr-color-text, #1d2129);
  font-size: 34rpx;
  font-weight: 800;
  line-height: 42rpx;
}

.bargains-page__summary-label,
.bargains-page__meta,
.bargains-page__attempt {
  color: var(--cr-color-text-secondary, #6b778c);
  font-size: 24rpx;
  line-height: 36rpx;
}

.bargains-page__tabs {
  padding: 0 20rpx;
  border-bottom: 1rpx solid var(--cr-color-border, #e7eaf0);
  --td-tab-border-color: transparent;
  --td-tab-item-active-color: var(--cr-color-primary, #0052d9);
  --td-tab-item-color: var(--cr-color-text, #1d2129);
  --td-tab-item-height: 88rpx;
  --td-tab-nav-bg-color: var(--cr-color-surface, #ffffff);
  --td-tab-track-thickness: 4rpx;
  --td-tab-track-width: 36rpx;
}

.bargains-page__list {
  background: var(--cr-color-surface, #ffffff);
}

.bargains-page__row {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
  padding: 30rpx 28rpx;
  border-bottom: 1rpx solid var(--cr-color-border);
}
.bargains-page__row:last-child { border-bottom: 0; }
.bargains-page__cover-link { flex: 0 0 160rpx; }
.bargains-page__cover {
  display: block;
  width: 160rpx;
  height: 160rpx;
  --td-image-round-radius: 20rpx;
}
.bargains-page__content { flex: 1; min-width: 0; }
.bargains-page__top { display: flex; align-items: flex-start; gap: 12rpx; }
.bargains-page__top t-tag { flex: none; }
.bargains-page__title {
  flex: 1;
  min-width: 0;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  overflow-wrap: anywhere;
  color: var(--cr-color-text);
  font-size: 30rpx;
  font-weight: 600;
  line-height: 40rpx;
}
.bargains-page__meta { margin-top: 10rpx; overflow-wrap: anywhere; }
.bargains-page__message {
  margin-top: 12rpx;
  color: var(--cr-color-text);
  font-size: 24rpx;
  line-height: 1.5;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}
.bargains-page__bottom {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 18rpx;
}
.bargains-page__price-line { display: flex; align-items: baseline; gap: 8rpx; }
.bargains-page__price-label { color: var(--cr-color-text-secondary); font-size: 22rpx; }
.bargains-page__price { color: #ff6a3d; font-size: 40rpx; font-weight: 600; line-height: 52rpx; }
.bargains-page__actions { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 10rpx; margin-left: auto; }
.bargains-page__button { --td-button-small-padding-horizontal: 22rpx; }
.bargains-page__subtitle { text-align: center; color: var(--cr-color-text-secondary); font-size: 24rpx; margin-bottom: 14rpx; }
