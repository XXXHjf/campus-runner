<view class="bargains-page">
  <view class="bargains-page__tabs">
    <t-tabs theme="line" show-bottom-line="{{false}}" value="{{tab}}" bind:click="onTabsClick">
      <t-tab-panel label="我收到的" value="received" badge-props="{{receivedBadge}}" />
      <t-tab-panel label="我发出的" value="issued" badge-props="{{issuedBadge}}" />
    </t-tabs>
  </view>

  <scroll-view class="bargains-page__body" scroll-y="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}" refresher-enabled="{{true}}" refresher-triggered="{{refreshing}}" refresher-background="#f5f7fa" bindrefresherrefresh="onPullDownRefresh" bindscrolltolower="loadMore">
    <ui-empty-state wx:if="{{feedbackLoadError}}" title="{{feedbackLoadError}}" action-text="重试" bind:action="retryFeedbackLoad" />
    <view wx:elif="{{tab == 'received' ? received.length > 0 : issued.length > 0}}" class="bargains-page__list">
      <view
        wx:for="{{tab == 'received' ? received : issued}}"
        wx:for-item="record"
        wx:for-index="index"
        wx:key="id"
        class="bargains-page__row {{index > 0 ? 'bargains-page__row--separated' : ''}}"
        data-status="{{record.status}}"
        data-id="{{record.id}}"
        data-order-id="{{record.orderId}}"
        data-product-id="{{record.productId}}"
        bindtap="gotoRecord"
      >
        <t-image class="bargains-page__cover" src="{{record.coverImage}}" mode="aspectFill" shape="round" width="124rpx" height="124rpx" />
        <view class="bargains-page__content">
          <view class="bargains-page__top">
            <text class="bargains-page__title">{{record.productTitle}}</text>
            <t-tag size="small" theme="{{record.statusTheme}}" variant="light">{{record.statusText}}</t-tag>
          </view>
          <text class="bargains-page__meta">{{tab == 'received' ? '买家' : '卖家'}} {{tab == 'received' ? (record.buyerName || '同学') : (record.sellerName || '同学')}} · 第{{record.attemptNo}}次</text>
          <view wx:if="{{record.message}}" class="bargains-page__message">{{record.message}}</view>
          <view class="bargains-page__bottom">
            <view class="bargains-page__price-line">
              <text class="bargains-page__price-label">报价</text>
              <text class="bargains-page__price">¥{{record.offerPrice}}</text>
            </view>
            <view wx:if="{{tab == 'received' && record.status == 0}}" class="bargains-page__actions" catchtap="noop">
              <t-button t-class="cr-secondhand-capsule cr-secondhand-capsule--outline" size="small" shape="round" theme="default" variant="outline" disabled="{{actionLoadingId != null || !actionsReady || loading}}" data-id="{{record.id}}" catch:tap="reject">拒绝</t-button>
              <t-button t-class="cr-secondhand-capsule" size="small" shape="round" theme="primary" variant="base" loading="{{actionLoadingId == record.id}}" disabled="{{actionLoadingId != null || !actionsReady || loading}}" data-id="{{record.id}}" catch:tap="accept">接受</t-button>
            </view>
            <view wx:if="{{tab == 'issued' && record.isBuyer && record.status == 0}}" class="bargains-page__actions" catchtap="noop">
              <t-button t-class="cr-secondhand-capsule cr-secondhand-capsule--outline" size="small" shape="round" theme="default" variant="outline" loading="{{actionLoadingId == record.id}}" disabled="{{actionLoadingId != null || !actionsReady || loading}}" data-id="{{record.id}}" catch:tap="withdraw">撤回报价</t-button>
            </view>
            <view wx:if="{{tab == 'issued' && record.isBuyer && record.status == 1 && !record.orderId}}" class="bargains-page__actions" catchtap="noop">
              <t-button t-class="cr-secondhand-capsule" size="small" shape="round" theme="primary" disabled="{{actionLoadingId != null || !actionsReady || loading}}" data-id="{{record.id}}" catch:tap="buyBargain">去下单</t-button>
            </view>
          </view>
          <view wx:if="{{record.status == 2}}" class="bargains-page__reason">{{record.rejectReasonText}}</view>
        </view>
      </view>
    </view>

    <ui-empty-state
      wx:else
      title="{{tab == 'received' ? '暂无收到的议价' : '暂无发出的议价'}}"
      description="{{tab == 'received' ? '买家提交报价后，会显示在这里' : '在商品详情提交报价后，会显示在这里'}}"
    />
  </scroll-view>
</view>

<t-dialog
  visible="{{showReject}}"
  title="拒绝这次报价"
  close-on-overlay-click="{{false}}"
  prevent-scroll-through
  custom-style="--td-radius-default: 24rpx; --td-dialog-title-font-size: 32rpx; --td-dialog-title-line-height: 48rpx;"
  t-class-content="bargains-page__reject-dialog-content"
  t-class-cancel="bargains-page__reject-button"
  t-class-confirm="bargains-page__reject-button"
  cancel-btn="{{ { content: '取消', theme: 'default', variant: 'outline', shape: 'round', size: 'small', disabled: rejectSubmitting } }}"
  confirm-btn="{{ { content: '确认拒绝', theme: 'danger', variant: 'base', shape: 'round', size: 'small', loading: rejectSubmitting, disabled: rejectSubmitting || !rejectReasonCode || !actionsReady } }}"
  bind:cancel="closeReject"
  bind:confirm="submitReject"
>
  <scroll-view slot="content" scroll-y="{{rejectReasonCode == 'CUSTOM'}}" show-scrollbar="{{false}}" class="bargains-page__reject-content {{rejectReasonCode == 'CUSTOM' ? 'bargains-page__reject-content--custom' : ''}}">
    <view class="bargains-page__reject-price">报价 ¥{{rejectPrice}}</view>
    <t-radio-group value="{{rejectReasonCode}}" disabled="{{rejectSubmitting}}" bind:change="selectRejectReason">
      <t-radio value="NOT_SELLING_NOW" label="暂时不打算出售" borderless />
      <t-radio value="PRICE_NOT_SUITABLE" label="暂不考虑这个价格" borderless />
      <t-radio value="CUSTOM" label="自定义原因（选填）" borderless />
    </t-radio-group>
    <t-textarea wx:if="{{rejectReasonCode == 'CUSTOM'}}" t-class="bargains-page__reject-input" value="{{rejectNote}}" maxlength="40" indicator autosize="{{ { minHeight: 48, maxHeight: 80 } }}" disabled="{{rejectSubmitting}}" placeholder="请输入原因（选填）" bind:change="changeRejectNote" />
  </scroll-view>
</t-dialog>


<ui-feedback id="ui-feedback" />
