<ui-page class="bargains-page" compact>
  <view class="bargains-page__subtitle">报价仅买卖双方可见</view>

  <view class="bargains-page__body">
    <view class="bargains-page__summary">
        <view class="bargains-page__summary-item">
          <text class="bargains-page__summary-value">{{summary.pending}}</text>
          <text class="bargains-page__summary-label">待回复</text>
        </view>
        <view class="bargains-page__summary-item">
          <text class="bargains-page__summary-value">{{summary.accepted}}</text>
          <text class="bargains-page__summary-label">已接受</text>
        </view>
        <view class="bargains-page__summary-item">
          <text class="bargains-page__summary-value">{{summary.rejected}}</text>
          <text class="bargains-page__summary-label">已拒绝</text>
        </view>
    </view>

    <ui-section plain>
      <view class="bargains-page__tabs">
        <t-tabs theme="line" show-bottom-line="{{false}}" value="{{tab}}" bind:click="onTabsClick">
          <t-tab-panel label="我收到的" value="received" />
          <t-tab-panel label="我发出的" value="issued" />
        </t-tabs>
      </view>

      <view wx:if="{{tab=='received' && received.length>0}}" class="bargains-page__list">
        <view wx:for="{{received}}" wx:key="id" class="bargains-page__row" data-status="{{item.status}}" data-order-id="{{item.orderId}}" data-product-id="{{item.productId}}" bindtap="gotoRecord">
          <view class="bargains-page__cover-link">
            <t-image class="bargains-page__cover" src="{{item.coverImage}}" mode="aspectFill" shape="round" />
          </view>
          <view class="bargains-page__content">
            <view class="bargains-page__top">
              <view class="bargains-page__title">{{item.productTitle}}</view>
              <t-tag size="small" theme="{{item.statusTheme}}" variant="light">{{item.statusText}}</t-tag>
            </view>
            <view class="bargains-page__meta">买家：{{item.buyerName || '同学'}} · 第{{item.attemptNo}}次</view>
            <view wx:if="{{item.message}}" class="bargains-page__message">{{item.message}}</view>
            <view class="bargains-page__bottom">
              <view class="bargains-page__price-line">
                <text class="bargains-page__price-label">报价</text>
                <text class="bargains-page__price">¥{{item.offerPrice}}</text>
              </view>
              <view wx:if="{{item.status==0}}" class="bargains-page__actions" catchtap="noop">
                <block wx:if="{{item.status==0}}">
                  <t-button t-class="cr-secondhand-capsule cr-secondhand-capsule--outline bargains-page__button" size="small" shape="round" variant="outline" disabled="{{actionLoadingId!=null}}" data-id="{{item.id}}" catch:tap="reject">拒绝</t-button>
                  <t-button t-class="cr-secondhand-capsule bargains-page__button" size="small" shape="round" theme="primary" loading="{{actionLoadingId==item.id}}" disabled="{{actionLoadingId!=null}}" data-id="{{item.id}}" catch:tap="accept">接受</t-button>
                </block>
              </view>
            </view>
          </view>
        </view>
      </view>

      <ui-empty-state
        wx:if="{{tab=='received' && received.length==0}}"
        title="暂无收到的议价"
        description="买家提交报价后，会显示在这里"
      />

      <view wx:if="{{tab=='issued' && issued.length>0}}" class="bargains-page__list">
        <view wx:for="{{issued}}" wx:key="id" class="bargains-page__row" data-status="{{item.status}}" data-order-id="{{item.orderId}}" data-product-id="{{item.productId}}" bindtap="gotoRecord">
          <view class="bargains-page__cover-link">
            <t-image class="bargains-page__cover" src="{{item.coverImage}}" mode="aspectFill" shape="round" />
          </view>
          <view class="bargains-page__content">
            <view class="bargains-page__top">
              <view class="bargains-page__title">{{item.productTitle}}</view>
              <t-tag size="small" theme="{{item.statusTheme}}" variant="light">{{item.statusText}}</t-tag>
            </view>
            <view class="bargains-page__meta">卖家：{{item.sellerName || '同学'}} · 第{{item.attemptNo}}次</view>
            <view wx:if="{{item.message}}" class="bargains-page__message">{{item.message}}</view>
            <view class="bargains-page__bottom">
              <view class="bargains-page__price-line">
                <text class="bargains-page__price-label">报价</text>
                <text class="bargains-page__price">¥{{item.offerPrice}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>

      <ui-empty-state
        wx:if="{{tab=='issued' && issued.length==0}}"
        title="暂无发出的议价"
        description="在商品详情提交报价后，会显示在这里"
      />
    </ui-section>
  </view>
</ui-page>
