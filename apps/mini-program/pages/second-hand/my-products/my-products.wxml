<view class="my-products-page">
  <view class="my-products-page__controls" style="padding-top: {{statusBarHeight}}px;">
    <view class="my-products-page__nav" style="height: {{navigationBarHeight}}px; padding-right: {{navigationRightPadding}}px;">
      <view class="my-products-page__back" role="button" aria-label="返回" bind:tap="goBack"><t-icon name="chevron-left" size="44rpx" color="#1d2129" /></view>
      <text class="my-products-page__nav-title">我的闲置</text>
    </view>
    <view class="my-products-page__tabs" role="tablist">
      <view class="my-products-page__tab {{tab == 'selling' ? 'my-products-page__tab--active' : ''}}" data-tab="selling" role="tab" aria-selected="{{tab == 'selling'}}" bind:tap="selectTab">在卖</view>
      <view class="my-products-page__tab {{tab == 'offShelf' ? 'my-products-page__tab--active' : ''}}" data-tab="offShelf" role="tab" aria-selected="{{tab == 'offShelf'}}" bind:tap="selectTab">已下架</view>
    </view>
  </view>
  <view class="my-products-page__controls-spacer" style="height: {{controlsHeight}}px;"></view>

  <view class="my-products-page__body">
    <view wx:if="{{filteredProducts.length>0}}" class="my-products-page__list">
      <view wx:for="{{filteredProducts}}" wx:for-item="product" wx:for-index="index" wx:key="id" class="my-products-page__card {{index > 0 ? 'my-products-page__card--separated' : ''}}">
          <view class="my-products-page__item-top">
            <text class="my-products-page__category">{{product.categoryName || '闲置好物'}}</text>
            <text class="my-products-page__status {{product.status == 4 ? 'my-products-page__status--off' : ''}}">{{product.statusText}}</text>
          </view>
          <view class="my-products-page__main" data-id="{{product.id}}" bindtap="gotoDetail">
            <t-image
              class="my-products-page__cover"
              src="{{product.coverImage}}"
              mode="aspectFill"
              shape="round"
              width="124rpx"
              height="124rpx"
            />
            <view class="my-products-page__info">
              <text class="my-products-page__title">{{product.title}}</text>
              <text class="my-products-page__meta">{{product.conditionLevel || '成色良好'}}</text>
            </view>
            <text class="my-products-page__price">¥{{product.price}}</text>
          </view>
          <view class="my-products-page__actions">
            <view class="my-products-page__more" data-id="{{product.id}}" role="button" aria-label="更多操作" catch:tap="openActionSheet">
              <t-icon name="ellipsis" size="40rpx" color="#6b778c" />
            </view>
            <view wx:if="{{product.canChangePrice}}" class="my-products-page__action-slot">
              <t-button
                t-class="cr-secondhand-capsule cr-secondhand-capsule--outline"
                size="small"
                shape="round"
                theme="default"
                variant="outline"
                data-id="{{product.id}}"
                bind:tap="openPriceSheet"
              >改价</t-button>
            </view>
            <view class="my-products-page__action-slot">
              <t-button
                t-class="cr-secondhand-capsule cr-secondhand-capsule--outline"
                size="small"
                shape="round"
                theme="default"
                variant="outline"
                data-id="{{product.id}}"
                bind:tap="editProduct"
              >编辑</t-button>
            </view>
          </view>
        </view>
      </view>

    <view wx:if="{{loading && !products.length}}" class="my-products-page__feedback"><t-loading theme="circular" text="加载中" /></view>
    <ui-empty-state wx:elif="{{!filteredProducts.length}}" title="{{tab == 'selling' ? '暂无在卖商品' : '暂无已下架商品'}}" description="{{tab == 'selling' ? '发布闲置，让同校同学看到' : ''}}" action-text="{{tab == 'selling' ? '发布闲置' : ''}}" bind:action="gotoPublish" />
  </view>
</view>

<t-popup visible="{{actionSheetVisible}}" placement="bottom" close-on-overlay-click="true" bind:visible-change="onActionSheetChange">
  <view class="my-products-page__sheet">
    <t-button block variant="text" theme="{{actionProduct.status == 4 ? 'primary' : 'danger'}}" bind:tap="toggleStatus">{{actionProduct.status == 4 ? '重新上架' : '下架商品'}}</t-button>
    <t-button block variant="text" bind:tap="showActionProductDetail">查看商品</t-button>
    <t-button block variant="text" bind:tap="closeActionSheet">关闭</t-button>
  </view>
</t-popup>

<t-popup
  visible="{{pricePopupVisible}}"
  placement="bottom"
  t-class="my-products-page__price-popup"
  custom-style="bottom: {{priceKeyboardHeight}}px"
  close-on-overlay-click="{{!priceSubmitting}}"
  bind:visible-change="onPricePopupChange"
>
  <t-icon slot="close-btn" name="close" size="36rpx" color="#6b778c" aria-label="关闭改价" />
  <view class="my-products-page__price-sheet">
    <view class="my-products-page__sheet-title">快捷改价</view>
    <view class="my-products-page__sheet-product">
      <t-image
        class="my-products-page__sheet-cover"
        src="{{priceProduct.coverImage}}"
        mode="aspectFill"
        shape="round"
        width="104rpx"
        height="104rpx"
      />
      <view class="my-products-page__sheet-info">
        <view class="my-products-page__title">{{priceProduct.title}}</view>
        <view class="my-products-page__sheet-current">当前价格 ¥{{currentPriceText}}</view>
      </view>
    </view>
    <view class="my-products-page__price-field">
      <t-input
        t-class="my-products-page__price-input"
        label="新价格"
        suffix="元"
        type="digit"
        align="right"
        value="{{priceInput}}"
        placeholder="输入新价格"
        maxlength="8"
        borderless
        disabled="{{priceSubmitting}}"
        adjust-position="{{false}}"
        confirm-type="done"
        bind:change="onPriceInput"
        bind:enter="submitPriceChange"
        bind:keyboardheightchange="onPriceKeyboardHeightChange"
      />
    </view>
    <view class="my-products-page__price-hint {{priceError ? 'my-products-page__price-hint--error' : ''}}">
      {{priceError || '请输入大于 0 的价格，最多两位小数'}}
    </view>
    <t-button
      t-class="cr-secondhand-capsule--highlight my-products-page__price-confirm"
      block
      theme="primary"
      variant="base"
      shape="round"
      loading="{{priceSubmitting}}"
      disabled="{{priceSubmitting || !priceInput}}"
      bind:tap="submitPriceChange"
    >确认改价</t-button>
  </view>
</t-popup>
