<view class="my-products-page">
  <view class="page-head">
    <view>
      <view class="page-title">我的发布</view>
      <view class="page-subtitle">管理上架、下架和商品信息</view>
    </view>
    <t-button theme="primary" size="small" bind:tap="gotoPublish">发布</t-button>
  </view>

  <view wx:if="{{products.length>0}}" class="product-list">
    <view wx:for="{{products}}" wx:key="id" class="product-card">
      <view class="product-main" data-id="{{item.id}}" bindtap="gotoDetail">
        <t-image class="cover" src="{{item.coverImage}}" mode="aspectFill" />
        <view class="info">
          <view class="row-top">
            <view class="title">{{item.title}}</view>
            <t-tag size="small" theme="{{item.statusTheme}}" variant="light">{{item.statusText}}</t-tag>
          </view>
          <view class="meta">{{item.categoryName || '未分类'}} · {{item.conditionLevel || '成色良好'}}</view>
          <view class="price">¥{{item.price}}</view>
        </view>
      </view>
      <view class="actions">
        <t-button size="small" variant="outline" data-id="{{item.id}}" bind:tap="editProduct">编辑</t-button>
        <t-button wx:if="{{item.status==0 || item.status==4}}" size="small" variant="outline" theme="{{item.status==4?'success':'danger'}}" data-id="{{item.id}}" bind:tap="toggleStatus">
          {{item.status==4?'上架':'下架'}}
        </t-button>
      </view>
    </view>
  </view>

  <view wx:if="{{!loading && products.length==0}}" class="empty">
    <view class="empty-title">还没有发布闲置</view>
    <view class="empty-desc">把用不上的东西交给同校需要的人。</view>
    <t-button theme="primary" size="small" bind:tap="gotoPublish">发布第一件</t-button>
  </view>
</view>
