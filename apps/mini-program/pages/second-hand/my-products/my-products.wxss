@import "../../../styles/second-hand-card.wxss";

page {
  background: #f6f8f7;
}

.my-products-page {
  display: block;
  min-height: 100vh;
}

.my-products-page__body {
  padding: 0 24rpx calc(48rpx + env(safe-area-inset-bottom));
}

.my-products-page__list {
  --cr-section-gap: 20rpx;
}

.my-products-page__card {
  padding: 24rpx;
  box-sizing: border-box;
}

.my-products-page__main {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}

.my-products-page__cover {
  flex: 0 0 168rpx;
  width: 168rpx;
  height: 168rpx;
  background: #edf2ee;
  border-radius: var(--cr-radius-medium, 20rpx);
  overflow: hidden;
  --td-image-round-radius: var(--cr-radius-medium, 20rpx);
}

.my-products-page__info {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
  min-height: 168rpx;
}

.my-products-page__top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
}

.my-products-page__title {
  display: -webkit-box;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: var(--cr-color-text, #1d2129);
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.4;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.my-products-page__status {
  flex: none;
}

.my-products-page__meta {
  margin-top: 10rpx;
  overflow: hidden;
  color: var(--cr-color-text-secondary, #6b778c);
  font-size: 24rpx;
  line-height: 36rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.my-products-page__price {
  margin-top: auto;
  padding-top: 14rpx;
  color: #ff6a3d;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.2;
}

.my-products-page__actions {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 20rpx;
}

.my-products-page__action-slot {
  display: flex;
  flex: none;
}

.my-products-page__price-popup {
  --td-popup-border-radius: 32rpx;
}

.my-products-page__price-sheet {
  padding: 32rpx;
}

.my-products-page__sheet-title {
  padding-right: 64rpx;
  color: var(--cr-color-text, #1d2129);
  font-size: 32rpx;
  font-weight: 600;
  line-height: 44rpx;
}

.my-products-page__sheet-product {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 28rpx;
}

.my-products-page__sheet-cover {
  flex: 0 0 104rpx;
  width: 104rpx;
  height: 104rpx;
  overflow: hidden;
  border-radius: var(--cr-radius-medium, 20rpx);
  --td-image-round-radius: var(--cr-radius-medium, 20rpx);
}

.my-products-page__sheet-info {
  flex: 1;
  min-width: 0;
}

.my-products-page__sheet-current {
  margin-top: 8rpx;
  color: var(--cr-color-text-secondary, #6b778c);
  font-size: 24rpx;
  line-height: 34rpx;
}

.my-products-page__price-field {
  margin-top: 28rpx;
  overflow: hidden;
  border-radius: var(--cr-radius-medium, 20rpx);
}

.my-products-page__price-input {
  --td-input-bg-color: #f6f8f7;
  --td-input-vertical-padding: 24rpx;
}

.my-products-page__price-hint {
  min-height: 34rpx;
  margin: 12rpx 0 28rpx;
  color: var(--cr-color-text-secondary, #6b778c);
  font-size: 24rpx;
  line-height: 34rpx;
}

.my-products-page__price-hint--error {
  color: #c94b44;
}

.my-products-page__price-confirm {
  --td-button-font-weight: 400;
  --td-button-medium-font-size: 28rpx;
}
