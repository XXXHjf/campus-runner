@import "../../../styles/second-hand-card.wxss";

page {
  background: #f6f8f7;
}

.my-products-page {
  min-height: 100vh;
  overflow-x: hidden;
}

.my-products-page__controls {
  position: fixed;
  top: 0;
  right: 0;
  left: 0;
  z-index: 10;
  background: var(--cr-color-surface, #fff);
}
.my-products-page__nav {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-height: 44px;
  padding-left: 24rpx;
}
.my-products-page__back {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 62rpx;
  height: 72rpx;
}
.my-products-page__nav-title {
  color: var(--cr-color-text, #1d2129);
  font-size: 30rpx;
  font-weight: 700;
}
.my-products-page__body {
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.my-products-page__tabs {
  display: flex;
  height: 84rpx;
  border-bottom: 1rpx solid var(--cr-color-border, #edf0f2);
  background: var(--cr-color-surface, #fff);
}

.my-products-page__tab {
  position: relative;
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  color: var(--cr-color-text-secondary, #6b778c);
  font-size: 23rpx;
}

.my-products-page__tab--active { color: var(--cr-color-primary, #0052d9); font-weight: 700; }
.my-products-page__tab--active::after {
  position: absolute;
  right: 39%;
  bottom: 0;
  left: 39%;
  height: 5rpx;
  border-radius: 5rpx;
  background: var(--cr-color-primary, #0052d9);
  content: '';
}

.my-products-page__list {
  margin: 24rpx var(--cr-page-padding, 24rpx) 48rpx;
  overflow: hidden;
  border-radius: var(--cr-radius-large, 24rpx);
  background: var(--cr-color-surface, #fff);
  box-shadow: var(--cr-shadow-card);
}

.my-products-page__card {
  padding: 28rpx 26rpx 30rpx;
}
.my-products-page__card--separated { border-top: 1rpx solid var(--cr-color-border, #edf0f2); }
.my-products-page__item-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  margin-bottom: 28rpx;
}
.my-products-page__category {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: var(--cr-color-text-secondary, #6b778c);
  font-size: 24rpx;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.my-products-page__status {
  flex: none;
  padding: 7rpx 14rpx;
  border-radius: var(--cr-radius-small, 10rpx);
  color: var(--cr-color-primary, #0052d9);
  background: var(--cr-color-primary-light, #edf3ff);
  font-size: 24rpx;
  line-height: 1.3;
}
.my-products-page__status--off {
  color: var(--cr-color-text-secondary, #6b778c);
  background: var(--cr-color-background, #f6f8f7);
}

.my-products-page__main {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-width: 0;
}

.my-products-page__cover {
  flex: none;
  width: 124rpx;
  height: 124rpx;
  background: #edf2ee;
  border-radius: var(--cr-radius-medium, 20rpx);
  overflow: hidden;
  --td-image-round-radius: var(--cr-radius-medium, 20rpx);
}

.my-products-page__info {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 12rpx;
  min-width: 0;
}

.my-products-page__title {
  overflow: hidden;
  color: var(--cr-color-text, #1d2129);
  font-size: 29rpx;
  font-weight: 700;
  line-height: 1.4;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.my-products-page__meta {
  overflow: hidden;
  color: var(--cr-color-text-secondary, #6b778c);
  font-size: 22rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.my-products-page__price {
  flex: 0 0 132rpx;
  width: 132rpx;
  color: #e7552d;
  font-size: 30rpx;
  font-weight: 700;
  text-align: right;
  white-space: nowrap;
}

.my-products-page__actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 32rpx;
}

.my-products-page__more {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 68rpx;
  height: 56rpx;
  margin-right: auto;
}

.my-products-page__sheet { padding: 24rpx 32rpx calc(20rpx + env(safe-area-inset-bottom)); }
.my-products-page__feedback { display: flex; justify-content: center; padding: 90rpx 0; }

.my-products-page__action-slot {
  display: flex;
  flex: none;
}

.my-products-page__price-popup {
  --td-popup-border-radius: 32rpx;
}

.my-products-page__price-sheet {
  padding: 32rpx;
}

.my-products-page__sheet-title {
  padding-right: 64rpx;
  color: var(--cr-color-text, #1d2129);
  font-size: 32rpx;
  font-weight: 600;
  line-height: 44rpx;
}

.my-products-page__sheet-product {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 28rpx;
}

.my-products-page__sheet-cover {
  flex: 0 0 104rpx;
  width: 104rpx;
  height: 104rpx;
  overflow: hidden;
  border-radius: var(--cr-radius-medium, 20rpx);
  --td-image-round-radius: var(--cr-radius-medium, 20rpx);
}

.my-products-page__sheet-info {
  flex: 1;
  min-width: 0;
}

.my-products-page__sheet-current {
  margin-top: 8rpx;
  color: var(--cr-color-text-secondary, #6b778c);
  font-size: 24rpx;
  line-height: 34rpx;
}

.my-products-page__price-field {
  margin-top: 28rpx;
  overflow: hidden;
  border-radius: var(--cr-radius-medium, 20rpx);
}

.my-products-page__price-input {
  --td-input-bg-color: #f6f8f7;
  --td-input-vertical-padding: 24rpx;
}

.my-products-page__price-hint {
  min-height: 34rpx;
  margin: 12rpx 0 28rpx;
  color: var(--cr-color-text-secondary, #6b778c);
  font-size: 24rpx;
  line-height: 34rpx;
}

.my-products-page__price-hint--error {
  color: #c94b44;
}

.my-products-page__price-confirm {
  --td-button-font-weight: 400;
  --td-button-medium-font-size: 28rpx;
}
