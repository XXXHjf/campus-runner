page {
  background: #f6f8f7;
  width: 100%;
  overflow-x: hidden;
}

.second-hand-page {
  width: 100%;
  min-height: 100vh;
  padding: 28rpx 24rpx 48rpx;
  box-sizing: border-box;
  overflow-x: hidden;
}

.market-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx 4rpx 20rpx;
}

.eyebrow {
  color: #19a66a;
  font-size: 24rpx;
  font-weight: 600;
}

.title {
  margin-top: 8rpx;
  color: #17231d;
  font-size: 52rpx;
  font-weight: 800;
  line-height: 1.1;
}

.subtitle {
  margin-top: 12rpx;
  color: #56625b;
  font-size: 26rpx;
}

.trust-strip,
.search-wrap,
.empty {
  background: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 10rpx 30rpx rgba(24, 57, 42, 0.06);
}

.trust-strip {
  display: flex;
  padding: 24rpx 10rpx;
}

.trust-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.trust-value {
  color: #17231d;
  font-size: 36rpx;
  font-weight: 800;
}

.trust-label {
  color: #7a867f;
  font-size: 22rpx;
}

.publish-entry {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  height: 72rpx;
  padding: 0 24rpx;
  color: #ffffff;
  background: #0052d9;
  border-radius: 36rpx;
  font-size: 25rpx;
  font-weight: 700;
  box-shadow: 0 8rpx 18rpx rgba(0, 82, 217, 0.2);
  box-sizing: border-box;
}

.search-wrap {
  margin-top: 12rpx;
  overflow: hidden;
}

.category-scroll {
  display: block;
  width: 100%;
  margin-top: 22rpx;
  overflow: hidden;
}

.category-row {
  display: inline-flex;
  min-width: 100%;
  gap: 14rpx;
  box-sizing: border-box;
  white-space: nowrap;
}

.category-pill {
  display: inline-flex;
  flex: none;
  align-items: center;
  justify-content: center;
  height: 64rpx;
  padding: 0 26rpx;
  background: #ffffff;
  border: 1rpx solid #e0e8e3;
  border-radius: 999rpx;
  color: #536058;
  font-size: 25rpx;
}

.category-pill.active {
  background: #17231d;
  border-color: #17231d;
  color: #ffffff;
  font-weight: 700;
}

.product-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
  margin-top: 24rpx;
}

.product-card {
  background: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 10rpx 28rpx rgba(24, 57, 42, 0.06);
}

.cover {
  width: 100%;
  height: 260rpx;
  background: #edf2ee;
}

.product-body {
  padding: 18rpx;
}

.product-title {
  color: #17231d;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.35;
  min-height: 76rpx;
}

.product-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 12rpx;
  min-height: 38rpx;
}

.product-bottom {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 10rpx;
  margin-top: 14rpx;
}

.price {
  color: #ff6a3d;
  font-size: 34rpx;
  font-weight: 800;
}

.campus {
  color: #8a958f;
  font-size: 22rpx;
  max-width: 120rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.empty {
  margin-top: 28rpx;
  padding: 64rpx 24rpx;
  text-align: center;
}

.empty-title {
  color: #17231d;
  font-size: 30rpx;
  font-weight: 700;
}

.empty-desc {
  margin: 12rpx 0 24rpx;
  color: #5f6b64;
  font-size: 24rpx;
}
