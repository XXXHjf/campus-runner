<view class="second-hand-page">
  <view class="market-controls">
    <view class="market-nav-shell" style="padding-top: {{statusBarHeight}}px;">
      <view
        class="market-nav"
        style="height: {{navigationBarHeight}}px; padding-right: {{navigationRightPadding}}px;"
      >
        <view class="market-brand">帮帮</view>
        <view wx:if="{{schoolName}}" class="market-school">
          <text class="market-school-name">{{schoolName}}</text>
        </view>
      </view>
      <view class="market-search">
        <t-search
          value="{{keyword}}"
          shape="round"
          placeholder="搜索校园好物"
          bind:change="onSearchChange"
          bind:submit="onSearch"
          bind:clear="clearSearch"
        />
      </view>
    </view>

    <view class="market-toolbar">
      <scroll-view
        class="category-scroll"
        scroll-x="{{true}}"
        enhanced="{{true}}"
        bounces="{{false}}"
        show-scrollbar="{{false}}"
      >
        <view class="category-row">
          <view class="category-pill {{activeCategoryId==null?'active':''}}" bindtap="selectCategory">全部</view>
          <view wx:for="{{categories}}" wx:key="id" class="category-pill {{activeCategoryId==item.id?'active':''}}" data-id="{{item.id}}" bindtap="selectCategory">
            {{item.name}}
          </view>
        </view>
      </scroll-view>
      <view class="market-actions">
        <view class="filter-entry {{filterCount>0?'filter-entry--active':''}}" bindtap="openFilter">
          <t-icon name="filter" size="28rpx" color="{{filterCount>0?'#0052d9':'#52605a'}}" />
          <text>筛选</text>
          <view wx:if="{{filterCount>0}}" class="filter-entry-count">{{filterCount}}</view>
        </view>
        <view class="publish-entry" bindtap="gotoPublish">
          <t-icon name="add" size="28rpx" color="#ffffff" />
          <text>发布</text>
        </view>
      </view>
    </view>

    <view wx:if="{{filterCount>0}}" class="secondhand-filter-summary">
      <t-icon name="filter" size="26rpx" color="#0052d9" />
      <text class="secondhand-filter-summary-text">{{filterSummary}}</text>
      <text class="secondhand-filter-summary-clear" bindtap="clearFilters">清除</text>
    </view>
  </view>

  <scroll-view
    class="product-feed"
    scroll-y="{{true}}"
    enhanced="{{true}}"
    bounces="{{true}}"
    show-scrollbar="{{false}}"
    refresher-enabled="{{true}}"
    refresher-triggered="{{refreshing}}"
    refresher-background="#f6f8f7"
    bindrefresherrefresh="onRefresh"
  >
    <view wx:if="{{products.length>0}}" class="product-grid">
      <view wx:for="{{products}}" wx:key="id" class="product-card" data-id="{{item.id}}" bindtap="gotoDetail">
        <t-image class="cover" src="{{item.coverImage}}" mode="aspectFill" />
        <view class="product-body">
          <view class="product-title">{{item.title}}</view>
          <view class="product-tags">
            <t-tag size="small" variant="light">{{item.conditionText}}</t-tag>
            <t-tag wx:if="{{item.negotiable==1}}" size="small" theme="success" variant="light">可议价</t-tag>
          </view>
          <view class="product-bottom">
            <text class="price">¥{{item.price}}</text>
            <!-- <text class="campus">{{item.compusName || '同校'}}</text> -->
          </view>
        </view>
      </view>
    </view>

    <view wx:if="{{!loading && products.length == 0}}" class="empty-wrap">
      <ui-section>
        <ui-empty-state
          title="暂无匹配商品"
          description="{{filterCount>0?'调整筛选条件，看看更多校园闲置':'换个关键词试试，或者发布第一件闲置'}}"
          action-text="{{filterCount>0?'清除筛选':'发布闲置'}}"
          bind:action="handleEmptyAction"
        />
      </ui-section>
    </view>
  </scroll-view>
</view>

<t-popup visible="{{filterVisible}}" placement="bottom" bind:visible-change="onFilterVisibleChange">
  <view class="secondhand-filter-sheet">
    <view class="secondhand-filter-header">
      <view>
        <view class="secondhand-filter-title">筛选校园闲置</view>
        <view class="secondhand-filter-subtitle">更快找到合适的商品和自提位置</view>
      </view>
      <text class="secondhand-filter-reset" bindtap="resetFilterDraft">重置</text>
    </view>

    <view class="secondhand-filter-section">
      <view class="secondhand-filter-section-title">商品类型</view>
      <view class="secondhand-filter-options">
        <view
          class="secondhand-filter-chip {{draftCategoryId==null?'secondhand-filter-chip--active':''}}"
          bindtap="selectFilterCategory"
        >全部</view>
        <view
          wx:for="{{categories}}"
          wx:key="id"
          class="secondhand-filter-chip {{draftCategoryId==item.id?'secondhand-filter-chip--active':''}}"
          data-id="{{item.id}}"
          bindtap="selectFilterCategory"
        >{{item.name}}</view>
      </view>
    </view>

    <view class="secondhand-filter-section">
      <view class="secondhand-filter-section-title">自提位置</view>
      <view class="secondhand-filter-location">
        <view class="secondhand-filter-location-main" bindtap="chooseFilterAddress">
          <view class="secondhand-filter-location-icon">
            <t-icon name="location" size="34rpx" color="#0052d9" />
          </view>
          <view class="secondhand-filter-location-content">
            <view class="secondhand-filter-location-value">
              {{draftPickupAddress?draftPickupAddress.displayText:'不限自提位置'}}
            </view>
            <view class="secondhand-filter-location-hint">按卖家发布商品时设置的自提点筛选</view>
          </view>
          <t-icon name="chevron-right" size="34rpx" color="#8a9490" />
        </view>
        <text
          wx:if="{{draftPickupAddress}}"
          class="secondhand-filter-location-clear"
          catchtap="clearDraftPickupAddress"
        >清除</text>
      </view>
    </view>

    <view class="secondhand-filter-actions">
      <t-button block theme="primary" shape="round" bind:tap="applyFilterSelection">查看结果</t-button>
    </view>
  </view>
</t-popup>

<triple-address-pricker
  id="secondHandAddressPicker"
  bind:confirmSelection="handleFilterAddressConfirm"
/>
