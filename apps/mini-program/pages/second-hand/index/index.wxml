<view class="second-hand-page">
  <view class="market-head">
    <view>
      <view class="eyebrow">校园担保交易</view>
      <view class="title">找同校好物</view>
      <!-- <view class="subtitle">平台担保支付，交付确认后卖家收款</view> -->
    </view>
  </view>

  <view class="workbench">
    <view class="workbench-item primary" bindtap="gotoPublish">
      <text class="workbench-title">发布闲置</text>
      <text class="workbench-desc">拍照填价，快速上架</text>
    </view>
    <view class="workbench-item" bindtap="gotoMyProducts">
      <text class="workbench-title">我的发布</text>
      <text class="workbench-desc">编辑、上下架</text>
    </view>
    <view class="workbench-item" bindtap="gotoOrders">
      <text class="workbench-title">我的买卖</text>
      <text class="workbench-desc">支付与交付进度</text>
    </view>
    <view class="workbench-item" bindtap="gotoBargains">
      <text class="workbench-title">议价工作台</text>
      <text class="workbench-desc">处理报价请求</text>
    </view>
  </view>

  <view class="search-wrap">
    <t-search value="{{keyword}}" placeholder="搜索商品、地点、关键词" bind:change="onSearchChange" bind:submit="onSearch" bind:clear="clearSearch" />
  </view>

  <scroll-view scroll-x class="category-scroll" show-scrollbar="{{false}}">
    <view class="category-row">
      <view class="category-pill {{activeCategoryId==null?'active':''}}" bindtap="selectCategory">全部</view>
      <view wx:for="{{categories}}" wx:key="id" class="category-pill {{activeCategoryId==item.id?'active':''}}" data-id="{{item.id}}" bindtap="selectCategory">
        {{item.name}}
      </view>
    </view>
  </scroll-view>

  <view wx:if="{{products.length>0}}" class="product-grid">
    <view wx:for="{{products}}" wx:key="id" class="product-card" data-id="{{item.id}}" bindtap="gotoDetail">
      <t-image class="cover" src="{{item.coverImage}}" mode="aspectFill" />
      <view class="product-body">
        <view class="product-title">{{item.title}}</view>
        <view class="product-tags">
          <t-tag size="small" variant="light">{{item.conditionText}}</t-tag>
          <t-tag wx:if="{{item.negotiable==1}}" size="small" theme="success" variant="light">可议价</t-tag>
        </view>
        <view class="product-bottom">
          <text class="price">¥{{item.price}}</text>
          <!-- <text class="campus">{{item.compusName || '同校'}}</text> -->
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{!loading && products.length==0}}" class="empty">
    <view class="empty-title">暂无匹配商品</view>
    <view class="empty-desc">换个关键词试试，或者发布第一件闲置</view>
    <t-button theme="primary" size="small" bind:tap="gotoPublish">发布闲置</t-button>
  </view>
</view>
