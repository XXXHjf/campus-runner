@import "../../../styles/second-hand-card.wxss";

page {
  background: #f3f4f5;
}

.detail-page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background: #f3f4f5;
}

.detail-page .detail-seller-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  background: #f3f4f5;
}

.detail-page .detail-seller-bar t-avatar {
  flex: 0 0 auto;
}

.detail-page .detail-seller-name {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--cr-color-text, #1d2129);
  font-size: 28rpx;
  font-weight: 600;
}

.detail-page .detail-seller-sales {
  flex: 0 0 auto;
  color: var(--cr-color-text-secondary, #6b778c);
  font-size: 22rpx;
  white-space: nowrap;
}

.detail-page .swiper,
.detail-page .gallery-image,
.detail-page .gallery-empty {
  width: 100%;
  height: 100%;
}

.detail-page .gallery {
  position: relative;
  height: 0;
  /* 固定宽高比 9:14，百分比内边距随内容宽度缩放。 */
  padding-top: 155.555556%;
  overflow: hidden;
  margin-top: 30rpx;
  border-radius: 24rpx;
}

.detail-page .gallery > .swiper,
.detail-page .gallery > .gallery-empty {
  position: absolute;
  top: 0;
  left: 0;
}

.detail-page .detail-gallery-counter {
  position: absolute;
  right: 16rpx;
  bottom: 16rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.55);
  color: #ffffff;
  font-size: 24rpx;
  line-height: 1.4;
  pointer-events: none;
}

.detail-page .gallery-image {
  display: block;
  background: #edf2ee;
}

.detail-page .gallery-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #87928c;
  background: #edf2ee;
  font-size: 26rpx;
}

.detail-page .main-card {
  flex: 1;
  padding: 32rpx 28rpx calc(188rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  border-radius: 36rpx 36rpx 0 0;
}

.detail-page .detail-primary {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.detail-page .price {
  min-width: 0;
  color: #ff6a3d;
  font-size: 52rpx;
  font-weight: 800;
}

.detail-page .title {
  margin-top: 12rpx;
  color: #17231d;
  font-size: 36rpx;
  font-weight: 800;
  line-height: 1.35;
}

.detail-page .favorite-count {
  flex-shrink: 0;
  margin-top: 12rpx;
  color: #7a867f;
  font-size: 23rpx;
}

.detail-page .tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 18rpx;
}

.detail-page .guarantee {
  margin-top: 18rpx;
  color: var(--cr-color-text-secondary);
  font-size: 22rpx;
  line-height: 1.6;
}

.detail-page .detail-delivery {
  margin-top: 28rpx;
}

.detail-page .detail-seller-consultations {
  margin-top: 24rpx;
}

.detail-page .info-line {
  color: #26332b;
  font-size: 28rpx;
  font-weight: 600;
}

.detail-page .info-muted {
  margin-top: 10rpx;
  color: #7a867f;
  font-size: 24rpx;
  line-height: 1.5;
}

.detail-page .description {
  margin-top: 28rpx;
  color: #344139;
  font-size: 27rpx;
  line-height: 1.65;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}

.message-row {
  padding: 18rpx 0;
  border-top: 1rpx solid #eef2ef;
}

.message-row:first-of-type {
  margin-top: 12rpx;
}

.message-name {
  color: #5e6b63;
  font-size: 23rpx;
}

.message-content {
  margin-top: 8rpx;
  color: #17231d;
  font-size: 26rpx;
  line-height: 1.5;
}

.sheet-mask {
  position: fixed;
  inset: 0;
  z-index: 60;
  display: flex;
  align-items: flex-end;
  background: rgba(12, 20, 16, 0.42);
}

.sheet {
  width: 100%;
  padding: 28rpx 24rpx 48rpx;
  background: #ffffff;
  border-radius: 28rpx 28rpx 0 0;
  box-sizing: border-box;
}

.buy-sheet {
  max-height: 82vh;
}

.sheet-title {
  margin-bottom: 20rpx;
  color: #17231d;
  font-size: 34rpx;
  font-weight: 800;
}

.sheet-actions {
  display: flex;
  gap: 18rpx;
  margin-top: 24rpx;
}

.sheet-actions t-button {
  flex: 1;
}

.buy-price {
  margin-bottom: 18rpx;
  color: #ff6a3d;
  font-size: 42rpx;
  font-weight: 800;
}

.mode-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.mode-card {
  min-height: 148rpx;
  padding: 20rpx;
  border: 2rpx solid #e4ebe7;
  border-radius: 14rpx;
  box-sizing: border-box;
  background: #fbfcfb;
}

.mode-card.active {
  border-color: #19a66a;
  background: #eaf8f1;
}

.mode-card.disabled {
  opacity: 0.52;
}

.mode-title,
.sheet-row-title,
.address-main {
  color: #17231d;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 1.4;
}

.mode-desc,
.address-meta {
  margin-top: 10rpx;
  color: #7a867f;
  font-size: 23rpx;
  line-height: 1.45;
}

.address-picker-block {
  margin-top: 22rpx;
}

.address-list {
  max-height: 360rpx;
  margin: 14rpx 0;
}

.address-option {
  padding: 18rpx 4rpx;
  border-bottom: 1rpx solid #eef2ef;
}

.address-option.active .address-main {
  color: #19a66a;
}

.empty-address {
  padding: 30rpx 8rpx;
  text-align: center;
}

.empty-title {
  color: #17231d;
  font-size: 27rpx;
  font-weight: 800;
}

.detail-page .detail-action-bar {
  --cr-action-bar-padding-top: 11rpx;
}

.detail-page .detail-bottom-actions {
  display: flex;
  align-items: center;
  width: 100%;
  gap: 16rpx;
}

.detail-page .detail-secondary-actions {
  display: flex;
  flex: 0 0 auto;
  gap: 8rpx;
}

.detail-page .detail-icon-button {
  min-width: 76rpx;
  margin: 0;
  --td-button-medium-height: 84rpx;
  --td-button-medium-padding-horizontal: 8rpx;
  --td-button-font-weight: 400;
  --td-button-default-color: var(--cr-color-text-secondary);
}

.detail-page .detail-icon-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  font-size: 20rpx;
  line-height: 1.2;
}

.detail-page .detail-primary-actions {
  display: flex;
  justify-content: flex-end;
  flex: 1;
  min-width: 0;
  gap: 12rpx;
  margin-left: auto;
}

/* class 控制组件外层的排列，避免胶囊被 flex 拉宽。 */
.detail-page .detail-capsule-action {
  flex: 0 0 auto;
  min-width: 0;
}

/* t-class 作用于按钮本体；保留已人工验收的尺寸，圆角和最小宽度沿用公共胶囊样式。 */
.detail-page .detail-bottom-capsule {
  width: 100%;
  max-width: 180rpx;
  --td-button-medium-height: 65rpx;
  --td-button-medium-font-size: 28rpx;
  --td-button-medium-padding-horizontal: 12rpx;
}

.detail-page .detail-owner-action {
  flex: 1;
}
