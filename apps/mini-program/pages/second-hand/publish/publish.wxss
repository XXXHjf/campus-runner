.secondhand-publish__header {
  padding: 24rpx 4rpx 30rpx;
}

.secondhand-publish__title {
  font-size: 44rpx;
  font-weight: 700;
  line-height: 60rpx;
  color: var(--cr-color-text);
}

.secondhand-publish__subtitle,
.secondhand-publish__hint,
.secondhand-sheet__subtitle {
  font-size: 24rpx;
  line-height: 36rpx;
  color: var(--cr-color-text-secondary);
}

.secondhand-publish__subtitle {
  margin-top: 8rpx;
}

.secondhand-publish__select-row,
.secondhand-publish__switch-row {
  box-sizing: border-box;
  display: flex;
  gap: 24rpx;
  align-items: center;
  justify-content: space-between;
  min-height: 96rpx;
  margin: 0 30rpx;
  border-top: 1rpx solid var(--cr-color-border);
}

.secondhand-publish__select-row--address,
.secondhand-publish__switch-row {
  padding: 20rpx 0;
}

.secondhand-publish__select-row--address {
  align-items: flex-start;
}

.secondhand-publish__label {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--cr-color-text);
}

.secondhand-publish__value {
  font-size: 27rpx;
  text-align: right;
  color: var(--cr-color-text);
}

.secondhand-publish__value--muted {
  color: var(--cr-color-placeholder);
}

.secondhand-publish__select-content {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: flex-end;
  min-width: 0;
}

.secondhand-publish__textarea,
.secondhand-publish__upload {
  padding: 0 30rpx 28rpx;
}

.secondhand-publish__action {
  flex: 1;
  min-width: 0;
}

.secondhand-sheet-mask {
  position: fixed;
  z-index: 80;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: flex-end;
  background: rgba(22, 26, 33, 0.42);
}

.secondhand-sheet {
  box-sizing: border-box;
  width: 100%;
  max-height: 70vh;
  padding: 30rpx 30rpx calc(40rpx + env(safe-area-inset-bottom));
  background: var(--cr-color-surface);
  border-radius: var(--cr-radius-large) var(--cr-radius-large) 0 0;
}

.secondhand-sheet__title {
  margin-bottom: 18rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: var(--cr-color-text);
}

.secondhand-sheet__header {
  display: flex;
  gap: 20rpx;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.secondhand-sheet__header .secondhand-sheet__title {
  margin-bottom: 0;
}

.secondhand-sheet__link {
  padding: 8rpx 0 8rpx 24rpx;
  font-size: 27rpx;
  font-weight: 600;
  color: var(--cr-color-primary);
}

.secondhand-sheet__category-list {
  max-height: 560rpx;
}

.secondhand-sheet__address-list {
  max-height: 620rpx;
}

.secondhand-sheet__option,
.secondhand-sheet__address {
  box-sizing: border-box;
  min-height: 92rpx;
  border-bottom: 1rpx solid var(--cr-color-border);
}

.secondhand-sheet__option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 6rpx;
  font-size: 28rpx;
  color: var(--cr-color-text);
}

.secondhand-sheet__address {
  padding: 22rpx 6rpx;
}

.secondhand-sheet__option--active,
.secondhand-sheet__address--active .secondhand-sheet__address-main,
.secondhand-sheet__selected {
  color: var(--cr-color-primary);
}

.secondhand-sheet__option--active,
.secondhand-sheet__address-main {
  font-weight: 600;
}

.secondhand-sheet__address-main {
  font-size: 28rpx;
  line-height: 42rpx;
  color: var(--cr-color-text);
}

.secondhand-sheet__selected {
  font-size: 24rpx;
}
