<view class="publish-page">
  <view class="publish-head">
    <view class="title">{{isEdit?'编辑闲置':'发布闲置'}}</view>
    <view class="subtitle">上传清晰图片，填写交接地点，清楚描述闲置物品信息</view>
  </view>

  <view class="section">
    <view class="section-title">商品信息</view>
    <t-input label="标题" value="{{form.title}}" placeholder="例如：九成新罗技键盘" data-field="title" bind:change="setField" />
    <view class="select-row" bindtap="chooseCategory">
      <text class="select-label">分类</text>
      <text class="select-value {{categoryName?'':'muted'}}">{{categoryName || '请选择分类'}}</text>
    </view>
    <view class="select-row" bindtap="chooseCondition">
      <text class="select-label">成色</text>
      <text class="select-value">{{form.conditionLevel}}</text>
    </view>
    <t-input label="售价" type="digit" value="{{form.price}}" placeholder="请输入成交价" data-field="price" bind:change="setField" />
    <t-textarea value="{{form.description}}" placeholder="描述成色、配件、使用情况、瑕疵等" maxlength="600" data-field="description" bind:change="setField" />
  </view>

  <view class="section">
    <view class="section-title">商品图片</view>
    <view class="hint">至少 1 张，建议包含整体、细节、瑕疵位置</view>
    <t-upload mediaType="{{['image']}}" max="{{6}}" files="{{fileList}}" bind:add="handleAdd" bind:remove="handleRemove" />
  </view>

  <view class="section">
    <view class="section-title">交付设置</view>
    <view class="select-row address-select" bindtap="choosePickupAddress">
      <text class="select-label">自提点</text>
      <view class="select-content">
        <text class="select-value {{pickupAddressText?'':'muted'}}">{{pickupAddressText || '从地址簿选择'}}</text>
        <text class="select-tip">默认交货地点</text>
      </view>
    </view>
    <view class="switch-row">
      <view>
        <view class="switch-title">仅支持自提</view>
        <view class="hint">{{form.pickupOnly==1?'买家将于自提点取货':'下单后买家填写配送地址'}}</view>
      </view>
      <t-switch value="{{form.pickupOnly==1}}" bind:change="setPickupOnly" />
    </view>
    <view class="switch-row">
      <view>
        <view class="switch-title">允许议价</view>
        <view class="hint">开启后，买家可以向你发送报价</view>
      </view>
      <t-switch value="{{form.negotiable==1}}" data-field="negotiable" bind:change="setSwitch" />
    </view>
  </view>

  <view class="submit-bar">
    <t-button block theme="primary" loading="{{submitting || uploading}}" disabled="{{submitting || uploading}}" bind:tap="submit">
      {{isEdit?'保存修改':'发布闲置'}}
    </t-button>
  </view>

  <view wx:if="{{showCategorySheet}}" class="sheet-mask" bindtap="closeCategorySheet">
    <view class="sheet" catchtap="noop">
      <view class="sheet-title">选择分类</view>
      <scroll-view scroll-y class="category-sheet-list">
        <view wx:for="{{categories}}" wx:key="id" class="category-option {{form.categoryId==item.id?'active':''}}" data-id="{{item.id}}" bindtap="selectCategory">
          <text>{{item.name}}</text>
          <text wx:if="{{form.categoryId==item.id}}" class="selected-mark">已选</text>
        </view>
      </scroll-view>
    </view>
  </view>

  <view wx:if="{{showPickupAddressSheet}}" class="sheet-mask" bindtap="closePickupAddressSheet">
    <view class="sheet" catchtap="noop">
      <view class="sheet-header">
        <view>
          <view class="sheet-title">选择自提点</view>
          <view class="sheet-subtitle">选择你方便交接的地点。</view>
        </view>
        <text class="sheet-link" bindtap="gotoAddPickupAddress">新增</text>
      </view>
      <scroll-view scroll-y class="address-sheet-list">
        <view wx:for="{{addressBook}}" wx:key="id" class="address-option {{form.pickupAddressId==item.id?'active':''}}" data-id="{{item.id}}" bindtap="selectPickupAddress">
          <view class="address-main">{{item.addressText}}</view>
          <view class="address-meta">{{item.typeText}}地址{{item.isDefault==1?' · 默认':''}}{{item.label?' · '+item.label:''}}</view>
        </view>
        <view wx:if="{{addressBook.length==0}}" class="empty-address">
          <view class="empty-title">还没有可选地址</view>
          <view class="hint">先新增一个地址，再回来发布闲置。</view>
          <t-button size="small" theme="primary" bind:tap="gotoAddPickupAddress">新增地址</t-button>
        </view>
      </scroll-view>
    </view>
  </view>
</view>
