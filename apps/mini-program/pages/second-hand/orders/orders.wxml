<view class="orders-page">
  <view class="page-head">
    <view class="page-title">我的买卖</view>
  </view>

  <view class="summary">
    <view class="summary-item">
      <text class="summary-value">{{summary.waitingDelivery}}</text>
      <text class="summary-label">待交付</text>
    </view>
    <view class="summary-item">
      <text class="summary-value">{{summary.waitingConfirm}}</text>
      <text class="summary-label">待确认</text>
    </view>
    <view class="summary-item">
      <text class="summary-value">{{summary.completed}}</text>
      <text class="summary-label">已完成</text>
    </view>
  </view>

  <t-tabs value="{{tab}}" bind:click="onTabsClick">
    <t-tab-panel label="我买到的" value="buy" />
    <t-tab-panel label="我卖出的" value="sell" />
  </t-tabs>

  <view wx:if="{{tab=='buy'}}" class="order-list">
    <view wx:for="{{buyerOrders}}" wx:key="id" class="order-card" data-id="{{item.id}}" bindtap="gotoDetail">
      <t-image class="cover" src="{{item.coverImage}}" mode="aspectFill" />
      <view class="order-info">
        <view class="row-top">
          <view class="title">{{item.productTitle}}</view>
          <t-tag size="small" theme="{{item.statusTheme}}" variant="light">{{item.statusText}}</t-tag>
        </view>
        <view class="meta">卖家：{{item.sellerName || '同学'}}</view>
        <view class="bottom">
          <text class="price">约定价 ¥{{item.payAmount}}</text>
          <text class="hint">查看详情</text>
        </view>
      </view>
    </view>
    <view wx:if="{{buyerOrders.length==0}}" class="empty">暂无购买订单</view>
  </view>

  <view wx:if="{{tab=='sell'}}" class="order-list">
    <view wx:for="{{sellerOrders}}" wx:key="id" class="order-card" data-id="{{item.id}}" bindtap="gotoDetail">
      <t-image class="cover" src="{{item.coverImage}}" mode="aspectFill" />
      <view class="order-info">
        <view class="row-top">
          <view class="title">{{item.productTitle}}</view>
          <t-tag size="small" theme="{{item.statusTheme}}" variant="light">{{item.statusText}}</t-tag>
        </view>
        <view class="meta">买家：{{item.buyerName || '同学'}}</view>
        <view class="bottom">
          <text class="price">约定价 ¥{{item.payAmount}}</text>
          <text class="hint">查看详情</text>
        </view>
      </view>
    </view>
    <view wx:if="{{sellerOrders.length==0}}" class="empty">暂无出售订单</view>
  </view>
</view>
