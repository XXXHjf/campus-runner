@import "../../../styles/second-hand-card.wxss";

page { background: #f3f4f5; }
.order-detail-page {
  min-height: 100vh;
  padding: 24rpx 16rpx calc(180rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  --cr-radius-medium: 32rpx;
  --cr-action-bar-padding-top: 12rpx;
}
.order-detail-page .status-panel {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 12rpx 20rpx 32rpx;
}
.order-detail-page .status-title { font-size: 40rpx; font-weight: 600; color: var(--cr-color-text); }
.order-detail-page .pay-countdown { color: var(--cr-color-danger); font-size: 24rpx; margin: 0 20rpx 24rpx; }
.order-detail-page .order-content { padding: 28rpx; }
.order-detail-page .product-row { display: flex; align-items: center; gap: 28rpx; padding: 0 0 30rpx; }
.order-detail-page .cover {
  width: 166rpx; height: 166rpx; flex: 0 0 166rpx;
  --td-image-round-radius: 20rpx;
}
.order-detail-page .product-info { flex: 1; min-width: 0; }
.order-detail-page .product-title { font-size: 32rpx; font-weight: 600; line-height: 1.45; overflow-wrap: anywhere; }
.order-detail-page .product-meta,
.order-detail-page .info-muted { margin-top: 14rpx; color: var(--cr-color-text-secondary); font-size: 24rpx; line-height: 1.6; }
.order-detail-page .order-section { padding: 28rpx 0; border-top: 1rpx solid var(--cr-color-border); }
.order-detail-page .order-section:last-child { padding-bottom: 8rpx; }
.order-detail-page .section-title { color: var(--cr-color-text); font-size: 30rpx; font-weight: 600; }
.order-detail-page .order-progress { padding: 30rpx 0; }
.order-detail-page .progress-description { margin-top: 24rpx; text-align: center; color: var(--cr-color-text-secondary); font-size: 23rpx; line-height: 1.6; }
.order-detail-page .info-line { margin-top: 22rpx; font-size: 27rpx; }
.order-detail-page .delivery-card { display: flex; align-items: flex-start; gap: 14rpx; margin-top: 18rpx; color: var(--cr-color-text-secondary); }
.order-detail-page .delivery-copy { flex: 1; min-width: 0; }
.order-detail-page .delivery-label { font-size: 24rpx; line-height: 1.4; }
.order-detail-page .delivery-address { color: var(--cr-color-text); font-size: 27rpx; line-height: 1.6; margin-top: 8rpx; overflow-wrap: anywhere; }
.order-detail-page .amount-row { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; margin-top: 24rpx; font-size: 26rpx; }
.order-detail-page .order-amount { color: #ff6a3d; font-size: 32rpx; font-weight: 600; }
.order-detail-page .order-bottom-actions { display: flex; align-items: center; width: 100%; gap: 16rpx; }
.order-detail-page .order-contact-actions { display: flex; flex: none; gap: 12rpx; }
.order-detail-page .order-icon-button {
  margin: 0; min-width: 64rpx;
  --td-button-medium-height: 76rpx;
  --td-button-medium-padding-horizontal: 4rpx;
  --td-button-default-color: var(--cr-color-text-secondary);
  --td-button-font-weight: 400;
}
.order-detail-page .order-icon-content { display: flex; flex-direction: column; align-items: center; gap: 4rpx; font-size: 20rpx; line-height: 1.2; }
.order-detail-page .order-primary-actions { display: flex; flex: 1; min-width: 0; flex-wrap: wrap; justify-content: flex-end; gap: 12rpx; }
.order-detail-page .order-action-capsule { --td-button-small-height: 60rpx; --td-button-small-padding-horizontal: 24rpx; }
