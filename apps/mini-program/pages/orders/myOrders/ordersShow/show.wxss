@import "../../../../styles/second-hand-card.wxss";

page {
  background: var(--cr-color-background);
}

.my-orders {
  min-height: 100vh;
  overflow-x: hidden;
}

.my-orders__controls {
  position: fixed;
  top: 0;
  right: 0;
  left: 0;
  z-index: 10;
  background: var(--cr-color-surface);
}

.my-orders__nav {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-height: 44px;
  padding-left: 24rpx;
}

.my-orders__back {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 62rpx;
  height: 72rpx;
}

.my-orders__search {
  flex: 1;
  min-width: 0;
  --td-search-height: 70rpx;
  --td-search-padding: 0 20rpx;
  --td-search-font-size: 26rpx;
  --td-search-bg-color: var(--cr-color-background);
}

.my-orders__tabs {
  box-sizing: border-box;
  display: flex;
  width: 100%;
  height: 84rpx;
  padding: 0 8rpx;
  border-bottom: 1rpx solid var(--cr-color-border);
}

.my-orders__tab {
  position: relative;
  box-sizing: border-box;
  display: flex;
  flex: 1;
  min-width: 0;
  height: 83rpx;
  align-items: center;
  justify-content: center;
  color: var(--cr-color-text-secondary);
  font-size: 23rpx;
  white-space: nowrap;
}

.my-orders__tab--active {
  color: var(--cr-color-primary);
  font-weight: 700;
}

.my-orders__tab--active::after {
  position: absolute;
  right: 35%;
  bottom: 0;
  left: 35%;
  height: 5rpx;
  border-radius: 5rpx;
  background: var(--cr-color-primary);
  content: '';
}

.my-orders__list {
  margin: 24rpx var(--cr-page-padding) 48rpx;
  overflow: hidden;
  border-radius: var(--cr-radius-large);
  background: var(--cr-color-surface);
  box-shadow: var(--cr-shadow-card);
}

.my-orders__item {
  padding: 28rpx 26rpx 30rpx;
}

.my-orders__item--separated {
  border-top: 1rpx solid var(--cr-color-border);
}

.my-orders__item-top,
.my-orders__item-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
}

.my-orders__item-top {
  margin-bottom: 28rpx;
}

.my-orders__type,
.my-orders__status {
  flex: none;
  padding: 7rpx 14rpx;
  border-radius: var(--cr-radius-small);
  font-size: 24rpx;
  line-height: 1.3;
}

.my-orders__type {
  color: var(--cr-color-primary);
  background: var(--cr-color-primary-light);
}

.my-orders__type--purchase,
.my-orders__status--pending {
  color: #dc612c;
  background: #fff2e9;
}

.my-orders__status--active {
  color: var(--cr-color-primary);
  background: var(--cr-color-primary-light);
}

.my-orders__status--done {
  color: var(--cr-color-success);
  background: #e6f8ee;
}

.my-orders__status--neutral {
  color: var(--cr-color-text-secondary);
  background: var(--cr-color-background);
}

.my-orders__status--warning {
  color: var(--cr-color-danger);
  background: #fff1f0;
}

.my-orders__status {
  margin-left: auto;
}

.my-orders__main {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-width: 0;
}

.my-orders__cover {
  flex: none;
  width: 124rpx;
  height: 124rpx;
  overflow: hidden;
  border-radius: var(--cr-radius-medium);
  --td-image-round-radius: var(--cr-radius-medium);
}

.my-orders__title {
  display: block;
  min-width: 0;
  flex: 1;
  overflow: hidden;
  color: var(--cr-color-text);
  font-size: 29rpx;
  font-weight: 700;
  line-height: 1.4;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.my-orders__amount {
  flex: 0 0 160rpx;
  width: 160rpx;
  margin-left: auto;
  color: #e7552d;
  font-size: 30rpx;
  font-weight: 700;
  text-align: right;
  white-space: nowrap;
}

.my-orders__item-bottom {
  margin-top: 32rpx;
}

.my-orders__more {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 68rpx;
  height: 56rpx;
}

.my-orders__action {
  flex: none;
  margin-left: auto;
}

.my-orders__action--active.my-orders__action--purchase {
  --td-button-light-color: #d9682f;
  --td-button-light-bg-color: #fff2e9;
  --td-button-light-border-color: #fff2e9;
}

.my-orders__action--neutral {
  --td-button-default-color: var(--cr-color-text-secondary);
  --td-button-default-border-color: var(--cr-color-border);
}

.my-orders__sheet {
  padding: 24rpx 32rpx 16rpx;
}

.my-orders__sheet-separator {
  height: 1rpx;
  margin: 12rpx 0;
  background: var(--cr-color-border);
}

.my-orders__edit-sheet {
  padding: 32rpx;
}

.my-orders__edit-label {
  margin: 18rpx 0;
  color: var(--cr-color-text-secondary);
  font-size: 24rpx;
}

.my-orders__edit-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 28rpx;
}

.my-orders__sheet-title {
  margin-bottom: 18rpx;
  color: var(--cr-color-text);
  font-size: 30rpx;
  font-weight: 700;
  text-align: center;
}

.my-orders__feedback {
  display: flex;
  justify-content: center;
  padding: 90rpx 0;
}
