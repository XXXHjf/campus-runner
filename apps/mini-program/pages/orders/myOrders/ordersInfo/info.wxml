<!-- 空白填充 -->
<view class="bottom-spacer"></view>

<!-- 取消订单按钮弹出层，用于选择取消原因 -->
<t-popup visible="{{visible}}" bind:visible-change="onVisibleChange" placement="bottom">
  <view class="block">
    <view class="header">
      <view class="btn btn--cancel" aria-role="button" bind:tap="cancel" block>取消</view>
      <view class="title">取消原因</view>
      <view class="btn btn--confirm" aria-role="button" bind:tap="confirm" block>确定</view>
    </view>
    <view class="body">
      <t-radio-group bind:change="onChange" value="{{current}}" borderless style="margin-left: 20rpx;">
        <t-radio value="0" label="自食其力，暂不需要" />
        <t-radio value="1" label="信息有误，重新下单" />
        <t-radio value="2" label="不知道为什么，但是不用了" />
        <t-radio class="radio" value="3">其他
          <t-input class="input" placeholder="{{note || '请输入文字(选填)'}}" bind:change="handleInput" confirm-type="done" borderless />
        </t-radio>
      </t-radio-group>
    </view>
  </view>
</t-popup>

<!-- 删除订单的对话框弹出层 -->
<t-dialog
  visible="{{dltDialogVisable}}"
  title="删除订单"
  content="订单删除后无法找回或售后"
  confirm-btn="继续删除"
  cancel-btn="取消"
  bind:confirm="continueDlt"
  bind:cancel="closeDialog"
  close-on-overlay-click="true"
/>

<!-- 刷新轻提示 -->
<t-toast id="t-toast" />
<t-toast id="t-toast" />
