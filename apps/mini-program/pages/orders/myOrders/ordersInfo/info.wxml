<ui-page compact style="--cr-page-padding: 0;">
  <ui-empty-state wx:if="{{feedbackLoadError}}" title="{{feedbackLoadError}}" action-text="重试" bind:action="retryFeedbackLoad" />
  <view wx:if="{{!feedbackLoadError && orderInfo.id}}" class="runner-detail-page publisher-detail-page">
    <view class="runner-detail-sender">
      <t-avatar image="{{orderInfo.senderAvatar || ''}}" icon="user" shape="circle" size="72rpx" />
      <text class="runner-detail-sender-name">{{orderInfo.username || '同学'}}</text>
    </view>
    <ui-section plain class="publisher-detail-sheet" style="--cr-radius-medium: 36rpx; --cr-section-gap: 0;">
      <view class="runner-detail-main">
        <view class="runner-detail-primary">
          <text wx:if="{{orderInfo.price != null}}" class="runner-detail-price">¥{{orderInfo.price}}</text>
          <text wx:else class="runner-detail-free">无偿跑腿</text>
          <t-tag wx:if="{{orderInfo.categoryName}}" size="small" variant="light">{{orderInfo.categoryName}}</t-tag>
        </view>
        <view class="runner-detail-tags"><t-tag size="small" variant="light">{{orderStatusText}}</t-tag></view>
        <view class="runner-detail-description">{{orderInfo.note || '暂无说明'}}</view>
        <view class="runner-detail-muted">预计送达：{{orderInfo.expectTime}}</view>

        <view wx:if="{{orderInfo.price != null}}" class="publisher-detail-payment">
          <view wx:if="{{orderInfo.businessType === 'PURCHASE'}}" class="runner-detail-money-row"><text>商品金额</text><text>¥{{orderInfo.productAmount}}</text></view>
          <view class="publisher-detail-payment-row">
            <text>{{orderInfo.businessType === 'PURCHASE' ? '预计实付' : '实付金额'}}</text>
            <text class="publisher-detail-payment-amount">¥{{orderInfo.pay_amount != null ? orderInfo.pay_amount : orderInfo.price}}</text>
            <view class="publisher-detail-payment-info" aria-role="button" aria-label="查看实付金额说明" bind:tap="togglePaymentFeeHint"><t-icon name="info-circle" size="30rpx" color="#8b94a1" /></view>
          </view>
          <view wx:if="{{showPaymentFeeHint}}" class="runner-detail-muted">实付金额已包含本单服务费。</view>
          <view wx:if="{{orderInfo.businessType === 'PURCHASE'}}" class="runner-detail-money-row"><text>接单人完成后收款</text><text>¥{{orderInfo.runnerReceivable}}</text></view>
        </view>

        <view wx:if="{{orderInfo.status >= 0 && orderInfo.status <= 3 || orderInfo.status == 5 || orderInfo.status == 6 || orderInfo.status == 7}}" class="runner-detail-section runner-detail-progress">
          <view class="runner-detail-section-title">订单进度</view>
          <t-steps theme="dot" readonly current="{{progressStep}}"><t-step-item wx:for="{{title}}" wx:key="index" title="{{item}}" /></t-steps>
          <view wx:if="{{orderInfo.status == 1 || orderInfo.status == 2}}" class="runner-detail-countdown">
            <text>距离预期送达</text><text wx:if="{{time < 0}}" class="runner-detail-overdue">已超时</text>
            <t-count-down wx:else time="{{time}}" format="HH:mm:ss" theme="round" size="small" />
          </view>
        </view>
        <view wx:if="{{orderInfo.status == -1}}" class="publisher-detail-notice">
          <view class="runner-detail-countdown"><text>支付剩余时间</text><t-count-down time="{{unpaidRemainTime}}" format="mm:ss" theme="round" size="small" /></view>
          <view class="runner-detail-muted">超时未支付将自动删除订单</view>
        </view>
        <view wx:if="{{orderInfo.status == -2}}" class="publisher-detail-notice">退款处理中，请稍后查看退款结果。</view>
        <view wx:if="{{orderInfo.status == -4}}" class="publisher-detail-notice">退款未成功，请反馈异常。</view>

        <view class="runner-detail-section">
          <view class="runner-detail-section-title">{{orderInfo.businessType === 'PURCHASE' ? '购买与送达地点' : '取送地点'}}</view>
          <view class="runner-detail-address">
            <view class="runner-detail-address-dot runner-detail-address-dot--pickup"></view>
            <view class="runner-detail-address-content">
              <view class="runner-detail-address-label">{{orderInfo.businessType === 'PURCHASE' ? '购买地点' : '取件地址'}}</view>
              <view class="runner-detail-address-main">{{pickUpAddress[0]}} {{pickUpAddress[1]}} {{pickUpAddress[2]}}</view>
              <view wx:if="{{pickUpAddress[3]}}" class="runner-detail-muted">{{pickUpAddress[3]}}</view>
            </view>
          </view>
          <view class="runner-detail-address">
            <view class="runner-detail-address-dot runner-detail-address-dot--delivery"></view>
            <view class="runner-detail-address-content">
              <view class="runner-detail-address-label">{{orderInfo.businessType === 'PURCHASE' ? '送达地点' : '收件地址'}}</view>
              <view class="runner-detail-address-main">{{reciveAddress[0]}} {{reciveAddress[1]}} {{reciveAddress[2]}}</view>
              <view wx:if="{{reciveAddress[3]}}" class="runner-detail-muted">{{reciveAddress[3]}}</view>
            </view>
          </view>
          <view wx:if="{{orderInfo.businessType !== 'PURCHASE'}}" class="runner-detail-door">{{door[orderInfo.doorAccess]}}</view>
        </view>
        <view wx:if="{{orderInfo.businessType === 'PURCHASE' && orderInfo.status >= 2 && orderInfo.status < 5}}" class="publisher-detail-notice">商品已购买，无法取消。如需协助，请联系平台。</view>
        <view wx:if="{{orderInfo.images && orderInfo.images.length}}" class="runner-detail-section">
          <view class="runner-detail-section-title">任务图片</view>
          <view class="runner-detail-images"><t-image wx:for="{{orderInfo.images}}" wx:key="*this" src="{{item}}" bind:tap="tapOnImageToPreview" data-src="{{item}}" mode="aspectFit" shape="round" class="runner-detail-image" /></view>
        </view>
        <view wx:if="{{taker.id && orderInfo.status > 0 && orderInfo.status != 4}}" class="runner-detail-section">
          <view class="runner-detail-section-title">联系接单人</view>
          <view class="runner-detail-contact-name">{{taker.username || '同学'}}</view>
          <view wx:if="{{taker.phone}}" class="runner-detail-contact-phone" bind:tap="tapOnPhoneToDo" data-phone="taker">{{taker.phone}}<t-icon name="chevron-right" size="28rpx" /></view>
        </view>
        <view wx:if="{{orderInfo.businessType === 'PURCHASE' && taker.purchaseProofImage}}" class="runner-detail-section">
          <view class="runner-detail-section-title">购买凭证</view>
          <t-image src="{{taker.purchaseProofImage}}" bind:tap="tapOnImageToPreview" data-src="{{taker.purchaseProofImage}}" mode="aspectFit" shape="round" class="runner-detail-image" />
        </view>
        <view wx:if="{{image}}" class="runner-detail-section">
          <view class="runner-detail-section-title">送达图片</view>
          <t-image src="{{image}}" bind:tap="tapOnImageToPreview" data-src="{{image}}" mode="aspectFit" shape="round" class="runner-detail-image" />
        </view>
        <view class="runner-detail-meta">
          <view class="runner-detail-section-title">订单信息</view>
          <view><text>发布时间</text><text>{{orderInfo.createTime}}</text></view>
          <view wx:if="{{taker.takeOrderTime}}"><text>接单时间</text><text>{{taker.takeOrderTime}}</text></view>
          <view wx:if="{{orderInfo.deliveryTime}}"><text>实际送达</text><text>{{orderInfo.deliveryTime}}</text></view>
          <view wx:if="{{orderInfo.cancelTime}}"><text>{{orderInfo.status == 4 || orderInfo.status == -4 || orderInfo.status == -2 || orderInfo.status == -3 ? '取消时间' : '自动取消'}}</text><text>{{orderInfo.cancelTime}}</text></view>
          <view wx:if="{{orderInfo.cancelReson && (orderInfo.status == 4 || orderInfo.status == -4 || orderInfo.status == -2 || orderInfo.status == -3)}}"><text>取消原因</text><text>{{orderInfo.cancelReson}}</text></view>
          <view><text>订单编号</text><text>{{orderInfo.orderNumber}}</text></view>
        </view>
      </view>
    </ui-section>
    <ui-action-bar wx:if="{{orderInfo.status != 5 && orderInfo.status != 6}}" class="runner-detail-action-bar" style="--cr-page-padding: 28rpx;" fixed>
      <view class="runner-detail-actions">
        <t-button wx:if="{{orderInfo.status == -1}}" class="runner-detail-action" t-class="cr-secondhand-capsule runner-detail-capsule" shape="round" theme="primary" bind:tap="payOrder">去支付</t-button>
        <t-button wx:else class="runner-detail-action" t-class="cr-secondhand-capsule runner-detail-capsule" shape="round" theme="{{theme}}" variant="{{orderInfo.status == 0 ? 'outline' : 'base'}}" disabled="{{buttonDisabled}}" bind:tap="button">{{buttonText}}</t-button>
      </view>
    </ui-action-bar>
  </view>
</ui-page>
<t-popup visible="{{visible}}" bind:visible-change="onVisibleChange" placement="bottom">
  <view class="publisher-detail-cancel">
    <view class="publisher-detail-cancel-header">
      <t-button theme="default" variant="text" bind:tap="cancel">取消</t-button>
      <view class="publisher-detail-cancel-title">取消原因</view>
      <t-button theme="primary" variant="text" bind:tap="confirm">确定</t-button>
    </view>
    <t-radio-group bind:change="onChange" value="{{current}}" borderless>
      <t-radio value="0" label="自食其力，暂不需要" />
      <t-radio value="1" label="信息有误，重新下单" />
      <t-radio value="2" label="不知道为什么，但是不用了" />
      <t-radio value="3">其他<t-input placeholder="请输入原因（选填）" value="{{note}}" bind:change="handleInput" confirm-type="done" borderless /></t-radio>
    </t-radio-group>
  </view>
</t-popup>
<ui-feedback id="ui-feedback" />
