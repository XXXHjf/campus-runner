@import "../../../../styles/runner-detail.wxss";

.publisher-detail-page .publisher-detail-sheet { flex: 1; }
.publisher-detail-page .runner-detail-main { box-sizing: border-box; min-height: calc(100vh - 112rpx); }
.publisher-detail-page .runner-detail-image { --td-image-round-radius: 20rpx; }
.publisher-detail-page .publisher-detail-payment {
  margin-top: 28rpx;
  padding: 20rpx 0;
  border-top: 1rpx solid var(--cr-color-border, #eef2ef);
  border-bottom: 1rpx solid var(--cr-color-border, #eef2ef);
}
.publisher-detail-page .publisher-detail-payment-row { display: flex; align-items: center; gap: 16rpx; font-size: 27rpx; color: var(--cr-color-text, #1d2129); }
.publisher-detail-page .publisher-detail-payment-amount { color: #ff6a3d; font-weight: 600; }
.publisher-detail-page .publisher-detail-payment-info { display: flex; align-items: center; padding: 8rpx; }
.publisher-detail-page .publisher-detail-notice { margin-top: 24rpx; padding: 20rpx; border-radius: 12rpx; background: #f6f7f8; color: var(--cr-color-text-secondary, #6b778c); font-size: 24rpx; line-height: 1.6; }
.publisher-detail-page .publisher-detail-notice .runner-detail-countdown { margin-top: 0; }
.publisher-detail-page .runner-detail-meta > .runner-detail-section-title { color: #17231d; font-size: 30rpx; padding: 0; }
.publisher-detail-cancel { padding: 12rpx 24rpx 24rpx; background: var(--cr-color-surface, #fff); border-radius: 24rpx 24rpx 0 0; }
.publisher-detail-cancel-header { display: flex; align-items: center; padding: 12rpx 0; }
.publisher-detail-cancel-title { flex: 1; text-align: center; font-size: 32rpx; font-weight: 600; color: var(--cr-color-text, #1d2129); }
