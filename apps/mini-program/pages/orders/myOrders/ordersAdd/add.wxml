<!-- 步骤栏 -->
<view class="step">
  <t-steps theme="dot" current="{{count - 1}}">
    <t-step-item wx:for="{{3}}" wx:key="index" title="{{title[index]}}">
      <t-icon name="chevron-right" size="22" color="rgba(0, 0, 0, .4)" slot="title-right" />
    </t-step-item>
  </t-steps>
</view>

<!-- 地址 -->
<view class="card" hidden="{{!(count==1)}}">
  <!-- 卡片名 -->
  <view style="display: flex; align-items: center;">
    <t-icon class="cardIcon" name="map" size="16" color="#0052d9" style="padding: 0 0 0 30rpx;" />
    <view class="cardName">取件与收件地址</view>
  </view>
  <!-- 分割线 -->
  <t-divider class="drvider" />
  <!-- 取件地址 -->
  <view class="box1" bind:tap="tapOnPickAddr">
    <view class="text-address">取件地址</view>
    <view>
      <view class="address" style="font-weight: 600; color: {{showPickUp?'black':'gray'}};">
        {{showPickUp.compusName || '点击选择取件地址'}} {{showPickUp.buildCategoryName}} {{showPickUp.buildingName}}
      </view>
      <view class="address" wx:if="{{showPickUp.details}}" style="color: {{showPickUp?'black':'gray'}};">{{showPickUp.details}}</view>
    </view>
  </view>
  <!-- 收件地址 -->
  <view class="box1" bind:tap="upRecive">

    <text class="text-address">收件地址</text>
    <view>
      <view class="address" style="font-weight: 600; color: {{showRecive?'black':'gray'}};">
        {{showRecive.compusName || '点击选择收件地址'}} {{showRecive.buildCategoryName}} {{showRecive.buildingName}}
      </view>
      <view class="address" wx:if="{{showRecive.details}}" style="color: {{showRecive?'black':'gray'}};">{{showRecive.details}}</view>
    </view>
  </view>

  <!-- 门禁情况 -->
  <view hidden="{{!(count==1)}}">
    <view class="door-container">
      <view class="door-left" bind:tap="handleChangeDoor">
        <view class="box1">
          <text class="text-address">配送过程有门禁</text>
        </view>
        <t-switch value="{{doorAccess==0?false:true}}" icon="{{['check', 'close']}}" size="small" slot="note" />
      </view>
      
      <!-- 醒目的帮助说明按钮 -->
      <view class="door-help-btn" bind:tap="ticonTapToExplain" catchtap="ticonTapToExplain">
        <view class="help-btn-content">
          <text class="help-btn-text">什么是门禁？</text>
          <!-- <t-icon name="help-circle" size="32rpx" color="#FFFFFF" class="help-icon-pulse" /> -->
        </view>
      </view>
    </view>
  </view>

  <!-- 联系方式 -->
  <view class="contact-contanier" bind:tap="upUser">
    <view class="contact-box">
      <view style="font-weight: 600;"> {{showUser || '暂无'}} </view>
    </view>
    <view class="contact-box" style="margin-left: 20rpx;">
      <view style="font-weight: 600;"> {{showPhone || '暂无'}} </view>
    </view>
    <view class="edit-box">
      <t-icon name="edit" bind:click="onIconTap" />
    </view>
  </view>
</view>

