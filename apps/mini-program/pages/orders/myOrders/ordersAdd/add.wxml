<ui-page safe-bottom>
  <view class="order-add-page">
    <view class="order-add-category" bind:tap="upCategory">
      <view class="order-add-category__heading">
        <t-icon name="send" size="36rpx" color="var(--cr-color-primary, #0052d9)" />
        <text class="order-add-category__label">跑腿类型</text>
      </view>
      <view class="order-add-category__value">
        <text class="{{showCategory.id ? '' : 'order-add-muted'}}">{{showCategory.categoryName || '请选择'}}</text>
        <t-icon name="chevron-right" size="36rpx" color="#8b94a1" />
      </view>
    </view>

    <ui-section title="{{isPurchase ? '购买与送达地点' : '取送地点'}}">
      <view class="order-add-section-body">
      <view class="order-add-route">
        <view class="order-add-route__rail"><view class="order-add-route__dot" /><view class="order-add-route__line" /><view class="order-add-route__dot order-add-route__dot--end" /></view>
        <view class="order-add-route__rows">
          <view class="order-add-row" bind:tap="tapOnPickAddr">
            <text class="order-add-row__label">{{isPurchase ? '购买地点' : '取件地点'}}</text>
            <view class="order-add-row__content">
              <text wx:if="{{showPickUp}}">{{showPickUp.compusName}} {{showPickUp.buildCategoryName}} {{showPickUp.buildingName}} {{showPickUp.details}}</text>
              <text wx:else class="order-add-muted">请选择地点</text>
            </view>
            <t-icon name="chevron-right" size="34rpx" color="#8b94a1" />
          </view>
          <view class="order-add-row" bind:tap="upRecive">
            <text class="order-add-row__label">送达地点</text>
            <view class="order-add-row__content">
              <text wx:if="{{showRecive}}">{{showRecive.compusName}} {{showRecive.buildCategoryName}} {{showRecive.buildingName}} {{showRecive.details}}</text>
              <text wx:else class="order-add-muted">请选择地点</text>
            </view>
            <t-icon name="chevron-right" size="34rpx" color="#8b94a1" />
          </view>
        </view>
      </view>
      <view wx:if="{{!isPurchase}}" class="order-add-door">
        <text>取送地点有门禁</text>
        <view class="order-add-door__control">
          <t-icon name="help-circle" size="30rpx" color="#8b94a1" bind:tap="ticonTapToExplain" />
          <t-switch value="{{doorAccess == 1}}" size="small" bind:change="onDoorChange" />
        </view>
      </view>
      </view>
    </ui-section>

    <ui-section title="{{isPurchase ? '购买清单' : '需要帮忙做什么'}}">
      <view class="order-add-section-body">
      <view class="order-add-content">
        <t-textarea value="{{note}}" placeholder="{{isPurchase ? '写清商品、规格、数量和购买要求' : '写清物品和注意事项'}}" maxlength="100" indicator bordered disableDefaultPadding="{{true}}" bind:change="onNoteInput" />
        <view class="order-add-content__image-title">{{isPurchase ? '商品参考图片' : '需求图片'}} <text class="order-add-required">（必传）</text></view>
        <t-upload mediaType="{{['image']}}" max="{{9}}" files="{{fileList}}" bind:add="handleAdd" bind:remove="handleRemove" />
        <text class="order-add-hint">至少上传 1 张，最多 9 张</text>
      </view>
      </view>
    </ui-section>

    <ui-section title="希望送达">
      <view class="order-add-section-body">
      <view class="order-add-row" bind:tap="tapOnReachTime">
        <text class="order-add-row__label">预期送达</text>
        <view class="order-add-row__content order-add-row__content--right">{{showReachTime || '选择时间'}}</view>
        <t-icon name="chevron-right" size="34rpx" color="#8b94a1" />
      </view>
      <text class="order-add-hint">实际送达时间可能随接单情况变化</text>
      </view>
    </ui-section>

    <ui-section title="{{isPurchase ? '代买费用' : '报酬设置'}}">
      <view class="order-add-section-body">
      <view wx:if="{{!isPurchase}}" class="order-add-modes">
        <view class="order-add-mode" bind:tap="selectPaid">
          <t-radio value="paid" label="提供报酬" content="接单同学完成后获得报酬" checked="{{priceAccess == 1}}" block="{{false}}" borderless bind:change="selectPaid" style="--td-radio-icon-size: 36rpx; --td-radio-label-line-height: 42rpx; --td-radio-font-size: 29rpx; --td-radio-content-font-size: 24rpx; --td-radio-content-line-height: 36rpx;" />
        </view>
        <view wx:if="{{priceAccess == 1}}" class="order-add-mode__amount">
          <text>跑腿报酬</text>
          <view class="order-add-mode__input"><t-input value="{{price}}" placeholder="输入金额" type="digit" align="right" borderless style="--td-input-bg-color: transparent; --td-input-vertical-padding: 0;" bind:change="onPriceInput" /></view>
          <text>元</text>
        </view>
        <view class="order-add-mode" bind:tap="selectFree">
          <t-radio value="free" label="无偿求助" content="不支付跑腿报酬" checked="{{priceAccess == 0}}" block="{{false}}" borderless bind:change="selectFree" style="--td-radio-icon-size: 36rpx; --td-radio-label-line-height: 42rpx; --td-radio-font-size: 29rpx; --td-radio-content-font-size: 24rpx; --td-radio-content-line-height: 36rpx;" />
        </view>
      </view>
      <view wx:if="{{isPurchase}}" class="order-add-row">
        <text class="order-add-row__label">商品金额</text>
        <t-input t-class="order-add-money-input" value="{{productAmount}}" placeholder="输入金额" type="digit" align="right" borderless bind:change="onProductAmountInput" />
        <text class="order-add-unit">元</text>
      </view>
      <text wx:if="{{productAmountError}}" class="order-add-error">请输入大于 0 且最多两位小数的商品金额</text>
      <view wx:if="{{isPurchase}}" class="order-add-row">
        <text class="order-add-row__label">跑腿报酬</text>
        <t-input t-class="order-add-money-input" value="{{price}}" placeholder="输入金额" type="digit" align="right" borderless bind:change="onPriceInput" />
        <text class="order-add-unit">元</text>
      </view>
      <text wx:if="{{priceAccess == 1 && priceError}}" class="order-add-error">请输入大于 0 且最多两位小数的跑腿报酬</text>
      <view wx:if="{{priceAccess == 1}}" class="order-add-fee">
        <view class="order-add-fee__line order-add-fee__line--total">
          <view class="order-add-review__total-label"><text>预计实付</text><view class="order-add-review__info" aria-role="button" aria-label="查看实付金额说明" bind:tap="toggleFormFeeHint"><t-icon name="info-circle" size="30rpx" color="#8b94a1" /></view></view>
          <text>{{payAmount === null ? '计算中' : '¥' + payAmount}}</text>
        </view>
        <view wx:if="{{showFormFeeHint}}" class="order-add-review__fee-hint">实付金额已包含本单服务费。</view>
      </view>
      <text wx:if="{{isPurchase}}" class="order-add-hint">请先与接单同学确认商品价格</text>
      </view>
    </ui-section>

    <ui-section title="联系方式">
      <view class="order-add-section-body">
      <view class="order-add-row" bind:tap="upUser">
        <text class="order-add-row__label">联系人</text>
        <view class="order-add-row__content order-add-row__content--right">{{showUser || '请填写'}} · {{maskedShowPhone || '手机号'}}</view>
        <t-icon name="chevron-right" size="34rpx" color="#8b94a1" />
      </view>
      </view>
    </ui-section>
  </view>

  <ui-action-bar fixed>
    <t-button block theme="primary" bind:tap="order">下一步 · 核对订单</t-button>
  </ui-action-bar>
</ui-page>

<t-popup visible="{{showOrderConfirm}}" placement="bottom" bind:visible-change="onOrderConfirmVisibleChange">
  <view class="order-add-review">
    <view class="order-add-review__title">核对订单</view>
    <scroll-view scroll-y class="order-add-review__body">
      <view class="order-add-review__row"><text>跑腿类型</text><text>{{showCategory.categoryName}}</text></view>
      <view class="order-add-review__row"><text>{{isPurchase ? '购买地点' : '取件地点'}}</text><text>{{showPickUp.compusName}} {{showPickUp.buildCategoryName}} {{showPickUp.buildingName}} {{showPickUp.details}}</text></view>
      <view class="order-add-review__row"><text>送达地点</text><text>{{showRecive.compusName}} {{showRecive.buildCategoryName}} {{showRecive.buildingName}} {{showRecive.details}}</text></view>
      <view class="order-add-review__row"><text>预期送达</text><text>{{showReachTime}}</text></view>
      <view class="order-add-review__row"><text>联系人</text><text>{{showUser}} · {{maskedShowPhone}}</text></view>
      <view wx:if="{{doorAccess == 1 && !isPurchase}}" class="order-add-review__row"><text>门禁</text><text>有门禁</text></view>
      <view wx:if="{{isPurchase}}" class="order-add-review__row"><text>商品金额</text><text>¥{{productAmount}}</text></view>
      <view class="order-add-review__row"><text>跑腿报酬</text><text>{{priceAccess == 1 ? '¥' + price : '无偿求助'}}</text></view>
      <view class="order-add-review__row order-add-review__row--total">
        <view class="order-add-review__total-label">
          <text>{{priceAccess == 1 ? '实付金额' : '无需支付'}}</text>
          <view wx:if="{{priceAccess == 1}}" class="order-add-review__info" aria-role="button" aria-label="查看实付金额说明" bind:tap="toggleReviewFeeHint"><t-icon name="info-circle" size="30rpx" color="#8b94a1" /></view>
        </view>
        <text wx:if="{{priceAccess == 1}}">¥{{payAmount}}</text>
      </view>
      <view wx:if="{{priceAccess == 1 && showReviewFeeHint}}" class="order-add-review__fee-hint">实付金额已包含本单服务费。</view>
    </scroll-view>
    <view class="order-add-review__actions">
      <view class="order-add-review__action"><t-button block theme="default" variant="outline" disabled="{{isSubmitting}}" bind:tap="cancelOrder">返回修改</t-button></view>
      <view class="order-add-review__action"><t-button block theme="primary" loading="{{isSubmitting}}" disabled="{{isSubmitting}}" bind:tap="confirmOrder">{{priceAccess == 1 ? '确认并支付' : '确认发布'}}</t-button></view>
    </view>
  </view>
</t-popup>
<!-- 取件地址修改弹出层 -->
<t-popup visible="{{visiblePickUp}}" bind:visible-change="onVisibleChangePickUp" placement="bottom" close-on-overlay-click="true">
  <view class="block">
    <!-- 顶栏 -->
    <view class="header">
      <view class="btn btn--cancel" aria-role="button" bind:tap="cancelAndConfirmPickUp">取消</view>
      <view class="title">{{isPurchase ? '购买地点修改' : '取件地址修改'}}</view>
      <view class="btn btn--confirm" aria-role="button" bind:tap="cancelAndConfirmPickUp">确定</view>
    </view>
    <!-- 滑动区域 -->
    <scroll-view class="body" style="height: 600rpx; overflow-y: scroll; padding-bottom: 20rpx;" scroll-y="true">
      <block wx:for="{{addrList}}" wx:key="id">
        <view class="show-cart">
          <view class="address-item-container">
            <!-- 左侧：单选框 -->
            <view class="address-item-radio" bindtap="onChangePickUp" data-item="{{item}}">
              <t-radio value="id" borderless="true" checked="{{item.id==showPickUp.id?true:false}}" />
            </view>
            
            <!-- 中间：地址信息 -->
            <view class="address-item-content" bindtap="onChangePickUp" data-item="{{item}}">
              <view class="address-item-row">
                <!-- 标签 -->
                <text class="popup-tag-compact">{{item.isDefault==1?'默认· ':''}}{{item.label || '常用'}}</text>
                <!-- 地址（校区 类型 楼宇 详细地址） -->
                <text class="address-text-inline">{{item.compusName}}{{item.buildCategoryName ? ' ' + item.buildCategoryName : ''}}{{item.buildingName ? ' ' + item.buildingName : ''}}{{item.details ? ' ' + item.details : ''}}</text>
              </view>
            </view>
            
            <!-- 右侧：编辑按钮 -->
            <view class="address-item-edit" bindtap="editAddress" data-id="{{item.id}}" catchtap="editAddress">
              <t-icon name="edit" size="40rpx" color="#999999" />
            </view>
          </view>
        </view>
      </block>
    </scroll-view>
  </view>
  <view class="button">
    <t-button block size="large" bind:tap="button0" theme="primary" variant="outline">添加新地址</t-button>
  </view>
</t-popup>
<!-- 收件地址弹出层 -->
<t-popup visible="{{visibleRecive}}" bind:visible-change="onVisibleChangeRecive" placement="bottom">
  <view class="block">
    <!-- 顶栏 -->
    <view class="header">
      <view class="btn btn--cancel" aria-role="button" bind:tap="cancelAndConfirmRecive">取消</view>
      <view class="title">{{isPurchase ? '送达地点修改' : '收件地址修改'}}</view>
      <view class="btn btn--confirm" aria-role="button" bind:tap="cancelAndConfirmRecive">确定</view>
    </view>
    <!-- 滑动区 -->
    <scroll-view class="body" style="height: 600rpx; overflow-y: scroll; padding-bottom: 20rpx;" scroll-y="true">
      <block wx:for="{{addrList}}" wx:key="id">
        <view class="show-cart">
          <view class="address-item-container">
            <!-- 左侧：单选框 -->
            <view class="address-item-radio" bindtap="onChangeRecive" data-item="{{item}}">
              <t-radio value="id" borderless="true" checked="{{item.id==showRecive.id?true:false}}" />
            </view>
            
            <!-- 中间：地址信息 -->
            <view class="address-item-content" bindtap="onChangeRecive" data-item="{{item}}">
              <view class="address-item-row">
                <!-- 标签 -->
                <text class="popup-tag-compact">{{item.isDefault==1?'默认· ':''}}{{item.label || '常用'}}</text>
                <!-- 地址（校区 类型 楼宇 详细地址） -->
                <text class="address-text-inline">{{item.compusName}}{{item.buildCategoryName ? ' ' + item.buildCategoryName : ''}}{{item.buildingName ? ' ' + item.buildingName : ''}}{{item.details ? ' ' + item.details : ''}}</text>
              </view>
            </view>
            
            <!-- 右侧：编辑按钮 -->
            <view class="address-item-edit" bindtap="editAddress" data-id="{{item.id}}" catchtap="editAddress">
              <t-icon name="edit" size="40rpx" color="#999999" />
            </view>
          </view>
        </view>
      </block>
    </scroll-view>
  </view>
  <view class="button">
    <t-button block size="large" bind:tap="button1" theme="primary" variant="outline">添加新地址</t-button>
  </view>
</t-popup>

<!-- 联系方式编辑 -->
<t-popup visible="{{visibleUser}}" bind:visible-change="onVisibleChangeUser" placement="bottom">
  <view class="order-add-contact-editor">
    <view class="order-add-contact-editor__header">
      <text>联系方式</text>
      <t-icon name="close" size="36rpx" color="#6b778c" bind:tap="closeContactEditor" />
    </view>
    <view class="order-add-contact-editor__description">用于接单同学联系你</view>
    <view class="order-add-contact-editor__label">联系人</view>
    <view class="order-add-contact-editor__field"><t-input value="{{contactNameDraft}}" placeholder="请输入联系人" maxlength="50" confirm-type="next" borderless style="--td-input-bg-color: transparent; --td-input-vertical-padding: 0;" bind:change="tiptChangeShowuser" /></view>
    <view class="order-add-contact-editor__label">手机号</view>
    <view class="order-add-contact-editor__field"><t-input value="{{contactPhoneDraft}}" placeholder="请输入手机号" type="number" maxlength="11" borderless style="--td-input-bg-color: transparent; --td-input-vertical-padding: 0;" bind:change="tiptChangePhone" /></view>
    <view class="order-add-contact-editor__save"><t-button block theme="primary" bind:tap="saveContact">保存</t-button></view>
  </view>
</t-popup>
<!-- 跑腿类型选择 -->
<t-popup visible="{{visibleCategory}}" bind:visible-change="onVisibleChangeCategory" placement="bottom">
  <view class="order-add-category-picker">
    <view class="order-add-category-picker__header">
      <text>选择跑腿类型</text>
      <t-icon name="close" size="36rpx" color="#6b778c" bind:tap="cancelAndConfirmCategory" />
    </view>
    <scroll-view scroll-y class="order-add-category-picker__list">
      <view wx:if="{{!category.length}}" class="order-add-category-picker__empty">暂无可选类型</view>
      <view wx:for="{{category}}" wx:key="id" class="order-add-category-picker__option" bind:tap="onChangeCategory" data-item="{{item}}">
        <t-image wx:if="{{item.image}}" src="{{item.image}}" width="48rpx" height="48rpx" />
        <text class="order-add-category-picker__name">{{item.categoryName}}</text>
        <t-radio value="{{item.id}}" checked="{{item.id == showCategory.id}}" borderless />
      </view>
    </scroll-view>
  </view>
</t-popup>
<!-- 预期送达时间弹出层 -->
<t-popup visible="{{isReachTimeVisiable}}" close-on-overlay-click="true" placement="bottom" style="height: 1000rpx;">
  <view class="header">
    <view class="title">选择送达时间</view>
  </view>
  <view class="time-container">
    <!-- 选项卡：今日/明日 -->
    <view class="reach-tabs">
      <view wx:if="{{todayTimes.length > 0}}" class="reach-tab {{activeTab === 'today' ? 'active' : ''}}" bindtap="switchTab" data-tab="today">今日（{{todayLabel}}）</view>
      <view class="reach-tab {{activeTab === 'tomorrow' ? 'active' : ''}}" bindtap="switchTab" data-tab="tomorrow">明日（{{tomorrowLabel}}）</view>
    </view>
    <!-- 时间列表 -->
    <scroll-view scroll-y="true" class="time-list">
      <block wx:if="{{activeTab === 'today'}}">
        <view wx:for="{{todayTimes}}" wx:key="index" class="time-item {{selectedTime === item.time ? 'selected' : ''}} {{item.isRecommended ? 'time-item-recommended' : ''}}" bindtap="selectTime" data-time="{{item}}">
          <view class="time-row">
            <view class="time-text">{{item.displayTime}}</view>
            <text wx:if="{{item.recommendLabel}}" class="recommend-label">{{item.recommendLabel}}</text>
          </view>
        </view>
      </block>

      <block wx:if="{{activeTab === 'tomorrow'}}">
        <view wx:for="{{tomorrowTimes}}" wx:key="index" class="time-item {{selectedTime === item.time ? 'selected' : ''}} {{item.isRecommended ? 'time-item-recommended' : ''}}" bindtap="selectTime" data-time="{{item}}">
          <view class="time-row">
            <view class="time-text">{{item.displayTime}}</view>
            <text wx:if="{{item.recommendLabel}}" class="recommend-label">{{item.recommendLabel}}</text>
          </view>
        </view>
      </block>
    </scroll-view>
  </view>
</t-popup>

<!-- 轻提示根显示 -->
<ui-feedback id="ui-feedback" />
