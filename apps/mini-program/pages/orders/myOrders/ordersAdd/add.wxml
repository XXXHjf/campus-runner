<!-- 用户信息修改弹出层 -->
<t-popup visible="{{visibleUser}}" bind:visible-change="onVisibleChangeUser" placement="bottom">
  <view class="block">
    <view class="header">
      <view class="btn btn--cancel" aria-role="button" bind:tap="cancelAndConfirmUser">取消</view>
      <view class="title">个人信息修改</view>
      <view class="btn btn--confirm" aria-role="button" bind:tap="cancelAndConfirmUser">确定</view>
    </view>
    <view class="user-info-body">
      <!-- 下单昵称 -->
      <view class="user-info-item">
        <view class="user-info-label">
          <t-icon name="user" size="32rpx" color="#0052d9" class="label-icon-td" />
          <text class="label-text">下单昵称</text>
        </view>
        <view class="user-info-input-wrapper">
          <t-input 
            class="user-info-input" 
            value="{{showUser}}"
            placeholder="请输入昵称" 
            bind:change="tiptChangeShowuser" 
            maxlength="50" 
            confirm-type="next"
            clearable="{{true}}">
          </t-input>
        </view>
        <view class="user-info-tip">用于接单展示</view>
      </view>
      
      <!-- 联系方式 -->
      <view class="user-info-item">
        <view class="user-info-label">
          <t-icon name="mobile" size="32rpx" color="#0052d9" class="label-icon-td" />
          <text class="label-text">联系方式</text>
        </view>
        <view class="user-info-input-wrapper">
          <t-input 
            class="user-info-input" 
            value="{{showPhone}}"
            placeholder="请输入手机号" 
            bind:change="tiptChangePhone" 
            type="number"
            maxlength="11"
            clearable="{{true}}">
          </t-input>
        </view>
        <view class="user-info-tip">用于骑手联系您</view>
      </view>
    </view>
  </view>
</t-popup>
<!--跑腿类型修改弹出层 -->
<t-popup visible="{{visibleCategory}}" bind:visible-change="onVisibleChangeCategory" placement="bottom">

  <view class="block">
    <view class="header">
      <view class="btn btn--cancel" aria-role="button" bind:tap="cancelAndConfirmCategory">取消</view>
      <view class="title">跑腿类型选择</view>
      <view class="btn btn--confirm" aria-role="button" bind:tap="cancelAndConfirmCategory">确定</view>
    </view>
    <view class="body" style="height: auto; overflow-y: auto;">
      <block wx:for="{{category}}" wx:key="id">
        <view class="show-cart" style="padding: 30rpx;margin:30rpx 40rpx;" bindtap="onChangeCategory" data-item="{{item}}">
          <view class="box1" style="margin: 4rpx 20rpx;">
            <t-image class="categoryImage" src="{{item.image}}" loading="slot" error="slot" mode="widthFix" shape="square" style="width:60rpx;height:60rpx;" />
            <view class="categoryName" style="font-weight: bold;flex-grow: 1; ">{{item.categoryName}}</view>
            <t-radio value="{{item.id}}" placement="right" style="margin-left: auto; " checked="{{item.id==showCategory.id?true:false}}" />
          </view>
        </view>
      </block>
    </view>
  </view>
</t-popup>
<!-- 预期送达时间弹出层 -->
<t-popup visible="{{isReachTimeVisiable}}" close-on-overlay-click="true" placement="bottom" style="height: 1000rpx;">
  <view class="header">
    <view class="title">选择送达时间</view>
  </view>
  <view class="time-container">
    <!-- 选项卡：今日/明日 -->
    <view class="reach-tabs">
      <view wx:if="{{todayTimes.length > 0}}" class="reach-tab {{activeTab === 'today' ? 'active' : ''}}" bindtap="switchTab" data-tab="today">今日（{{todayLabel}}）</view>
      <view class="reach-tab {{activeTab === 'tomorrow' ? 'active' : ''}}" bindtap="switchTab" data-tab="tomorrow">明日（{{tomorrowLabel}}）</view>
    </view>
    <!-- 时间列表 -->
    <scroll-view 	scroll-y="false" class="time-list">
      <block wx:if="{{activeTab === 'today'}}">
        <view wx:for="{{todayTimes}}" wx:key="index" class="time-item {{selectedTime === item.time ? 'selected' : ''}} {{item.isRecommended ? 'time-item-recommended' : ''}}" bindtap="selectTime" data-time="{{item}}">
          <view class="time-row">
            <view class="time-text">{{item.displayTime}}</view>
            <text wx:if="{{item.recommendLabel}}" class="recommend-label">{{item.recommendLabel}}</text>
          </view>
        </view>
      </block>

      <block wx:if="{{activeTab === 'tomorrow'}}">
        <view wx:for="{{tomorrowTimes}}" wx:key="index" class="time-item {{selectedTime === item.time ? 'selected' : ''}} {{item.isRecommended ? 'time-item-recommended' : ''}}" bindtap="selectTime" data-time="{{item}}">
          <view class="time-row">
            <view class="time-text">{{item.displayTime}}</view>
            <text wx:if="{{item.recommendLabel}}" class="recommend-label">{{item.recommendLabel}}</text>
          </view>
        </view>
      </block>
    </scroll-view>
  </view>
</t-popup>

<!-- 轻提示根显示 -->
<t-toast id="t-toast" />
