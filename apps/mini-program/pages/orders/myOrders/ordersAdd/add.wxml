<!-- 付费信息 -->
<view class="card" hidden="{{!(count==3)}}">
  <!-- 卡片名 -->
  <view style="display: flex; align-items: center;">
    <t-icon class="cardIcon" name="user-vip" size="16" color="#0052d9" style="padding: 0 0 0 30rpx;" />
    <view class="cardName">跑腿付费</view>
  </view>
  <!-- 分割线 -->
  <t-divider class="drvider" />
  <!-- 付费信息  -->
  <view>
    <view class="box1">
      <text class="text-address">是否选择有偿</text>
      <view wx:if="{{!(priceAccess==0)}}" class="address">
        <t-input class="input custom-input" placeholder="{{price}}" suffix="元" align="left" type="digit" bindchange="onPriceInput" borderless style="padding: 0 !important;" />
      </view>
      <view class="address" style="font-weight: 600;text-align: right;" />
      <t-switch value="{{priceAccess==0?false:true}}" icon="{{['check', 'close']}}" size="small" slot="note" style="margin-right: 42rpx;" bind:tap="handleChangePrice" />
    </view>
    <view hidden="{{(priceError==0)}}" class="address" style="text-align: end;margin-top: 4rpx;color: #ed7b2f;"> 请输入正确的价格（单位：元）。 </view>
    <view hidden="{{(priceAccess==0)}}" class="address" style="margin-top: 10rpx;color: #ed5126;"> 发布价格为骑手可得金额。 </view>
    <view hidden="{{(priceAccess==0)}}" class="address" style="margin-top: 6rpx;color:#0052d9;font-weight:600;">预计实付金额：¥{{payAmount || 0}}</view>
  </view>
</view>

<!-- 按钮 -->
<view class="button" style="background-color: #F5F5F5;border-radius: 20rpx;">
  <view class="button-row">
    <view class="button-item">
      <t-button block variant="outline" theme="default" disabled="{{count==1}}" bind:tap="toPrev">上一步</t-button>
    </view>
    <view class="button-item">
      <t-button block variant="{{variant}}" theme="{{theme}}" open-type="agreePrivacyAuthorization" bind:tap="{{count==3?'order':'toNext'}}"> {{count==3?'发布跑腿':'下一步'}}</t-button>
    </view>
  </view>
</view>

<!-- 空白填充 -->
<view style="height: 50rpx;" />

<!-- 发布订单确认弹窗 -->
<t-dialog 
  visible="{{showOrderConfirm}}" 
  title="确认发布订单" 
  confirm-btn="确认发布" 
  cancel-btn="再看看"
  bind:confirm="confirmOrder"
  bind:cancel="cancelOrder">
  <view slot="content" class="order-confirm-content-compact">
    <!-- 订单摘要卡片 -->
    <view class="confirm-card-compact">
      <!-- 联系人姓名 -->
      <view class="confirm-item-compact confirm-highlight-bg">
        <t-icon name="user" size="32rpx" color="#0052d9" class="confirm-icon-td" />
        <text class="confirm-label-compact">联系人</text>
        <text class="confirm-value-compact highlight-text-compact">{{showUser}}</text>
      </view>
      
      <!-- 联系电话 -->
      <view class="confirm-item-compact confirm-highlight-bg">
        <t-icon name="mobile" size="32rpx" color="#0052d9" class="confirm-icon-td" />
        <text class="confirm-label-compact">联系电话</text>
        <text class="confirm-value-compact highlight-text-compact">{{showPhone}}</text>
      </view>
      
      <!-- 取件地址 -->
      <view class="confirm-item-compact">
        <t-icon name="location" size="32rpx" color="#666666" class="confirm-icon-td" />
        <text class="confirm-label-compact">取件</text>
        <text class="confirm-value-compact">{{showPickUp.buildingName}} {{showPickUp.details}}</text>
      </view>
      
      <!-- 收件地址 -->
      <view class="confirm-item-compact">
        <t-icon name="flag" size="32rpx" color="#666666" class="confirm-icon-td" />
        <text class="confirm-label-compact">送达</text>
        <text class="confirm-value-compact">{{showRecive.buildingName}} {{showRecive.details}}</text>
      </view>
      
      <!-- 送达时间 -->
      <view class="confirm-item-compact">
        <t-icon name="time" size="32rpx" color="#666666" class="confirm-icon-td" />
        <text class="confirm-label-compact">预期送达</text>
        <text class="confirm-value-compact">{{showReachTime}}</text>
      </view>
      
      <!-- 价格 -->
      <view class="confirm-item-compact confirm-highlight-bg" wx:if="{{price && priceAccess == 1}}">
        <t-icon name="money" size="32rpx" color="#FF6B00" class="confirm-icon-td" />
        <text class="confirm-label-compact">发布价格</text>
        <text class="price-text-compact">¥{{price}}</text>
      </view>

      <view class="confirm-item-compact confirm-highlight-bg" wx:if="{{price && priceAccess == 1}}">
        <t-icon name="wallet" size="32rpx" color="#0052d9" class="confirm-icon-td" />
        <text class="confirm-label-compact">实付金额</text>
        <text class="price-text-compact">¥{{payAmount || 0}}</text>
      </view>
      
      <!-- 门禁提示（如果有） -->
      <view class="confirm-item-compact confirm-warning-item" wx:if="{{doorAccess == 1}}">
        <t-icon name="lock-on" size="32rpx" color="#FF6B00" class="confirm-icon-td" />
        <text class="warning-text-compact">有门禁，请提前沟通</text>
      </view>
    </view>
    
    <!-- 温馨提示 -->
    <view class="confirm-tips-compact">
      <t-icon name="info-circle-filled" size="28rpx" color="#FFB800" class="tips-icon-td" />
      <text class="tips-text-compact">{{priceAccess == 1 ? '发布后将进入支付' : '发布后骑手将收到通知'}}</text>
    </view>
  </view>
</t-dialog>


<!-- 取件地址修改弹出层 -->
<t-popup visible="{{visiblePickUp}}" bind:visible-change="onVisibleChangePickUp" placement="bottom" close-on-overlay-click="true">
  <view class="block">
    <!-- 顶栏 -->
    <view class="header">
      <view class="btn btn--cancel" aria-role="button" bind:tap="cancelAndConfirmPickUp">取消</view>
      <view class="title">取件地址修改</view>
      <view class="btn btn--confirm" aria-role="button" bind:tap="cancelAndConfirmPickUp">确定</view>
    </view>
    <!-- 滑动区域 -->
    <scroll-view class="body" style="height: 600rpx; overflow-y: scroll; padding-bottom: 20rpx;" scroll-y="true">
      <block wx:for="{{addrList}}" wx:key="id">
        <view class="show-cart">
          <view class="address-item-container">
            <!-- 左侧：单选框 -->
            <view class="address-item-radio" bindtap="onChangePickUp" data-item="{{item}}">
              <t-radio value="id" borderless="true" checked="{{item.id==showPickUp.id?true:false}}" />
            </view>
            
            <!-- 中间：地址信息 -->
            <view class="address-item-content" bindtap="onChangePickUp" data-item="{{item}}">
              <view class="address-item-row">
                <!-- 标签 -->
                <text class="popup-tag-compact">{{item.isDefault==1?'默认· ':''}}{{item.label || '常用'}}</text>
                <!-- 地址（校区 类型 楼宇 详细地址） -->
                <text class="address-text-inline">{{item.compusName}}{{item.buildCategoryName ? ' ' + item.buildCategoryName : ''}}{{item.buildingName ? ' ' + item.buildingName : ''}}{{item.details ? ' ' + item.details : ''}}</text>
              </view>
            </view>
            
            <!-- 右侧：编辑按钮 -->
            <view class="address-item-edit" bindtap="editAddress" data-id="{{item.id}}" catchtap="editAddress">
              <t-icon name="edit" size="40rpx" color="#999999" />
            </view>
          </view>
        </view>
      </block>
    </scroll-view>
  </view>
  <view class="button">
    <t-button block size="large" bind:tap="button0" theme="primary" variant="outline">添加新地址</t-button>
  </view>
</t-popup>
<!-- 收件地址弹出层 -->
