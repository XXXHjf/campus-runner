                <text class="address-text-inline">{{item.compusName}}{{item.buildCategoryName ? ' ' + item.buildCategoryName : ''}}{{item.buildingName ? ' ' + item.buildingName : ''}}{{item.details ? ' ' + item.details : ''}}</text>
