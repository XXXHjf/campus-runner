<!-- 跑腿内容说明 -->
<view class="card" hidden="{{!(count==2)}}">
  <!-- 卡片名 -->
  <view style="display: flex; align-items: center;">
    <t-icon class="cardIcon" name="attach" size="16" color="#0052d9" style="padding: 0 0 0 30rpx;" />
    <view class="cardName">内容说明</view>
  </view>
  <!-- 分割线 -->
  <t-divider class="drvider" />
  <!-- 内容说明  -->
