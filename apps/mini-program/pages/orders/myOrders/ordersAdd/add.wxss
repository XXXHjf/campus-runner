/* 门禁容器 - 改进布局 */
.door-container {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10rpx 0;
}

.door-left {
  display: flex;
  align-items: center;
  flex: 1;
}

/* 醒目的帮助说明按钮 */
.door-help-btn {
  margin-right: 30rpx;
  padding: 12rpx 20rpx;
  background: linear-gradient(135deg, #FF6B00 0%, #FF8F3D 100%);
  border-radius: 50rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 0, 0.3);
  transition: all 0.3s ease;
  animation: gentle-bounce 2s ease-in-out infinite;
}

.door-help-btn:active {
  transform: scale(0.95);
  box-shadow: 0 2rpx 8rpx rgba(255, 107, 0, 0.4);
}

.help-btn-content {
  display: flex;
  align-items: center;
  justify-content: center;
}

.help-btn-text {
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 600;
  margin-left: 8rpx;
  white-space: nowrap;
}

/* 图标脉冲动画 */
.help-icon-pulse {
  animation: pulse-icon 1.5s ease-in-out infinite;
}

/* 轻微弹跳动画 - 吸引注意但不过度 */
@keyframes gentle-bounce {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-4rpx);
  }
}

/* 图标脉冲效果 */
@keyframes pulse-icon {
  0%, 100% {
    opacity: 1;
    transform: scale(1);
  }
  50% {
    opacity: 0.8;
    transform: scale(1.1);
  }
}

