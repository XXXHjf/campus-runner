<view class="runner-detail-page">
  <view wx:if="{{orderInfo.id}}" class="runner-detail-sender">
    <t-avatar image="{{senderAvatar}}" icon="user" shape="circle" size="72rpx" />
    <text class="runner-detail-sender-name">{{isMyTaken ? (orderInfo.username || '同学') : '同学发布'}}</text>
    <text class="runner-detail-sender-time">{{orderInfo.createTime}}</text>
  </view>

  <view wx:if="{{orderInfo.id}}" class="runner-detail-main">
    <view wx:if="{{orderInfo.price != null}}" class="runner-detail-primary">
      <text class="runner-detail-price">¥{{orderInfo.price}}</text>
      <text class="runner-detail-price-label">跑腿报酬</text>
    </view>
    <view wx:else class="runner-detail-free">无偿跑腿</view>

    <view class="runner-detail-title">{{orderInfo.businessType === 'PURCHASE' ? '购买清单' : '跑腿内容'}}</view>
    <view class="runner-detail-tags">
      <t-tag wx:if="{{orderInfo.categoryName}}" size="small" variant="light">{{orderInfo.categoryName}}</t-tag>
      <t-tag wx:if="{{orderInfo.businessType === 'PURCHASE'}}" size="small" theme="warning" variant="light">代买</t-tag>
      <t-tag wx:if="{{orderInfo.status > 2}}" size="small" variant="light">{{orderStatusText}}</t-tag>
    </view>
    <view class="runner-detail-description">{{orderInfo.note || '暂无说明'}}</view>
    <view class="runner-detail-muted">预计送达：{{orderInfo.expectTime}}</view>

    <view wx:if="{{isMyTaken && taker.id && orderInfo.status > 0 && orderInfo.status != 4}}" class="runner-detail-section runner-detail-progress">
      <view class="runner-detail-section-title">订单进度</view>
      <t-steps theme="dot" readonly current="{{progressStep}}">
        <t-step-item wx:for="{{5}}" wx:key="index" title="{{title[index]}}" />
      </t-steps>
      <view wx:if="{{orderInfo.status == 1 || orderInfo.status == 2}}" class="runner-detail-countdown">
        <text>距离预期送达</text>
        <text wx:if="{{time < 0}}" class="runner-detail-overdue">已超时，请尽快送达</text>
        <t-count-down wx:else time="{{time}}" format="HH:mm:ss" theme="round" size="small" />
      </view>
    </view>

    <view class="runner-detail-section">
      <view class="runner-detail-section-title">{{orderInfo.businessType === 'PURCHASE' ? '购买与送达地点' : '取送地点'}}</view>
      <view class="runner-detail-address">
        <view class="runner-detail-address-dot runner-detail-address-dot--pickup"></view>
        <view class="runner-detail-address-content">
          <view class="runner-detail-address-label">{{orderInfo.businessType === 'PURCHASE' ? '购买地点' : '取件地址'}}</view>
          <view class="runner-detail-address-main">{{pickUpAddress[0]}} {{pickUpAddress[1]}} {{pickUpAddress[2]}}</view>
          <view wx:if="{{pickUpAddress[3]}}" class="runner-detail-muted">{{pickUpAddress[3]}}</view>
        </view>
      </view>
      <view class="runner-detail-address">
        <view class="runner-detail-address-dot runner-detail-address-dot--delivery"></view>
        <view class="runner-detail-address-content">
          <view class="runner-detail-address-label">{{orderInfo.businessType === 'PURCHASE' ? '送达地点' : '收件地址'}}</view>
          <view class="runner-detail-address-main">{{reciveAddress[0]}} {{reciveAddress[1]}} {{reciveAddress[2]}}</view>
          <view wx:if="{{reciveAddress[3]}}" class="runner-detail-muted">{{reciveAddress[3]}}</view>
        </view>
      </view>
      <view wx:if="{{orderInfo.businessType !== 'PURCHASE'}}" class="runner-detail-door">{{door[orderInfo.doorAccess]}}</view>
    </view>

    <view wx:if="{{orderInfo.businessType === 'PURCHASE' && orderInfo.price != null}}" class="runner-detail-section">
      <view class="runner-detail-section-title">收款明细</view>
      <view class="runner-detail-money-row"><text>需先垫付</text><text>¥{{orderInfo.productAmount || 0}}</text></view>
      <view class="runner-detail-money-row"><text>跑腿收入</text><text>¥{{orderInfo.price || 0}}</text></view>
      <view class="runner-detail-money-row runner-detail-money-row--total"><text>完成后预计收款</text><text>¥{{orderInfo.runnerReceivable || 0}}</text></view>
      <view class="runner-detail-muted">完成后商品金额与跑腿费将一起收款</view>
    </view>

    <view wx:if="{{orderInfo.images && orderInfo.images.length}}" class="runner-detail-section">
      <view class="runner-detail-section-title">任务图片</view>
      <view class="runner-detail-images">
        <t-image wx:for="{{orderInfo.images}}" wx:key="*this" src="{{item}}" bind:tap="tapOnImageToPreview" data-src="{{item}}" data-flag="{{isMyTaken ? 1 : 0}}" mode="aspectFit" shape="round" class="runner-detail-image" style="{{isMyTaken ? '' : 'filter:blur(10rpx)'}}" />
      </view>
    </view>

    <view wx:if="{{isMyTaken && taker.id && orderInfo.status > 0 && orderInfo.status != 4}}" class="runner-detail-section">
      <view class="runner-detail-section-title">联系发布人</view>
      <view class="runner-detail-contact-name">{{orderInfo.username || '微信用户'}}</view>
      <view wx:if="{{orderInfo.phone}}" class="runner-detail-contact-phone" bind:tap="tapOnPhoneToDo" data-phone="orderInfo">{{orderInfo.phone}} <t-icon name="chevron-right" size="28rpx" /></view>
    </view>

    <view wx:if="{{isMyTaken && taker.purchaseProofImage}}" class="runner-detail-section">
      <view class="runner-detail-section-title">购买凭证</view>
      <t-image src="{{taker.purchaseProofImage}}" bind:tap="tapOnImageToPreview" data-src="{{taker.purchaseProofImage}}" mode="aspectFit" shape="round" class="runner-detail-image" />
    </view>
    <view wx:if="{{isMyTaken && image && orderInfo.status > 0}}" class="runner-detail-section">
      <view class="runner-detail-section-title">送达图片</view>
      <t-image src="{{image}}" bind:tap="tapOnImageToPreview" data-src="{{image}}" mode="aspectFit" shape="round" class="runner-detail-image" />
    </view>

    <view class="runner-detail-meta">
      <view><text>发布时间</text><text>{{orderInfo.createTime}}</text></view>
      <view wx:if="{{orderInfo.status == 0 && orderInfo.cancelTime}}"><text>自动取消</text><text>{{orderInfo.cancelTime}}</text></view>
      <view wx:if="{{isMyTaken && taker.takeOrderTime}}"><text>接单时间</text><text>{{taker.takeOrderTime}}</text></view>
      <view wx:if="{{isMyTaken && orderInfo.deliveryTime}}"><text>实际送达</text><text>{{orderInfo.deliveryTime}}</text></view>
      <view><text>订单编号</text><text>{{orderInfo.orderNumber}}</text></view>
    </view>
  </view>

  <ui-action-bar wx:if="{{orderInfo.status == 0 || (isMyTaken && (orderInfo.status == 1 || orderInfo.status == 2 || ((orderInfo.status == 5 || orderInfo.status == 7) && orderInfo.price != null)))}}" class="runner-detail-action-bar" fixed>
    <view class="runner-detail-actions">
      <t-button wx:if="{{orderInfo.status == 0 || orderInfo.status == 1 || orderInfo.status == 2}}" class="runner-detail-action" t-class="cr-secondhand-capsule runner-detail-capsule" shape="round" theme="primary" bind:tap="button">{{orderInfo.businessType === 'PURCHASE' && orderInfo.status == 1 ? '提交购买凭证' : (orderInfo.businessType === 'PURCHASE' && orderInfo.status == 2 ? '上传送达图片' : titleB[orderInfo.status])}}</t-button>
      <t-button wx:else class="runner-detail-action" t-class="cr-secondhand-capsule runner-detail-capsule" shape="round" theme="primary" loading="{{transferBusy}}" disabled="{{transferBusy}}" bind:tap="_requestMerchantTransfer">{{orderInfo.status == 7 ? '重新收款' : '确认收款'}}</t-button>
    </view>
  </ui-action-bar>
</view>
<!-- 接单提示 -->
<t-dialog visible="{{showConfirm}}" title="接单提示" confirm-btn="确定" cancel-btn="取消" bind:confirm="closeConfirm" bind:cancel="closeDialog">
  <!-- 适配skyline，增加type="list" -->
  <scroll-view slot="content" type="list" scroll-y class="long-content">
    <view class="content-container">
      <view>
        <span>{{orderInfo.businessType === 'PURCHASE' ? '请先与发单方确认商品、规格和预算。接单后请按要求购买，提交购买凭证后开始配送；如遇问题，请联系平台协商处理。' : '为确保服务质量，接单后不可取消订单。平台仅提供交易渠道，服务细节请与发单方确认清楚。'}}</span>
      </view>
    </view>
  </scroll-view>
</t-dialog>

<!-- 派送提示 -->
<t-popup visible="{{showWithImage}}" bind:visible-change="closeWithImage" placement="bottom">
  <view class="runner-detail-upload">
    <view class="block">
      <view class="header">
        <view class="btn btn--cancel" bind:tap="closeWithImage">取消</view>
        <view class="title">{{proofPurpose === 'PURCHASE_PROOF' ? '购买凭证' : '送达图片'}}</view>
        <view class="btn btn--confirm" bind:tap="closeConfirmWithImage">确定</view>
      </view>
    </view>
    <view style="margin-bottom: 30rpx;">
      <view class="address">{{proofPurpose === 'PURCHASE_PROOF' ? '请上传实际购买的商品照片或小票（一张）' : '请选择送达图片上传（一张）'}}</view>
      <t-upload t-class="external-class" mediaType="{{['image']}}" max="{{1}}" files="{{fileList}}" bind:add="handleAdd" bind:remove="handleRemove" style="text-align: center;" />
    </view>
  </view>
</t-popup>

<!-- 刷新轻提示 -->
<t-toast id="t-toast" />
