@import "../../../../styles/second-hand-card.wxss";

page {
  background: #f3f4f5;
}

.runner-detail-page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background: #f3f4f5;
}

.runner-detail-sender {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx;
}

.runner-detail-sender t-avatar {
  flex: 0 0 auto;
}

.runner-detail-sender-name {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--cr-color-text, #1d2129);
  font-size: 28rpx;
  font-weight: 600;
}

.runner-detail-sender-time {
  flex: 0 0 auto;
  max-width: 45%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--cr-color-text-secondary, #6b778c);
  font-size: 22rpx;
}

.runner-detail-main {
  flex: 1;
  padding: 32rpx 28rpx calc(188rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-radius: 36rpx 36rpx 0 0;
}

.runner-detail-primary {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.runner-detail-price {
  color: #ff6a3d;
  font-size: 52rpx;
  font-weight: 800;
}

.runner-detail-price-label {
  flex-shrink: 0;
  margin-top: 12rpx;
  color: #7a867f;
  font-size: 23rpx;
}

.runner-detail-free {
  color: #17231d;
  font-size: 34rpx;
  font-weight: 800;
}

.runner-detail-title {
  margin-top: 12rpx;
  color: #17231d;
  font-size: 36rpx;
  font-weight: 800;
  line-height: 1.35;
}

.runner-detail-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 18rpx;
}

.runner-detail-description {
  margin-top: 28rpx;
  color: #344139;
  font-size: 27rpx;
  line-height: 1.65;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}

.runner-detail-muted {
  margin-top: 10rpx;
  color: #7a867f;
  font-size: 24rpx;
  line-height: 1.5;
  overflow-wrap: anywhere;
}

.runner-detail-section {
  margin-top: 38rpx;
}

.runner-detail-section-title {
  margin-bottom: 20rpx;
  color: #17231d;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.4;
}

.runner-detail-progress {
  padding: 22rpx 0;
  border-top: 1rpx solid #eef2ef;
  border-bottom: 1rpx solid #eef2ef;
}

.runner-detail-progress .runner-detail-section-title {
  margin-bottom: 16rpx;
}

.runner-detail-countdown {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 20rpx;
  color: #6b778c;
  font-size: 24rpx;
}

.runner-detail-overdue {
  color: #e34d59;
  font-weight: 600;
}

.runner-detail-address {
  display: flex;
  gap: 18rpx;
  padding: 12rpx 0;
}

.runner-detail-address-dot {
  flex: 0 0 12rpx;
  width: 12rpx;
  height: 12rpx;
  margin-top: 12rpx;
  border-radius: 50%;
}

.runner-detail-address-dot--pickup {
  background: #2ba471;
}

.runner-detail-address-dot--delivery {
  background: #0052d9;
}

.runner-detail-address-content {
  flex: 1;
  min-width: 0;
}

.runner-detail-address-label {
  color: #6b778c;
  font-size: 24rpx;
}

.runner-detail-address-main {
  margin-top: 8rpx;
  color: #17231d;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.5;
  overflow-wrap: anywhere;
}

.runner-detail-door {
  margin-top: 12rpx;
  padding: 16rpx;
  border-radius: 12rpx;
  background: #f6f7f8;
  color: #66736c;
  font-size: 24rpx;
  text-align: center;
}

.runner-detail-money-row {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  padding: 12rpx 0;
  color: #6b778c;
  font-size: 27rpx;
}

.runner-detail-money-row text:last-child {
  color: #17231d;
  font-weight: 600;
}

.runner-detail-money-row--total {
  margin-top: 8rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #eef2ef;
  color: #17231d;
  font-weight: 600;
}

.runner-detail-money-row--total text:last-child {
  color: #ff6a3d;
  font-size: 34rpx;
}

.runner-detail-images {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.runner-detail-image {
  display: block;
  width: 180rpx;
  height: 180rpx;
  --td-image-round-radius: var(--cr-radius-medium);
}

.runner-detail-contact-name {
  color: #17231d;
  font-size: 28rpx;
  font-weight: 600;
}

.runner-detail-contact-phone {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
  padding: 12rpx 0;
  color: var(--cr-color-primary, #0052d9);
  font-size: 27rpx;
}

.runner-detail-meta {
  margin-top: 38rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #eef2ef;
}

.runner-detail-meta > view {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  padding: 10rpx 0;
  color: #7a867f;
  font-size: 23rpx;
}

.runner-detail-meta > view text:last-child {
  max-width: 65%;
  text-align: right;
  overflow-wrap: anywhere;
}

.runner-detail-page .runner-detail-action-bar {
  --cr-action-bar-padding-top: 11rpx;
}

.runner-detail-actions {
  display: flex;
  justify-content: flex-end;
  width: 100%;
}

.runner-detail-action {
  flex: 0 0 auto;
}

.runner-detail-capsule {
  width: auto;
  max-width: 360rpx;
  --td-button-medium-height: 65rpx;
  --td-button-medium-font-size: 28rpx;
  --td-button-medium-padding-horizontal: 24rpx;
}

.runner-detail-upload .block {
  background: var(--td-bg-color-container);
  border-radius: 16rpx 16rpx 0 0;
}

.runner-detail-upload .header {
  display: flex;
  align-items: center;
  height: 116rpx;
}

.runner-detail-upload .title {
  flex: 1;
  color: var(--td-text-color-primary);
  font-size: 36rpx;
  font-weight: 600;
  text-align: center;
}

.runner-detail-upload .btn {
  padding: 32rpx;
  font-size: 32rpx;
}

.runner-detail-upload .btn--cancel {
  color: var(--td-text-color-secondary);
}

.runner-detail-upload .btn--confirm {
  color: #0052d9;
}

.runner-detail-upload .address {
  margin: 20rpx 30rpx;
  color: #6b778c;
  font-size: 27rpx;
  text-align: center;
}
