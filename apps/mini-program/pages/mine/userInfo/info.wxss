.profile-avatar-control {
  display: flex;
  align-items: center;
}

.profile-avatar-button {
  width: 88rpx;
  height: 88rpx;
  padding: 0;
}

.profile-avatar {
  display: block;
  width: 88rpx;
  height: 88rpx;
  object-fit: cover;
  border: 3rpx solid var(--cr-color-primary-light);
  border-radius: 50%;
}

.profile-save-button {
  flex: 1;
}
