<view class="card" style="margin-top: 50rpx;">
  <!-- 认证信息 -->
  <view style="display: flex; align-items: center;">
    <t-icon class="cardIcon" name="user-list" size="20" color="#0052d9" style="padding: 0 0 0 30rpx;" />
    <view class="cardName">个人信息</view>
  </view>
  <!-- 分割线 -->
  <t-divider class="drvider" />
  <t-input label="头像" disabled="true" style="padding-top: 0 !important;">
    <view slot="suffix" class="suffix">
      <view class="box1">
        <t-button class="avatar-wrapper" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar" theme="primary" size="large" variant="text">
          <image class="avatar" src="{{newAvatar==null?userInfo.headImg:newAvatar}}"></image>
        </t-button>
        <t-icon name="chevron-right" size="24" color="rgba(0, 0, 0, 0.4)" style="padding-left: 24rpx;" />
      </view>
    </view>
  </t-input>
  <!-- 昵称单元格 -->
  <t-input label="昵称" type="nickname" placeholder="{{userInfo.username}}" bindchange="tiptChangeUsername" align="right" maxlength="20">
    <view slot="suffix" class="suffix">
      <view class="box1">
        <t-icon name="chevron-right" size="24" color="rgba(0, 0, 0, 0.4)" />
      </view>
    </view>
  </t-input>
  <!-- 手机号单元格 -->
  <t-input label="手机号" placeholder="{{userInfo.phone||'输入手机号码'}}" value="{{phoneNumber}}" type="number" tips="{{phoneError ? '手机号输入不正确' : ''}}" borderless="true" bindchange="onPhoneInput" align="right">
    <view slot="suffix" style="display: flex; align-items: center">
      <!-- <view class="suffix--line"></view>
      <view class="verify" aria-role="button"> 发送验证码 </view> -->
      <t-icon name="chevron-right" size="24" color="rgba(0, 0, 0, 0.4)" />
    </view>
  </t-input>
</view>

<view class="card" style="margin-top: 50rpx;">
  <!-- 认证信息顶部蓝字 -->
  <view style="display: flex; align-items: center;">
    <t-icon class="cardIcon" name="user-checked" size="16" color="#0052d9" style="padding: 0 0 0 30rpx;" />
    <view class="cardName">认证信息</view>
  </view>
  <!-- 分割线 -->
  <t-divider class="drvider" />
  <t-input label="校园认证" align="right" bind:tap="toIdentify" placeholder="{{userInfo.authentication==1?'已认证':'未认证'}}" disabled="true" borderless="true">
    <view slot="suffix" class="suffix">
      <t-icon name="chevron-right" size="24" color="rgba(0, 0, 0, 0.4)" />
    </view>
  </t-input>
</view>


<!-- 保存信息按钮 -->
<view class="button">
  <t-button block theme="primary" bind:tap="save">保存信息</t-button>
</view>

<!-- 刷新轻提示 -->
<t-toast id="t-toast" />
