<ui-page safe-bottom>
  <ui-section title="个人信息" icon="user-list">
    <t-cell title="头像" arrow>
      <view slot="note" class="profile-avatar-control">
        <t-button class="profile-avatar-button" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar" theme="primary" variant="text">
          <image class="profile-avatar" src="{{newAvatar || userInfo.headImg}}" mode="aspectFill" />
        </t-button>
      </view>
    </t-cell>
    <t-input label="昵称" type="nickname" placeholder="{{userInfo.username || '请输入昵称'}}" bind:change="tiptChangeUsername" align="right" maxlength="20" clearable />
    <t-input label="手机号" placeholder="{{userInfo.phone || '请输入手机号'}}" value="{{phoneNumber}}" type="number" tips="{{phoneError ? '手机号格式不正确' : ''}}" bind:change="onPhoneInput" align="right" maxlength="11" clearable />
  </ui-section>

  <ui-section title="认证信息" icon="user-checked">
    <t-cell title="校园认证" note="{{userInfo.authentication == 1 ? '已认证' : '未认证'}}" hover arrow bind:tap="toIdentify" />
  </ui-section>

  <ui-action-bar fixed>
    <t-button class="profile-save-button" block theme="primary" bind:tap="save">保存信息</t-button>
  </ui-action-bar>
</ui-page>

<t-toast id="t-toast" />
