<!-- 我的 -->
<ui-page compact>
  <view class="mine-page">

    <view class="mine-profile">
      <!-- 头像与昵称 -->
      <view class="mine-profile__main" bind:tap="loginTap" role="button" aria-label="登录与认证">
        <image class="mine-profile__avatar" src="{{userInfo.headImg || defaultAvatarUrl}}" mode="aspectFill"></image>
        <view class="mine-profile__info">
          <view class="mine-profile__identity">
            <text class="mine-profile__nickname">{{userInfo.username || "未登录"}}</text>
            <t-tag wx:if="{{userInfo}}" class="mine-profile__tag" variant="light" size="small" theme="{{userInfo.authentication==0?'default':'primary'}}" icon="{{userInfo.sex==null?'':userInfo.sex==0?'gender-female':'gender-male'}}">{{userInfo.authentication==1?' 已认证':' 未认证'}}</t-tag>
          </view>
          <view>
            <text class="mine-profile__phone">{{userInfo==null?'使用微信授权登录':(displayPhone?'Tel：'+displayPhone:'请完善信息')}}</text>
          </view>
        </view>
        <t-icon name="chevron-right" size="36rpx" color="#6b778c" />
      </view>
    </view>

    <!-- 快捷入口 -->
    <view class="menu-section" wx:for="{{menuSections}}" wx:for-index="sectionIndex" wx:key="title">
      <ui-section title="{{item.title}}" plain>
        <view class="menu-grid {{sectionIndex==0?'menu-grid--runner':sectionIndex==1?'menu-grid--trade':'menu-grid--account'}}">
          <view wx:for="{{item.items}}" wx:for-item="menu" wx:key="value" class="menu-card" data-value="{{menu.value}}" bindtap="onMenuTap">
            <view class="menu-icon">
              <t-icon name="{{menu.icon}}" size="{{sectionIndex==2?'40rpx':'48rpx'}}" color="#0052d9" />
              <view class="menu-badge" wx:if="{{menu.value==='label_1' && unpaidOrderList.length>0}}">{{unpaidOrderList.length}}</view>
              <view class="menu-badge" wx:if="{{menu.value==='label_2' && notReceiveOrderList.length>0}}">{{notReceiveOrderList.length}}</view>
              <view class="menu-badge" wx:if="{{menu.value==='label_8' && secondHandOrderCount>0}}">{{secondHandOrderCount}}</view>
              <view class="menu-badge" wx:if="{{menu.value==='label_12' && secondHandSellerOrderCount>0}}">{{secondHandSellerOrderCount}}</view>
              <view class="menu-badge" wx:if="{{menu.value==='label_9' && bargainPendingCount>0}}">{{bargainPendingCount}}</view>
            </view>
            <view class="menu-copy">
              <view class="menu-label">{{menu.label}}</view>
            </view>
            <t-icon wx:if="{{sectionIndex==2}}" name="chevron-right" size="34rpx" color="#6b778c" />
          </view>
        </view>
      </ui-section>
    </view>

    <view class="task-center-heading" wx:if="{{unpaidOrderList.length > 0 || notReceiveOrderList.length > 0 || secondHandOrderCount > 0 || secondHandSellerOrderCount > 0 || bargainPendingCount > 0}}">
      <text>待办事项</text>
      <text class="task-center-count">{{unpaidOrderList.length + notReceiveOrderList.length + secondHandOrderCount + secondHandSellerOrderCount + bargainPendingCount}}项</text>
    </view>

    <!-- 待支付提醒 -->
    <view class="pending-unpaid-section" wx:if="{{unpaidOrderList.length > 0}}">
      <view class="pending-unpaid-card" bindtap="tapToUnpaid">
        <view class="payment-content">
          <view class="payment-icon-wrapper">
            <t-icon name="error-circle" size="48rpx" color="#e34d59" />
            <view class="payment-badge">{{unpaidOrderList.length}}</view>
          </view>
          <view class="payment-info">
            <view class="payment-title">
              <text>待支付订单</text>
              <t-tag theme="danger" variant="light" size="small" style="margin-left: 12rpx;">30分钟内支付</t-tag>
            </view>
            <view class="payment-desc unpaid-desc">
              <text>{{unpaidOrderList.length}}个订单待支付，请尽快完成支付</text>
            </view>
          </view>
        </view>
        <view class="payment-arrow">
          <t-icon name="chevron-right" size="40rpx" color="#999" />
        </view>
      </view>
    </view>

    <!-- 待收款提醒 - 优化版 -->
    <view class="pending-payment-section" wx:if="{{notReceiveOrderList.length > 0}}">
      <view class="pending-payment-card" bindtap="tapToReceive">
        <!-- 左侧图标和内容 -->
        <view class="payment-content">
          <view class="payment-icon-wrapper">
            <t-icon name="money-circle" size="48rpx" color="#ed7b2f" />
            <view class="payment-badge">{{notReceiveOrderList.length}}</view>
          </view>
          <view class="payment-info">
            <view class="payment-title">
              <text>待收款订单</text>
              <t-tag theme="warning" variant="light" size="small" style="margin-left: 12rpx;">待处理</t-tag>
            </view>
            <view class="payment-desc">
              <text>{{notReceiveOrderList.length}}个订单已完成，点击查看收款</text>
            </view>
          </view>
        </view>
        <!-- 右侧箭头 -->
        <view class="payment-arrow">
          <t-icon name="chevron-right" size="40rpx" color="#999" />
        </view>
      </view>
    </view>

    <view class="mine-support">
      <ui-section plain>
        <view class="mine-support__grid {{userInfo?'':'mine-support__grid--single'}}">
          <t-button class="mine-support__button" theme="default" variant="text" open-type="share" bindtap="share" block>
            <view class="mine-support__content">
              <view class="menu-icon"><t-icon name="user-add" size="40rpx" color="#0052d9" /></view>
              <text>邀请好友</text>
              <t-icon name="chevron-right" size="32rpx" color="#6b778c" />
            </view>
          </t-button>
          <t-button wx:if="{{userInfo}}" class="mine-support__button mine-support__button--feedback" theme="default" variant="text" open-type="feedback" bindtap="feedback" block>
            <view class="mine-support__content">
              <view class="menu-icon"><t-icon name="edit" size="40rpx" color="#0052d9" /></view>
              <text>意见反馈</text>
              <t-icon name="chevron-right" size="32rpx" color="#6b778c" />
            </view>
          </t-button>
        </view>
      </ui-section>
    </view>

    <view wx:if="{{userInfo}}" class="mine-logout">
      <t-button theme="default" variant="text" bind:tap="logoutBtnClick">退出登录</t-button>
    </view>
  </view>
</ui-page>

<!-- 登录加载动画 -->
<t-overlay class="mine-loading" visible="{{loginLoadShow}}" duration="{{500}}" backgroundColor="rgb(255,255,255,0.5)">
  <t-loading theme="dots" size="100rpx" />
</t-overlay>

<!-- 登陆失败的轻提示 -->
<ui-feedback id="ui-feedback" />
