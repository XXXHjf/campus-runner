.mine-page {
  --cr-radius-medium: 20rpx;
  --cr-section-gap: 22rpx;
  display: flex;
  flex-direction: column;
  padding-bottom: 24rpx;
  background: var(--cr-color-background);
  box-sizing: border-box;
}

.mine-page .mine-profile {
  order: 0;
  padding: 2rpx 38rpx 32rpx;
}

.mine-page .mine-profile__main {
  display: flex;
  align-items: center;
  gap: 28rpx;
  min-height: 128rpx;
}

.mine-page .mine-profile__avatar {
  flex-shrink: 0;
  display: block;
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: #fceef3;
}

.mine-page .mine-profile__info {
  flex: 1;
  min-width: 0;
}

.mine-page .mine-profile__identity {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}

.mine-page .mine-profile__nickname {
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 48rpx;
  color: var(--cr-color-text);
}

.mine-page .mine-profile__phone {
  display: block;
  margin-top: 10rpx;
  color: var(--cr-color-text-secondary);
  font-size: 26rpx;
  line-height: 38rpx;
}

.mine-page .menu-section {
  order: 3;
  margin: 0 24rpx;
}

.mine-page .menu-grid {
  display: grid;
  padding: 0 26rpx 22rpx;
}

.mine-page .menu-card {
  display: flex;
  align-items: center;
  min-width: 0;
  box-sizing: border-box;
}

.mine-page .menu-icon {
  position: relative;
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background: #f0f5ff;
}

.mine-page .menu-copy {
  min-width: 0;
}

.mine-page .menu-label {
  color: var(--cr-color-text);
  font-size: 27rpx;
  font-weight: 500;
  line-height: 40rpx;
  white-space: nowrap;
}

.mine-page .menu-grid--runner {
  grid-template-columns: repeat(2, minmax(0, 1fr));
  padding-top: 12rpx;
  padding-bottom: 32rpx;
}

.mine-page .menu-grid--runner .menu-card {
  position: relative;
  justify-content: center;
  gap: 16rpx;
  min-height: 90rpx;
}

.mine-page .menu-grid--runner .menu-card + .menu-card::before {
  position: absolute;
  left: 0;
  top: 14rpx;
  bottom: 14rpx;
  width: 1rpx;
  background: var(--cr-color-border);
  content: '';
}

.mine-page .menu-grid--trade {
  grid-template-columns: repeat(3, minmax(0, 1fr));
  row-gap: 36rpx;
  padding-top: 8rpx;
  padding-bottom: 36rpx;
}

.mine-page .menu-grid--trade .menu-card {
  flex-direction: column;
  gap: 12rpx;
}

.mine-page .menu-grid--account .menu-card {
  gap: 24rpx;
  min-height: 104rpx;
}

.mine-page .menu-grid--account .menu-card + .menu-card {
  border-top: 1rpx solid var(--cr-color-border);
}

.mine-page .menu-grid--account .menu-icon,
.mine-page .mine-support .menu-icon {
  width: 68rpx;
  height: 68rpx;
}

.mine-page .menu-grid--account .menu-copy {
  flex: 1;
}

.mine-page .menu-badge {
  position: absolute;
  top: -6rpx;
  right: -8rpx;
  min-width: 30rpx;
  padding: 2rpx 7rpx;
  color: #ffffff;
  background: #e34d59;
  border: 2rpx solid #ffffff;
  border-radius: 999rpx;
  font-size: 19rpx;
  font-weight: 600;
  line-height: 28rpx;
  text-align: center;
  box-sizing: border-box;
}

.mine-page .mine-support {
  order: 4;
  margin: 0 24rpx;
}

.mine-page .mine-support__grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  padding: 22rpx 16rpx;
}

.mine-page .mine-support__grid--single {
  grid-template-columns: minmax(0, 1fr);
}

.mine-page .mine-support__button {
  --td-button-medium-height: 76rpx;
  --td-button-medium-padding-horizontal: 10rpx;
  --td-button-medium-font-size: 27rpx;
  --td-button-font-weight: 500;
  --td-button-default-color: var(--cr-color-text);
}

.mine-page .mine-support__button--feedback {
  border-left: 1rpx solid var(--cr-color-border);
}

.mine-page .mine-support__content {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
}

.mine-page .mine-logout {
  order: 5;
  display: flex;
  justify-content: center;
  padding: 0 24rpx 8rpx;
  --td-button-default-color: var(--cr-color-text-secondary);
  --td-button-font-weight: 400;
  --td-button-medium-font-size: 26rpx;
}

.mine-loading {
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 待收款提醒样式 - 优化版 */
.mine-page .pending-payment-section {
  order: 2;
  margin: var(--mine-card-gap) 30rpx 0;
}

.mine-page .pending-unpaid-section {
  order: 2;
  margin: var(--mine-card-gap) 30rpx 0;
}

.mine-page .task-center-heading {
  order: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 16rpx 30rpx 0;
  color: #111827;
  font-size: 30rpx;
  font-weight: 700;
}

.mine-page .task-center-count {
  color: #0052d9;
  font-size: 24rpx;
  font-weight: 600;
}

.mine-page .pending-unpaid-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(135deg, #fff1f0 0%, #ffe6e4 100%);
  border-radius: 20rpx;
  padding: 24rpx 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(227, 77, 89, 0.1);
  border: 2rpx solid #fecaca;
  position: relative;
  overflow: hidden;
}

.mine-page .pending-unpaid-card::before {
  content: '';
  position: absolute;
  right: -20rpx;
  top: -20rpx;
  width: 120rpx;
  height: 120rpx;
  background: radial-gradient(circle, rgba(227, 77, 89, 0.08) 0%, transparent 70%);
  border-radius: 50%;
}

.mine-page .pending-payment-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(135deg, #fff5e6 0%, #ffe8cc 100%);
  border-radius: 20rpx;
  padding: 24rpx 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(237, 123, 47, 0.1);
  border: 2rpx solid #fed7aa;
  position: relative;
  overflow: hidden;
}

/* 添加微妙的背景装饰 */
.mine-page .pending-payment-card::before {
  content: '';
  position: absolute;
  right: -20rpx;
  top: -20rpx;
  width: 120rpx;
  height: 120rpx;
  background: radial-gradient(circle, rgba(237, 123, 47, 0.08) 0%, transparent 70%);
  border-radius: 50%;
}

.mine-page .payment-content {
  display: flex;
  align-items: center;
  flex: 1;
}

.mine-page .payment-icon-wrapper {
  position: relative;
  margin-right: 24rpx;
}

.mine-page .payment-badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  background: #e34d59;
  color: white;
  font-size: 20rpx;
  font-weight: bold;
  padding: 2rpx 8rpx;
  border-radius: 20rpx;
  min-width: 32rpx;
  text-align: center;
  box-shadow: 0 2rpx 8rpx rgba(227, 77, 89, 0.3);
}

.mine-page .payment-info {
  flex: 1;
}

.mine-page .payment-title {
  display: flex;
  align-items: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.mine-page .payment-desc {
  font-size: 24rpx;
  color: #ed7b2f;
  font-weight: 500;
}

.mine-page .unpaid-desc {
  color: #e34d59;
}

.mine-page .payment-arrow {
  margin-left: 20rpx;
  display: flex;
  align-items: center;
}
