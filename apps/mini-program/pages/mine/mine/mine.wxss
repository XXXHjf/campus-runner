/* 总体布局 */
.show {
  position: relative;
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  padding-bottom: 40rpx;
  background: #f5f6f8;
  box-sizing: border-box;
}

.box1 {
  border-radius: 20rpx;
  margin: 20rpx 30rpx 10rpx;
  background-color: white;
  padding: 20rpx 25rpx;
}

.box1-1 {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.avatar {
  border-radius: 30px;
  display: block;
  width: 56px;
  height: 56px;
  margin: 0 30rpx;
}

.info {
  margin-left: 20rpx;
}

.nickname {
  font-weight: bold;
}

.tag {
  margin-left: 30rpx;
}

.text {
  margin: 5rpx 0;
  font-size: small;
  color: gray;
}

.menu-section {
  margin: 18rpx 30rpx 0;
  padding: 24rpx;
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 35, 80, 0.05);
}

.menu-section-title {
  margin-bottom: 18rpx;
  color: #111827;
  font-size: 30rpx;
  font-weight: 700;
}

.menu-grid {
  display: grid;
  gap: 16rpx;
}

.menu-grid.two {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.menu-grid.three {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.menu-card {
  min-height: 126rpx;
  padding: 20rpx 18rpx;
  background: #f7f9fc;
  border: 1rpx solid #eef2f7;
  border-radius: 16rpx;
  box-sizing: border-box;
}

.menu-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  background: #eaf2ff;
  border-radius: 18rpx;
}

.menu-copy {
  margin-top: 14rpx;
  min-width: 0;
}

.menu-label {
  color: #1f2937;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 1.25;
  white-space: nowrap;
}
.box2 {
  margin: 10rpx 0;
}

.button {
  margin: 40rpx 30rpx;
  border-radius: 10rpx;
  background-color: white;
}

.t-button {
  border: none !important;
}

.t-button--ghost::after {
  border-color: rgba(255, 255, 255, 0) !important;
}

.loadingBox {
  /* 加载动画居中 */
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 待收款提醒样式 - 优化版 */
.pending-payment-section {
  margin: 20rpx 30rpx;
}

.pending-unpaid-section {
  margin: 20rpx 30rpx;
}

.pending-unpaid-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(135deg, #fff1f0 0%, #ffe6e4 100%);
  border-radius: 20rpx;
  padding: 24rpx 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(227, 77, 89, 0.1);
  border: 2rpx solid #fecaca;
  position: relative;
  overflow: hidden;
}

.pending-unpaid-card::before {
  content: '';
  position: absolute;
  right: -20rpx;
  top: -20rpx;
  width: 120rpx;
  height: 120rpx;
  background: radial-gradient(circle, rgba(227, 77, 89, 0.08) 0%, transparent 70%);
  border-radius: 50%;
}

.pending-payment-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(135deg, #fff5e6 0%, #ffe8cc 100%);
  border-radius: 20rpx;
  padding: 24rpx 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(237, 123, 47, 0.1);
  border: 2rpx solid #fed7aa;
  position: relative;
  overflow: hidden;
}

/* 添加微妙的背景装饰 */
.pending-payment-card::before {
  content: '';
  position: absolute;
  right: -20rpx;
  top: -20rpx;
  width: 120rpx;
  height: 120rpx;
  background: radial-gradient(circle, rgba(237, 123, 47, 0.08) 0%, transparent 70%);
  border-radius: 50%;
}

.payment-content {
  display: flex;
  align-items: center;
  flex: 1;
}

.payment-icon-wrapper {
  position: relative;
  margin-right: 24rpx;
}

.payment-badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  background: #e34d59;
  color: white;
  font-size: 20rpx;
  font-weight: bold;
  padding: 2rpx 8rpx;
  border-radius: 20rpx;
  min-width: 32rpx;
  text-align: center;
  box-shadow: 0 2rpx 8rpx rgba(227, 77, 89, 0.3);
}

.payment-info {
  flex: 1;
}

.payment-title {
  display: flex;
  align-items: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.payment-desc {
  font-size: 24rpx;
  color: #ed7b2f;
  font-weight: 500;
}

.unpaid-desc {
  color: #e34d59;
}

.payment-arrow {
  margin-left: 20rpx;
  display: flex;
  align-items: center;
}
