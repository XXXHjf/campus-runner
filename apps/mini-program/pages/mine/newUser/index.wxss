/* 新用户注册页面 */
page {
  background-color: #f5f5f5;
  min-height: 100vh;
}

.container {
  padding: 40rpx 32rpx;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

/* 标题区域 */
.title-section {
  text-align: center;
  margin-bottom: 60rpx;
  margin-top: 40rpx;
}

.main-title {
  font-size: 48rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 16rpx;
}

.sub-title {
  font-size: 26rpx;
  color: #999999;
}

/* 表单卡片 */
.form-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 48rpx 32rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.05);
  flex: 1;
}

/* 表单项 */
.form-item {
  margin-bottom: 40rpx;
}

.form-item:first-child {
  text-align: center;
  margin-bottom: 48rpx;
}

.label {
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
  margin-bottom: 16rpx;
}

/* 输入框 */
.input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  background: #f8f8f8;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #333333;
  border: 1rpx solid #e5e5e5;
  box-sizing: border-box;
}

.input:focus {
  background: #ffffff;
  border-color: #0052d9;
}

.placeholder {
  color: #cccccc;
}

/* 头像 */
.avatar-btn {
  width: 146rpx;
  height: 146rpx;
  padding: 0;
  margin: 0 auto;
  background: transparent;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-btn::after {
  border: none;
}

.avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  border: 3rpx solid #0052d9;
  display: block;
  box-sizing: border-box;
}

.tip {
  font-size: 24rpx;
  color: #999999;
  text-align: center;
  margin-top: 12rpx;
}

/* 用户协议 */
.agreement {
  margin-bottom: 32rpx;
  margin-top: 8rpx;
}

.agreement-text {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.8;
  display: flex;
  align-items: center;
}

.link {
  color: #0052d9;
  text-decoration: underline;
}

/* 提交按钮 */
.submit-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #0052d9;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 500;
  border-radius: 8rpx;
  border: none;
  text-align: center;
}

.submit-btn::after {
  border: none;
}

/* 底部版权 */
.footer {
  text-align: center;
  padding: 32rpx 0;
  margin-top: 24rpx;
}

.copyright {
  font-size: 22rpx;
  color: #999999;
}
