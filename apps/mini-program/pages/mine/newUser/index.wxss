.registration-intro {
  padding: 28rpx 4rpx 34rpx;
}

.registration-intro__title {
  font-size: 40rpx;
  font-weight: 700;
  line-height: 56rpx;
  color: var(--cr-color-text);
}

.registration-intro__description {
  margin-top: 8rpx;
  font-size: 26rpx;
  line-height: 40rpx;
  color: var(--cr-color-text-secondary);
}

.registration-avatar {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 30rpx 32rpx;
  text-align: center;
}

.registration-avatar__button {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 176rpx;
  min-width: 176rpx;
  height: 176rpx;
  min-height: 176rpx;
  padding: 0;
  margin: 0;
  line-height: 1;
  background: transparent;
  border: 0;
  border-radius: 50%;
  overflow: visible;
}

.registration-avatar__button::after {
  border: 0;
}

.registration-avatar__image {
  display: block;
  flex: none;
  box-sizing: border-box;
  width: 168rpx;
  height: 168rpx;
  object-fit: cover;
  border: 4rpx solid var(--cr-color-primary-light);
  border-radius: 50%;
  overflow: hidden;
}

.registration-avatar__tip {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--cr-color-text-secondary);
}

.registration-agreement {
  padding: 26rpx 30rpx 32rpx;
}

.registration-agreement__text {
  font-size: 25rpx;
  line-height: 40rpx;
  color: var(--cr-color-text-secondary);
}

.registration-agreement__link {
  color: var(--cr-color-primary);
}

.registration-submit {
  flex: 1;
}
