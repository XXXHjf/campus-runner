.box1 {
  display: flex;
  flex: 1.5;
  align-items: center;
}

.text-address {
  color: #0052d9;
  background-color: #0052d920;
  padding: 10rpx 15rpx;
  margin: 10rpx 15rpx 10rpx 30rpx;
  border-radius: 15rpx;
  font-size: small;
  font-weight: bold;
  /* 将文本居中 */
  text-align: center;
  /* 防止文本换行 */
  white-space: nowrap;
  /* 如果内容过长，隐藏溢出的部分 */
  /* overflow: hidden;  */
  /* 显示省略号来表示被截断的文本 */
  /* text-overflow: ellipsis;  */
}

.address {
  flex: 1;
  margin: 0 30rpx;
  font-size: small;
  font-weight: 500;
  font-family: Verdana, Geneva, Tahoma, sans-serif;
  color: gray;
}

.card {
  margin: 30rpx;
  padding: 20rpx 0;
  border-radius: 20rpx;
  background-color: white;
}

.title {
  padding: 5rpx 5rpx;
  /* font-size: 0.8rem; */
  font-weight: bold;
  color: #0052d9;
}

.box1-1 {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.avatar {
  border-radius: 30px;
  display: block;
  width: 56px;
  height: 56px;
  margin: 0 30rpx;
}

.info {
  margin-left: 20rpx;
}

.tag{
  margin-right: 30rpx;
}
.cardName {
  padding: 0rpx 20rpx;
  font-size: 0.8rem;
  font-weight: bold;
  color: #0052d9;
}

.suffix {
  display: flex;
  align-items: center;
}

.suffix--line {
  width: 1px;
  height: 24px;
  background-color: var(--td-component-stroke, #f3f3f3);
  margin-right: 16px;
}

.verify {
  color: var(--td-brand-color, #0052D9);
  font-size: 32rpx;
}

.button {
  position: fixed;
  bottom: 70rpx;
  left: 0;
  right: 0;
  margin: 40rpx 30rpx;
  width: auto;
}

.change-identify {
  position: fixed;
  bottom: 70rpx;
  left: 0;
  right: 0;
  justify-content: center;
  align-items: center;
  text-align: center;
  font-size: small;
  color: #7a7a7a;
}

.font-link {
  color: #0052D9;
}

/* 认证状态提示 */
.auth-status-banner {
  margin: 10rpx 30rpx 20rpx;
  padding: 22rpx 24rpx;
  background-color: #f0f6ff;
  border-radius: 16rpx;
  border: 1rpx solid rgba(0, 82, 217, 0.12);
}

.auth-status-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.auth-status-title {
  flex: 1;
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.auth-status-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 40rpx;
  color: #666;
}

.auth-status-actions {
  margin-top: 16rpx;
  display: flex;
  justify-content: flex-end;
}

/* 校园认证样式 */
.campus-auth-section {
  margin-top: 20rpx;
}

.upload-container {
  display: flex;
  justify-content: center;
  padding: 20rpx 30rpx 30rpx;
}

.upload-item {
  width: 200rpx;
  height: 200rpx;
  position: relative;
}

.upload-btn {
  width: 100%;
  height: 100%;
  border: 2rpx dashed #0052d9;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background-color: #f5f7fa;
}

.upload-text {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #0052d9;
}

.upload-item.uploaded {
  border-radius: 16rpx;
  overflow: hidden;
}

.uploaded-image {
  width: 100%;
  height: 100%;
  border-radius: 16rpx;
  background-color: #f5f7fa;
  display: block;
}

.delete-btn {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background-color: #e34d59;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
}

.pending-badge {
  position: absolute;
  bottom: 10rpx;
  right: 10rpx;
  width: 50rpx;
  height: 50rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.95);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 12rpx rgba(237, 123, 47, 0.28);
}

.replace-hint {
  margin: 0 30rpx 20rpx;
  font-size: 24rpx;
  color: #666;
  text-align: center;
}
