.card {
  margin: 10rpx 30rpx;
  padding: 20rpx 0;
  border-radius: 20rpx;
  background-color: white;
}

.button {
  margin: 40rpx 30rpx;
  width: auto;
}

.school-input {
  --td-input-placeholder-text-color: black;
}

.cardName {
  padding: 0rpx 20rpx;
  font-size: 0.8rem;
  font-weight: bold;
  color: #0052d9;
}

.tips {
  margin: 10rpx 30rpx;
  font-size: small;
  font-weight: 500;
  font-family: Verdana, Geneva, Tahoma, sans-serif;
  color: gray;
}

/* 认证状态提示 */
.auth-status-banner {
  margin: 10rpx 30rpx 20rpx;
  padding: 22rpx 24rpx;
  background-color: #f0f6ff;
  border-radius: 16rpx;
  border: 1rpx solid rgba(0, 82, 217, 0.12);
}

.auth-status-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.auth-status-title {
  flex: 1;
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.auth-status-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 40rpx;
  color: #666;
}

.auth-status-actions {
  margin-top: 16rpx;
  display: flex;
  justify-content: flex-end;
}

.replace-hint {
  margin: 0 30rpx 20rpx;
  font-size: 24rpx;
  color: #666;
  text-align: center;
}

.font-link {
  color: #0052D9;
}

/* 校园认证样式 */
.campus-auth-section {
  margin-top: 20rpx;
}

.upload-container {
  display: flex;
  justify-content: center;
  padding: 20rpx 30rpx 30rpx;
}

.upload-item {
  width: 200rpx;
  height: 200rpx;
  position: relative;
}

.upload-btn {
  width: 100%;
  height: 100%;
  border: 2rpx dashed #0052d9;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background-color: #f5f7fa;
}

.upload-text {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #0052d9;
}

.upload-item.uploaded {
  border-radius: 16rpx;
  overflow: hidden;
}

.uploaded-image {
  width: 100%;
  height: 100%;
  border-radius: 16rpx;
}

.delete-btn {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background-color: #e34d59;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
}
