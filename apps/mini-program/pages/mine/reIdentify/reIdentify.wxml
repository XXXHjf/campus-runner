<ui-empty-state wx:if="{{feedbackLoadError}}" title="{{feedbackLoadError}}" action-text="重试" bind:action="retryFeedbackLoad" />
<block wx:if="{{!feedbackLoadError}}">
  <auth-notice show="{{showAuthNotice}}" bind:agree="onAgreeNotice" bind:disagree="onDisagreeNotice" />
  <ui-page safe-bottom>
    <view class="campus-auth-page">
      <ui-section plain>
        <view class="campus-auth-page__status">
          <view class="campus-auth-page__heading">
            <text class="campus-auth-page__title">认证材料</text>
            <t-tag size="small" variant="light" theme="{{authStatusTheme}}">{{authStatusText}}</t-tag>
          </view>
          <view wx:if="{{isRejected}}" class="campus-auth-page__muted campus-auth-page__reason-label">未通过原因</view>
          <view wx:if="{{authStatusDesc}}" class="campus-auth-page__description {{isRejected ? 'campus-auth-page__description--reason' : ''}}">{{authStatusDesc}}</view>
        </view>
        <view class="campus-auth-page__form">
          <view class="campus-auth-page__title campus-auth-page__section-title">认证信息</view>
          <t-input label="学校" value="{{onPickValue}}" placeholder="请选择所在学校" bindtap="changeSchoolNew" align="right" borderless disabled suffixIcon="{{!canSubmit ? '' : 'chevron-right'}}" />
          <t-input label="学号" value="{{upSID}}" placeholder="请输入学号" align="right" borderless bind:change="handleStudentId" disabled="{{!canSubmit || submitting}}" />
          <t-input label="真实姓名" value="{{upName}}" placeholder="请输入真实姓名" align="right" borderless bind:change="handleName" disabled="{{!canSubmit || submitting}}" />
        </view>
        <view class="campus-auth-page__materials">
          <view class="campus-auth-page__title">校园认证材料</view>
          <view class="campus-auth-page__media-row">
            <view wx:if="{{studentIdCardUrl || userInfo.studentIdCard}}" class="campus-auth-page__preview">
              <t-image src="{{studentIdCardUrl || userInfo.studentIdCard}}" width="200rpx" height="200rpx" shape="round" mode="aspectFill" bind:tap="previewStudentIdCard" />
              <t-button wx:if="{{studentIdCardUrl}}" class="campus-auth-page__remove" size="small" shape="circle" theme="danger" icon="close" disabled="{{submitting}}" bind:tap="deleteStudentIdCard" aria-label="取消本次选择" />
            </view>
            <t-button wx:if="{{canSubmit}}" size="small" shape="round" theme="primary" variant="outline" icon="{{studentIdCardUrl || userInfo.studentIdCard ? '' : 'add'}}" disabled="{{submitting}}" bind:tap="chooseStudentIdCard">{{studentIdCardUrl || userInfo.studentIdCard ? '重新上传' : '上传材料'}}</t-button>
          </view>
          <view wx:if="{{!studentIdCardUrl && !userInfo.studentIdCard && canSubmit}}" class="campus-auth-page__muted">学生证、录取通知书或校园卡均可</view>
        </view>
      </ui-section>
    </view>
  </ui-page>
  <ui-action-bar fixed>
    <view class="campus-auth-page__actions">

      <t-button wx:if="{{userInfo.studentIdCardReview == 1}}" size="medium" shape="round" theme="primary" variant="outline" disabled="{{submitting}}" bind:tap="refreshStatus">刷新状态</t-button>
      <t-button wx:if="{{canSubmit}}" size="medium" shape="round" theme="primary" loading="{{submitting}}" disabled="{{submitting}}" bind:tap="identify">{{isRejected ? '重新提交' : '确认修改'}}</t-button>
    </view>
  </ui-action-bar>
  <t-picker visible="{{pickerVisible}}" title="请选择学校" cancelBtn="取消" confirmBtn="确认" bindchange="onPickerChange" bindcancel="onPickerCancel"><t-picker-item options="{{schools}}" /></t-picker>
</block>
<ui-feedback id="ui-feedback" />
