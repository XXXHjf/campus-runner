.entrance-help__intro { padding: 18rpx 0 38rpx; text-align: center; }
.entrance-help__icon { display: flex; align-items: center; justify-content: center; width: 104rpx; height: 104rpx; margin: 0 auto 22rpx; border-radius: 50%; background: var(--cr-color-primary-light, #edf3ff); }
.entrance-help__title { color: var(--cr-color-text); font-size: 34rpx; font-weight: 600; }
.entrance-help__content { padding: 8rpx 30rpx; }
.entrance-help__section { padding: 28rpx 0; border-bottom: 1rpx solid var(--cr-color-border); }
.entrance-help__section:last-child { border-bottom: 0; }
.entrance-help__heading { margin-bottom: 18rpx; color: var(--cr-color-text); font-size: 30rpx; font-weight: 600; }
.entrance-help__text { color: var(--cr-color-text-secondary); font-size: 28rpx; line-height: 1.75; }
.entrance-help__example { margin-top: 20rpx; padding: 20rpx 24rpx; border-radius: var(--cr-radius-small); color: var(--cr-color-primary); background: var(--cr-color-primary-light, #edf3ff); font-size: 26rpx; line-height: 1.65; }
