@import "./second-hand-card.wxss";

page { background: var(--cr-color-background, #f6f8f7); }

.secondhand-orders { min-height: 100vh; overflow-x: hidden; }
.secondhand-orders__controls {
  position: fixed;
  top: 0;
  right: 0;
  left: 0;
  z-index: 10;
  background: var(--cr-color-surface, #fff);
}
.secondhand-orders__nav {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-height: 44px;
  padding-left: 24rpx;
}
.secondhand-orders__back {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 62rpx;
  height: 72rpx;
}
.secondhand-orders__search {
  flex: 1;
  min-width: 0;
  --td-search-height: 70rpx;
  --td-search-padding: 0 20rpx;
  --td-search-font-size: 26rpx;
  --td-search-bg-color: var(--cr-color-background, #f6f8f7);
}
.secondhand-orders__tabs {
  box-sizing: border-box;
  display: flex;
  width: 100%;
  height: 84rpx;
  padding: 0 8rpx;
  border-bottom: 1rpx solid var(--cr-color-border, #edf0f2);
}
.secondhand-orders__tab {
  position: relative;
  box-sizing: border-box;
  display: flex;
  flex: 1;
  min-width: 0;
  height: 83rpx;
  align-items: center;
  justify-content: center;
  color: var(--cr-color-text-secondary, #6b778c);
  font-size: 23rpx;
  white-space: nowrap;
}
.secondhand-orders__tab--active { color: var(--cr-color-primary, #0052d9); font-weight: 700; }
.secondhand-orders__tab--active::after {
  position: absolute;
  right: 35%;
  bottom: 0;
  left: 35%;
  height: 5rpx;
  border-radius: 5rpx;
  background: var(--cr-color-primary, #0052d9);
  content: '';
}
.secondhand-orders__list {
  margin: 24rpx var(--cr-page-padding, 24rpx) 48rpx;
  overflow: hidden;
  border-radius: var(--cr-radius-large, 24rpx);
  background: var(--cr-color-surface, #fff);
  box-shadow: var(--cr-shadow-card);
}
.secondhand-orders__item { padding: 28rpx 26rpx 30rpx; }
.secondhand-orders__item--separated { border-top: 1rpx solid var(--cr-color-border, #edf0f2); }
.secondhand-orders__item-top,
.secondhand-orders__item-bottom { display: flex; align-items: center; justify-content: space-between; gap: 14rpx; }
.secondhand-orders__item-top { margin-bottom: 28rpx; }
.secondhand-orders__person { display: flex; flex: 1; align-items: center; gap: 10rpx; min-width: 0; }
.secondhand-orders__avatar,
.secondhand-orders__avatar-fallback { flex: none; width: 48rpx; height: 48rpx; overflow: hidden; border-radius: 50%; }
.secondhand-orders__avatar-fallback { display: flex; align-items: center; justify-content: center; background: var(--cr-color-background, #f6f8f7); }
.secondhand-orders__buyer {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: var(--cr-color-text-secondary, #6b778c);
  font-size: 24rpx;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.secondhand-orders__status {
  flex: none;
  padding: 7rpx 14rpx;
  border-radius: var(--cr-radius-small, 10rpx);
  font-size: 24rpx;
  line-height: 1.3;
}
.secondhand-orders__status--active { color: var(--cr-color-primary, #0052d9); background: var(--cr-color-primary-light, #edf3ff); }
.secondhand-orders__status--pending { color: #dc612c; background: #fff2e9; }
.secondhand-orders__status--done { color: var(--cr-color-success, #19a66a); background: #e6f8ee; }
.secondhand-orders__status--neutral { color: var(--cr-color-text-secondary, #6b778c); background: var(--cr-color-background, #f6f8f7); }
.secondhand-orders__status--warning { color: var(--cr-color-danger, #d54941); background: #fff1f0; }
.secondhand-orders__main { display: flex; align-items: center; gap: 18rpx; min-width: 0; }
.secondhand-orders__cover {
  flex: none;
  width: 124rpx;
  height: 124rpx;
  overflow: hidden;
  border-radius: var(--cr-radius-medium, 20rpx);
  --td-image-round-radius: var(--cr-radius-medium, 20rpx);
}
.secondhand-orders__info { display: flex; flex: 1; flex-direction: column; gap: 12rpx; min-width: 0; }
.secondhand-orders__title {
  overflow: hidden;
  color: var(--cr-color-text, #1d2129);
  font-size: 29rpx;
  font-weight: 700;
  line-height: 1.4;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.secondhand-orders__mode { color: var(--cr-color-text-secondary, #6b778c); font-size: 22rpx; }
.secondhand-orders__amount {
  flex: 0 0 132rpx;
  width: 132rpx;
  color: #e7552d;
  font-size: 30rpx;
  font-weight: 700;
  text-align: right;
  white-space: nowrap;
}
.secondhand-orders__item-bottom { justify-content: flex-end; flex-wrap: wrap; margin-top: 32rpx; }
.secondhand-orders__more { display: flex; align-items: center; justify-content: center; width: 68rpx; height: 56rpx; }
.secondhand-orders__more { margin-right: auto; }
.secondhand-orders__action { flex: none; }
.secondhand-orders__sheet { padding: 24rpx 32rpx calc(16rpx + env(safe-area-inset-bottom)); }
.secondhand-orders__feedback { display: flex; justify-content: center; padding: 90rpx 0; }
